============================================================
Main logic
============================================================
begin_count = 0
begin_curr = 0
new_inserts = 0
change_updates = 0
change_inserts = 0
delete_updates = 0
end_count = 0
end_curr = 0

try:
    # --------------------------------------------------------
    # Fetch Target Baselines
    # --------------------------------------------------------
    target_df = spark.table(TARGET_TBL)
    begin_count = target_df.count()
    begin_curr = target_df.filter(F.col("IsCurrent") == 1).count()

    # --------------------------------------------------------
    # Stage 1: Process Active Clients Lookup
    # --------------------------------------------------------
    episode_df = spark.table(SRC_EPISODE_TBL)
    active_clients_df = episode_df.withColumn(
        "discharge_date_clean", 
        F.coalesce(F.to_date(F.col("date_of_discharge")), F.to_date(F.lit("2199-12-31")))
    ).filter(
        F.col("discharge_date_clean") >= F.date_sub(F.current_date(), 13 * 30) # Approx 13 months
    ).select(F.upper(F.trim(F.col("PATID"))).alias("ACTIVE_PATID")).distinct().cache()

    # --------------------------------------------------------
    # Stage 2: Clean Source Demographics & Coupled Status Flags
    # --------------------------------------------------------
    demo_df = spark.table(SRC_DEMO_TBL)
    
    # Pre-clean natural business key variations to align match grains
    demo_cleaned_df = demo_df.withColumn("JOIN_PATID", F.upper(F.trim(F.col("PATID"))))
    
    demo_enriched_df = demo_cleaned_df.join(
        active_clients_df,
        demo_cleaned_df.JOIN_PATID == active_clients_df.ACTIVE_PATID,
        "left"
    ).withColumn(
        "IsActiveClient",
        F.when(F.col("ACTIVE_PATID").isNotNull(), F.lit(1)).otherwise(F.lit(0))
    ).select(
        F.col("PATID"), "patient_name", "patient_add_zipcode", "client_alias", "employment_status_value",
        "education_code", "marital_status_code", "facility_chart_number", "patient_sex_value",
        "race_value", "client_alias_7", "client_alias_8", "ethnic_origin_X_NRI_value", "medicaid_number",
        "patient_name_first", "patient_name_last", "patient_name_middle", "patient_name_prefix_code",
        "patient_name_prefix_value", "patient_name_suffix_code", "patient_name_suffix_value",
        "primary_language_value", "smoker_value", "IsActiveClient", "JOIN_PATID"
    ).cache()

    # Isolate active subset from reference layout
    current_target_df = target_df.filter(F.col("IsCurrent") == 1).alias("p2")

    # --------------------------------------------------------
    # Stage 3: New Inserts Split Identification
    # --------------------------------------------------------
    new_clients_df = demo_enriched_df.alias("p1").join(
        current_target_df,
        F.upper(F.trim(F.col("p1.PATID"))) == F.upper(F.trim(F.col("p2.PATID"))),
        "left"
    ).filter(F.col("p2.PATID").isNull()).select("p1.*")

    # --------------------------------------------------------
    # Stage 4: Historical Change Records Identification
    # --------------------------------------------------------
    changed_clients_df = demo_enriched_df.alias("p1").join(
        current_target_df,
        F.upper(F.trim(F.col("p1.PATID"))) == F.upper(F.trim(F.col("p2.PATID"))),
        "inner"
    ).filter(
        build_sql_concat_string("p1") != build_sql_concat_string("p2")
    ).select("p2.ClientKey", "p1.*")

    # --------------------------------------------------------
    # Stage 5: Orphan Record Deletions Tracking
    # --------------------------------------------------------
    deleted_clients_df = current_target_df.alias("DIM").join(
        demo_enriched_df.alias("PCD"),
        F.upper(F.trim(F.col("DIM.PATID"))) == F.upper(F.trim(F.col("PCD.PATID"))),
        "left_anti"
    ).select("DIM.ClientKey")

    # Evaluate execution summary counts
    new_inserts    = int(new_clients_df.count())
    change_inserts = int(changed_clients_df.count())
    change_updates = change_inserts
    delete_updates = int(deleted_clients_df.count())

    # --------------------------------------------------------
    # Stage 6: Update Closed Records Profiles (Deactivations)
    # --------------------------------------------------------
    historical_target_df = target_df.filter(F.col("IsCurrent") != 1)

    # Union historical update structures to track targeted mutations safely
    deactivation_keys_df = changed_clients_df.select("ClientKey").unionByName(deleted_clients_df.select("ClientKey"))

    current_unchanged_df = current_target_df.join(
        deactivation_keys_df,
        "ClientKey",
        "left_anti"
    ).select("p2.*")

    expired_mutations_df = current_target_df.join(
        deactivation_keys_df,
        "ClientKey",
        "inner"
    ).withColumn("SCDEndDate", F.current_timestamp())\
     .withColumn("IsCurrent", F.lit(0))\
     .select("p2.*")

    # --------------------------------------------------------
    # Stage 7: Re-align Surrogate Identifiers & Append Phase
    # --------------------------------------------------------
    inserts_to_add_df = new_clients_df.unionByName(changed_clients_df.drop("ClientKey"))\
        .dropDuplicates(["PATID"])

    # Calculate absolute offset max surrogate anchor
    max_key_row = target_df.select(F.coalesce(F.max("ClientKey"), F.lit(0)).alias("max_key")).collect()
    max_key = int(max_key_row[0]["max_key"]) if max_key_row else 0

    key_window = Window.orderBy("JOIN_PATID")
    
    new_current_df = inserts_to_add_df.withColumn(
        "ClientKey", 
        F.row_number().over(key_window) + F.lit(max_key)
    ).withColumn("SCDStartDate", F.current_timestamp())\
     .withColumn("SCDEndDate", F.to_timestamp(F.lit(FUTURE_END_DATE)))\
     .withColumn("IsCurrent", F.lit(1))\
     .select(target_df.columns)

    # Unify physical timeline chunks for full partition overwrite mapping
    final_df = historical_target_df.select(target_df.columns)\
        .unionByName(current_unchanged_df.select(target_df.columns))\
        .unionByName(expired_mutations_df.select(target_df.columns))\
        .unionByName(new_current_df.select(target_df.columns))

    # Commit target transactions to infrastructure layer
    final_df.write.format("delta").mode("overwrite").option("overwriteSchema", "true").saveAsTable(TARGET_TBL)

    # Fetch post-execution statistics
    refreshed_target_df = spark.table(TARGET_TBL)
    end_count = refreshed_target_df.count()
    end_curr  = refreshed_target_df.filter(F.col("IsCurrent") == 1).count()

    # Log successful pipeline execution
    write_log(begin_count, begin_curr, new_inserts, change_updates, change_inserts, delete_updates, end_count, end_curr, "SUCCESS", "")

    print("Dim_Client load completed successfully.")
    print(f"Begin Count    : {begin_count}")
    print(f"Begin Current  : {begin_curr}")
    print(f"New Inserts    : {new_inserts}")
    print(f"Change Updates : {change_updates}")
    print(f"Change Inserts : {change_inserts}")
    print(f"Delete Updates : {delete_updates}")
    print(f"End Count      : {end_count}")
    print(f"End Current    : {end_curr}")

except Exception as e:
    err = traceback.format_exc()
    try:
        write_log(begin_count, begin_curr, new_inserts, change_updates, change_inserts, delete_updates, end_count, end_curr, "FAILED", str(e)[:4000])
    except:
        pass
    print("Dim_Client load failed.")
    print(err)
    raise

finally:
    # Safely flush diagnostic lookup allocations out of memory cache bounds
    try: active_clients_df.unpersist()
    except: pass
    try: demo_enriched_df.unpersist()
    except: pass
