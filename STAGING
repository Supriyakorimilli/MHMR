# ==============================================================
# PREV_RAW SNAPSHOT
# ==============================================================

def write_prev_raw_snapshot(

    table_name,

    previous_df

):


    snapshot_table = (
        snapshot_tbl(
            table_name
        )
    )


    snapshot_df = (

        previous_df


        # ------------------------------------------------------
        # Snapshot run identifier
        # ------------------------------------------------------

        .withColumn(

            "__snapshot_run_id",

            F.lit(
                RUN_ID
            )

        )


        # ------------------------------------------------------
        # Snapshot date
        # ------------------------------------------------------

        .withColumn(

            "__snapshot_date",

            F.current_date()

        )


        # ------------------------------------------------------
        # Snapshot timestamp
        # ------------------------------------------------------

        .withColumn(

            "__snapshot_timestamp",

            F.current_timestamp()

        )

    )


    (
        snapshot_df.write

        .mode(
            "append"
        )

        .option(
            "mergeSchema",
            "true"
        )

        .saveAsTable(
            snapshot_table
        )
    )


# ==============================================================
# CHANGE DETECTION
#
# SAME ROW HASH LOGIC AS ORIGINAL CODE
# ==============================================================

def build_changes(

    current_df,

    previous_df,

    key_cols

):


    # ==========================================================
    # NORMALIZE BOTH DATAFRAMES
    # ==========================================================

    current_df = (
        normalize_columns(
            current_df
        )
    )


    previous_df = (
        normalize_columns(
            previous_df
        )
    )


    # ==========================================================
    # RESOLVE KEY COLUMNS
    # ==========================================================

    key_cols = (
        resolve_key_columns(

            current_df,

            key_cols

        )
    )


    # ==========================================================
    # ALIGN PREVIOUS WITH CURRENT
    # ==========================================================

    previous_df = (

        add_missing_columns(

            previous_df,

            current_df.columns,

            current_df

        )
    )


    # ==========================================================
    # ALIGN CURRENT WITH PREVIOUS
    # ==========================================================

    current_df = (

        add_missing_columns(

            current_df,

            previous_df.columns,

            previous_df

        )
    )


    # ==========================================================
    # SAME COLUMN ORDER
    # ==========================================================

    current_df = (

        current_df.select(
            previous_df.columns
        )

    )


    # ==========================================================
    # ADD CURRENT ROW HASH
    # ==========================================================

    current_hash = (

        add_hash(

            current_df,

            key_cols

        )

        .alias(
            "c"
        )

    )


    # ==========================================================
    # ADD PREVIOUS ROW HASH
    # ==========================================================

    previous_hash = (

        add_hash(

            previous_df,

            key_cols

        )

        .alias(
            "p"
        )

    )


    # ==========================================================
    # KEY JOIN CONDITION
    # ==========================================================

    join_cond = [

        F.col(
            f"c.`{k}`"
        )

        ==

        F.col(
            f"p.`{k}`"
        )

        for k
        in key_cols

    ]


    # ==========================================================
    # INSERTS
    #
    # Key exists in CURRENT RAW
    # but not PREV_RAW
    # ==========================================================

    inserts_df = (

        current_hash

        .join(

            previous_hash,

            join_cond,

            "left_anti"

        )

        .drop(
            "_row_hash"
        )

        .withColumn(

            "STATUS",

            F.lit(
                "I"
            )

        )

        .withColumn(

            "insert_timestamp",

            F.current_timestamp()

        )

    )


    # ==========================================================
    # DELETES
    #
    # Key exists in PREV_RAW
    # but not CURRENT RAW
    # ==========================================================

    deletes_df = (

        previous_hash

        .join(

            current_hash,

            join_cond,

            "left_anti"

        )

        .drop(
            "_row_hash"
        )

        .withColumn(

            "STATUS",

            F.lit(
                "D"
            )

        )

        .withColumn(

            "insert_timestamp",

            F.current_timestamp()

        )

    )


    # ==========================================================
    # UPDATES
    #
    # Same key
    # but ROW HASH changed
    # ==========================================================

    updates_df = (

        current_hash

        .join(

            previous_hash,

            join_cond,

            "inner"

        )

        .where(

            F.col(
                "c._row_hash"
            )

            !=

            F.col(
                "p._row_hash"
            )

        )

        .select([

            F.col(
                f"c.`{c}`"
            ).alias(
                c
            )

            for c
            in current_df.columns

        ])

        .withColumn(

            "STATUS",

            F.lit(
                "U"
            )

        )

        .withColumn(

            "insert_timestamp",

            F.current_timestamp()

        )

    )


    # ==========================================================
    # ALIGN I / U / D DATAFRAMES
    # ==========================================================

    (
        inserts_df,

        updates_df,

        deletes_df

    ) = (

        align_dataframes_for_union([

            inserts_df,

            updates_df,

            deletes_df

        ])

    )


    # ==========================================================
    # COMBINE FINAL CHANGES
    # ==========================================================

    changes_df = (

        inserts_df

        .unionByName(

            updates_df,

            allowMissingColumns=True

        )

        .unionByName(

            deletes_df,

            allowMissingColumns=True

        )

    )


    return changes_df


# ==============================================================
# PROCESS SINGLE TABLE
# ==============================================================

def process_table(

    table_name,

    key_column

):


    # ==========================================================
    # START TIME CST/CDT
    # ==========================================================

    start_time = (
        datetime.now(
            tz
        )
    )


    source_table = (
        src_tbl(
            table_name
        )
    )


    staging_table = (
        stg_tbl(
            table_name
        )
    )


    previous_table = (
        prev_tbl(
            table_name
        )
    )


    key_cols = (
        parse_key_cols(
            key_column
        )
    )


    # ==========================================================
    # VALIDATE KEY
    # ==========================================================

    if len(
        key_cols
    ) == 0:


        end_time = (
            datetime.now(
                tz
            )
        )


        add_staging_log_row(

            table_name=
                clean_table_name(
                    table_name
                ),

            status=
                "FAILED",

            count_value=
                0,

            start_time=
                start_time,

            end_time=
                end_time,

            error_message=
                "KEY_COLUMN is empty"

        )


        raise Exception(

            f"KEY_COLUMN is empty "
            f"for {table_name}"

        )


    # ==========================================================
    # PRINT TABLE INFORMATION
    # ==========================================================

    print(
        "\n"
        "============================================================"
    )


    print(
        f"Processing table : "
        f"{table_name}"
    )


    print(
        f"Source           : "
        f"{source_table}"
    )


    print(
        f"Previous         : "
        f"{previous_table}"
    )


    print(
        f"Staging          : "
        f"{staging_table}"
    )


    print(
        f"Keys             : "
        f"{key_cols}"
    )


    print(
        "Change Detection : ROW HASH"
    )


    print(
        "ThreadPool       : ENABLED"
    )


    print(
        "Retry            : ENABLED"
    )


    print(
        "============================================================"
    )


    # ==========================================================
    # VALIDATE SOURCE
    # ==========================================================

    if not table_exists(
        source_table
    ):


        end_time = (
            datetime.now(
                tz
            )
        )


        add_staging_log_row(

            table_name=
                clean_table_name(
                    table_name
                ),

            status=
                "FAILED",

            count_value=
                0,

            start_time=
                start_time,

            end_time=
                end_time,

            error_message=
                (
                    f"Source table does not exist: "
                    f"{source_table}"
                )

        )


        raise Exception(

            f"Source table does not exist: "
            f"{source_table}"

        )


    # ==========================================================
    # READ CURRENT RAW
    # ==========================================================

    current_df = (

        normalize_columns(

            spark.table(
                source_table
            )

        )
    )


    # ==========================================================
    # CREATE EMPTY PREV_RAW IF IT DOES NOT EXIST
    # ==========================================================

    if not table_exists(
        previous_table
    ):


        print(
            f"PREV_RAW does not exist. "
            f"Creating empty PREV_RAW: "
            f"{previous_table}"
        )


        (
            current_df

            .limit(
                0
            )

            .write

            .mode(
                "overwrite"
            )

            .option(
                "overwriteSchema",
                "true"
            )

            .saveAsTable(
                previous_table
            )
        )


    # ==========================================================
    # READ PREVIOUS RAW
    # ==========================================================

    previous_df = (

        normalize_columns(

            spark.table(
                previous_table
            )

        )
    )


    # ==========================================================
    # BUILD CHANGES USING ROW HASH
    # ==========================================================

    changes_df = (

        build_changes(

            current_df,

            previous_df,

            key_cols

        )

        .cache()

    )


    # ==========================================================
    # GET I/U/D COUNTS
    # ==========================================================

    status_counts_rows = (

        changes_df

        .groupBy(
            "STATUS"
        )

        .agg(

            F.count(
                "*"
            ).alias(
                "cnt"
            )

        )

        .collect()

    )


    status_counts = {

        row[
            "STATUS"
        ]:
            int(
                row[
                    "cnt"
                ]
            )

        for row
        in status_counts_rows

    }


    insert_count = (
        status_counts.get(
            "I",
            0
        )
    )


    update_count = (
        status_counts.get(
            "U",
            0
        )
    )


    delete_count = (
        status_counts.get(
            "D",
            0
        )
    )


    total_change_count = (

        insert_count

        +

        update_count

        +

        delete_count

    )


    # ==========================================================
    # PRINT COUNTS
    # ==========================================================

    print(
        f"Insert count : "
        f"{insert_count}"
    )


    print(
        f"Update count : "
        f"{update_count}"
    )


    print(
        f"Delete count : "
        f"{delete_count}"
    )


    print(
        f"Total changes: "
        f"{total_change_count}"
    )


    # ==========================================================
    # WRITE STAGING
    # ==========================================================

    (
        changes_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            staging_table
        )
    )


    # ==========================================================
    # SNAPSHOT OLD PREV_RAW BEFORE OVERWRITE
    # ==========================================================

    write_prev_raw_snapshot(

        table_name,

        previous_df

    )


    # ==========================================================
    # UPDATE PREV_RAW WITH CURRENT RAW
    # ==========================================================

    (
        current_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            previous_table
        )
    )


    # ==========================================================
    # UNPERSIST CHANGES
    # ==========================================================

    changes_df.unpersist()


    # ==========================================================
    # END TIME CST/CDT
    # ==========================================================

    end_time = (
        datetime.now(
            tz
        )
    )


    # ==========================================================
    # INSERT LOG
    # ==========================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "I",

        insert_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # UPDATE LOG
    # ==========================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "U",

        update_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # DELETE LOG
    # ==========================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "D",

        delete_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # RETURN RESULT
    # ==========================================================

    return {


        "table_name":
            clean_table_name(
                table_name
            ),


        "insert_count":
            insert_count,


        "update_count":
            update_count,


        "delete_count":
            delete_count,


        "total_change_count":
            total_change_count,


        "status":
            "SUCCESS"

    }


# ==============================================================
# RETRY WRAPPER
# ==============================================================

def process_table_with_retry(

    table_name,

    key_column

):


    last_error = None


    # ==========================================================
    # RETRY LOOP
    # ==========================================================

    for attempt in range(

        1,

        MAX_RETRIES + 1

    ):


        try:


            print(
                f"\nAttempt {attempt} "
                f"of {MAX_RETRIES} "
                f"for {table_name}"
            )


            return (

                process_table(

                    table_name,

                    key_column

                )

            )


        except Exception as e:


            last_error = str(
                e
            )


            print(

                f"Attempt {attempt} "
                f"failed for "
                f"{table_name}: "
                f"{last_error}"

            )


            # ==================================================
            # FINAL RETRY FAILED
            # ==================================================

            if attempt == MAX_RETRIES:


                start_time = (
                    datetime.now(
                        tz
                    )
                )


                end_time = (
                    datetime.now(
                        tz
                    )
                )


                add_staging_log_row(


                    table_name=
                        clean_table_name(
                            table_name
                        ),


                    status=
                        "FAILED",


                    count_value=
                        0,


                    start_time=
                        start_time,


                    end_time=
                        end_time,


                    error_message=
                        last_error[
                            :4000
                        ]

                )


                return {


                    "table_name":
                        clean_table_name(
                            table_name
                        ),


                    "insert_count":
                        0,


                    "update_count":
                        0,


                    "delete_count":
                        0,


                    "total_change_count":
                        0,


                    "status":
                        "FAILED",


                    "error":
                        last_error

                }


