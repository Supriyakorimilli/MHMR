from pyspark.sql import SparkSession, functions as F, Window
from pyspark.sql.types import *
import traceback
from datetime import datetime

spark = SparkSession.builder.appName("Build.DW.Dim_Client").getOrCreate()
spark.conf.set("spark.sql.session.timeZone", "America/Chicago")
spark.conf.set("spark.databricks.delta.schema.autoMerge.enabled", "true")
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)

DB = "MHMR_LAKEHOUSE"

SRC_EPISODE_TBL = f"{DB}.RAW.episode_history_RAW"
SRC_DEMO_TBL    = f"{DB}.RAW.patient_current_demographics_RAW"

TARGET_TBL      = f"{DB}.DW.Dim_Client"
FINAL_LOG_TBL   = f"{DB}.LOGS.client_final_log"

TABLE_NAME_FOR_LOG = "Dim_Client"
ETL_TYPE_FOR_LOG   = "SCD MERGE"
FUTURE_END_DATE    = "2199-12-31"


def table_exists(t):
    try:
        spark.table(t)
        return True
    except:
        return False


# ---------------- CREATE TARGET ----------------
if not table_exists(TARGET_TBL):
    schema = StructType([
        StructField("ClientKey", LongType(), False),
        StructField("PATID", StringType(), False),
        StructField("patient_name", StringType()),
        StructField("patient_add_zipcode", StringType()),
        StructField("client_alias", StringType()),
        StructField("employment_status_value", StringType()),
        StructField("education_code", StringType()),
        StructField("marital_status_code", StringType()),
        StructField("facility_chart_number", StringType()),
        StructField("patient_sex_value", StringType()),
        StructField("race_value", StringType()),
        StructField("client_alias_7", StringType()),
        StructField("client_alias_8", StringType()),
        StructField("ethnic_origin_X_NRI_value", StringType()),
        StructField("medicaid_number", StringType()),
        StructField("patient_name_first", StringType()),
        StructField("patient_name_last", StringType()),
        StructField("patient_name_middle", StringType()),
        StructField("patient_name_prefix_code", StringType()),
        StructField("patient_name_prefix_value", StringType()),
        StructField("patient_name_suffix_code", StringType()),
        StructField("patient_name_suffix_value", StringType()),
        StructField("primary_language_value", StringType()),
        StructField("smoker_value", StringType()),
        StructField("IsActiveClient", IntegerType()),
        StructField("SCDStartDate", TimestampType()),
        StructField("SCDEndDate", TimestampType()),
        StructField("IsCurrent", IntegerType())
    ])

    spark.createDataFrame([], schema)\
        .write.format("delta")\
        .mode("overwrite")\
        .saveAsTable(TARGET_TBL)


# ---------------- LOG TABLE ----------------
if not table_exists(FINAL_LOG_TBL):
    log_schema = StructType([
        StructField("Logdate", TimestampType()),
        StructField("TableName", StringType()),
        StructField("BeginRecCount", LongType()),
        StructField("BeginCurrCount", LongType()),
        StructField("NewInserts", LongType()),
        StructField("ChangeUpdates", LongType()),
        StructField("ChangeInserts", LongType()),
        StructField("DeleteUpdates", LongType()),
        StructField("EndRecCount", LongType()),
        StructField("EndCurrCount", LongType()),
        StructField("ETL_TYPE", StringType()),
        StructField("RunStatus", StringType()),
        StructField("ErrorMessage", StringType())
    ])

    spark.createDataFrame([], log_schema)\
        .write.format("delta")\
        .mode("overwrite")\
        .saveAsTable(FINAL_LOG_TBL)


# ---------------- CONCAT LOGIC ----------------
def build_concat(df, alias):
    cols = [
        "patient_name","patient_add_zipcode","client_alias","employment_status_value",
        "education_code","marital_status_code","client_alias_7","client_alias_8",
        "medicaid_number","patient_name_first","patient_name_last","patient_name_middle",
        "patient_name_prefix_code","patient_name_prefix_value","patient_name_suffix_code",
        "patient_name_suffix_value","primary_language_value","smoker_value","IsActiveClient"
    ]

    return F.concat(*[
        F.coalesce(F.trim(F.col(f"{alias}.{c}").cast("string")), F.lit(""))
        for c in cols
    ])


# ---------------- EXECUTION ----------------
begin_count = begin_curr = 0
new_inserts = change_updates = change_inserts = delete_updates = 0
end_count = end_curr = 0

try:
    target_df = spark.table(TARGET_TBL)
    begin_count = target_df.count()
    begin_curr = target_df.filter(F.col("IsCurrent") == 1).count()

    episode_df = spark.table(SRC_EPISODE_TBL)

    active_clients = episode_df.withColumn(
        "clean_discharge_date",
        F.coalesce(F.to_date("date_of_discharge"), F.to_date(F.lit("2199-12-31")))
    ).filter(
        F.col("clean_discharge_date") >= F.date_sub(F.current_date(), 13 * 30)
    ).select(
        F.upper(F.trim("PATID")).alias("PATID")
    ).distinct()

    demo_df = spark.table(SRC_DEMO_TBL)

    demo_clean = demo_df.withColumn(
        "CLEAN_PATID",
        F.upper(F.trim("PATID"))
    )

    demo_enriched = demo_clean.join(
        active_clients,
        demo_clean.CLEAN_PATID == active_clients.PATID,
        "left"
    ).withColumn(
        "IsActiveClient",
        F.when(F.col("PATID").isNotNull(), 1).otherwise(0)
    ).drop("PATID")


    current_tgt = target_df.filter(F.col("IsCurrent") == 1).alias("tgt")
    stg = demo_enriched.alias("stg")


    new_clients = stg.join(
        current_tgt,
        F.col("stg.CLEAN_PATID") == F.col("tgt.PATID"),
        "left_anti"
    ).select("stg.*")


    changed_clients = stg.join(
        current_tgt,
        F.col("stg.CLEAN_PATID") == F.col("tgt.PATID"),
        "inner"
    ).filter(
        build_concat("stg") != build_concat("tgt")
    ).select(
        F.col("tgt.ClientKey").alias("TargetClientKey"),
        "stg.*"
    )


    deleted_clients = current_tgt.join(
        stg,
        F.col("tgt.PATID") == F.col("stg.CLEAN_PATID"),
        "left_anti"
    ).select(
        F.col("tgt.ClientKey").alias("TargetClientKey")
    )


    new_inserts = new_clients.count()
    change_inserts = changed_clients.count()
    change_updates = change_inserts
    delete_updates = deleted_clients.count()


    historical = target_df.filter(F.col("IsCurrent") != 1)

    deactivation_keys = changed_clients.select("TargetClientKey")\
        .unionByName(deleted_clients.select("TargetClientKey"))


    base = target_df.filter(F.col("IsCurrent") == 1).alias("a")


    current_unchanged = base.join(
        deactivation_keys.alias("d"),
        F.col("a.ClientKey") == F.col("d.TargetClientKey"),
        "left_anti"
    ).select("a.*")


    expired = base.join(
        deactivation_keys.alias("d"),
        F.col("a.ClientKey") == F.col("d.TargetClientKey"),
        "inner"
    ).withColumn("IsCurrent", F.lit(0))\
     .withColumn("SCDEndDate", F.current_timestamp())\
     .select("a.*")


    max_key = target_df.agg(F.max("ClientKey")).collect()[0][0] or 0
    w = Window.orderBy("CLEAN_PATID")


    inserts = new_clients.unionByName(
        changed_clients.drop("TargetClientKey")
    ).dropDuplicates(["CLEAN_PATID"])


    new_current = inserts.withColumn(
        "ClientKey",
        F.row_number().over(w) + F.lit(max_key)
    ).withColumn("SCDStartDate", F.current_timestamp())\
     .withColumn("SCDEndDate", F.to_timestamp(F.lit(FUTURE_END_DATE)))\
     .withColumn("IsCurrent", F.lit(1))


    final_df = historical\
        .unionByName(current_unchanged)\
        .unionByName(expired)\
        .unionByName(new_current.select(target_df.columns))


    final_df.write.format("delta")\
        .mode("overwrite")\
        .option("overwriteSchema", "true")\
        .saveAsTable(TARGET_TBL)


    end_df = spark.table(TARGET_TBL)
    end_count = end_df.count()
    end_curr = end_df.filter(F.col("IsCurrent") == 1).count()


    log = [(datetime.now(), TABLE_NAME_FOR_LOG, begin_count, begin_curr,
            new_inserts, change_updates, change_inserts, delete_updates,
            end_count, end_curr, ETL_TYPE_FOR_LOG, "SUCCESS", "")]

    log_cols = ["Logdate","TableName","BeginRecCount","BeginCurrCount",
                "NewInserts","ChangeUpdates","ChangeInserts","DeleteUpdates",
                "EndRecCount","EndCurrCount","ETL_TYPE","RunStatus","ErrorMessage"]

    spark.createDataFrame(log, log_cols)\
        .write.format("delta")\
        .mode("append")\
        .saveAsTable(FINAL_LOG_TBL)

    print("SUCCESS")

except Exception as e:
    err = traceback.format_exc()

    log = [(datetime.now(), TABLE_NAME_FOR_LOG, begin_count, begin_curr,
            new_inserts, change_updates, change_inserts, delete_updates,
            end_count, end_curr, ETL_TYPE_FOR_LOG, "FAILED", str(err)[:4000])]

    spark.createDataFrame(log, log_cols)\
        .write.format("delta")\
        .mode("append")\
        .saveAsTable(FINAL_LOG_TBL)

    raise

finally:
    try: active_clients.unpersist()
    except: pass
    try: demo_enriched.unpersist()
    except: pass
