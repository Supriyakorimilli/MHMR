# DAILY RUN
# ==============================================================

def run_daily_rowhash():


    # ==========================================================
    # ENSURE SCHEMAS
    # ==============================================================

    ensure_schema(
        STAGING_SCHEMA
    )

    ensure_schema(
        PREV_SCHEMA
    )

    ensure_schema(
        SNAPSHOT_SCHEMA
    )

    ensure_schema(
        LOG_SCHEMA
    )


    # ==========================================================
    # ENSURE LOG TABLES
    # ==============================================================

    ensure_staging_log_tables_exist()


    # ==========================================================
    # RESET DAILY LOG
    # ==============================================================

    reset_staging_daily_log()


    # ==========================================================
    # CLEAR MEMORY LOGS
    # ==============================================================

    with LOG_LOCK:

        STAGING_LOG_ROWS.clear()


    # ==========================================================
    # ONE TABLE
    # ==============================================================

    table_name = TEST_TABLE

    key_column = TEST_KEY_COLUMN


    print(
        "\n"
        "============================================================"
    )

    print(
        "ROW HASH DAILY RUN"
    )

    print(
        "============================================================"
    )

    print(
        f"Table       : "
        f"{table_name}"
    )

    print(
        f"Key         : "
        f"{key_column}"
    )

    print(
        f"Workers     : "
        f"{MAX_WORKERS}"
    )

    print(
        f"Retries     : "
        f"{MAX_RETRIES}"
    )

    print(
        "PREV restore: DISABLED"
    )

    print(
        "ROW_HASH    : EXCLUDED FROM NEW HASH"
    )

    print(
        "UTCTimeStamp: INCLUDED"
    )

    print(
        "============================================================"
    )


    results = []


    # ==========================================================
    # THREADPOOL
    # ==============================================================

    with ThreadPoolExecutor(
        max_workers=
            MAX_WORKERS
    ) as executor:


        future_map = {

            executor.submit(
                process_table_with_retry,
                table_name,
                key_column
            ):
                table_name

        }


        for future in as_completed(
            future_map
        ):


            current_table = future_map[
                future
            ]


            try:

                result = future.result()

                results.append(
                    result
                )


                print(
                    f"\nCompleted: "
                    f"{current_table}"
                )

                print(
                    f"Status : "
                    f"{result.get('status')}"
                )

                print(
                    f"I      : "
                    f"{result.get('insert_count')}"
                )

                print(
                    f"U      : "
                    f"{result.get('update_count')}"
                )

                print(
                    f"D      : "
                    f"{result.get('delete_count')}"
                )


            except Exception as e:

                print(
                    traceback.format_exc()
                )


                results.append({

                    "table_name":
                        clean_table_name(
                            current_table
                        ),

                    "status":
                        "FAILED",

                    "insert_count":
                        0,

                    "update_count":
                        0,

                    "delete_count":
                        0,

                    "total_change_count":
                        0,

                    "raw_count":
                        0,

                    "previous_count":
                        0,

                    "new_prev_count":
                        0,

                    "error":
                        str(e)

                })


    # ==========================================================
    # WRITE LOGS
    # ==============================================================

    write_staging_daily_logs()


    # ==========================================================
    # DAILY -> FINAL
    # ==============================================================

    consolidate_staging_logs_to_final()


    # ==========================================================
    # RESULT DATAFRAME
    # ==============================================================

    result_df = spark.createDataFrame(
        results
    )


    # ==========================================================
    # FINAL SUMMARY
    # ==============================================================

    print(
        "\n"
        "================ FINAL DAILY SUMMARY ================"
    )


    (
        result_df

        .select(

            "table_name",

            "status",

            "raw_count",

            "previous_count",

            "insert_count",

            "update_count",

            "delete_count",

            "total_change_count",

            "new_prev_count"

        )

        .show(
            truncate=False
        )

    )


    # ==========================================================
    # STAGING STATUS COUNTS
    # ==============================================================

    staging_table = stg_tbl(
        TEST_TABLE
    )


    if table_exists(
        staging_table
    ):


        print(
            "\n"
            "================ STAGING STATUS COUNTS ================"
        )


        (
            spark.table(
                staging_table
            )

            .groupBy(
                "STATUS"
            )

            .count()

            .orderBy(
                "STATUS"
            )

            .show(
                truncate=False
            )

        )


    # ==========================================================
    # TABLE LOCATIONS
    # ==============================================================

    print(
        "\n"
        "================ TABLE LOCATIONS ================"
    )


    print(
        f"RAW SOURCE     : "
        f"{src_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST PREV_RAW  : "
        f"{prev_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST STAGING   : "
        f"{stg_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST SNAPSHOT  : "
        f"{snapshot_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST DAILY LOG : "
        f"{STAGING_DAILY_LOG_TBL}"
    )


    print(
        f"TEST FINAL LOG : "
        f"{STAGING_FINAL_LOG_TBL}"
    )


    print(
        "================================================="
    )


    return result_df


