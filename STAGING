# ==============================================================
# ALIGN DATAFRAMES FOR UNION
# ==============================================================

def align_dataframes_for_union(
    dfs
):

    all_cols = []

    col_types = {}

    for df in dfs:

        for field in df.schema.fields:

            if field.name not in all_cols:

                all_cols.append(
                    field.name
                )

                col_types[
                    field.name
                ] = field.dataType

    aligned = []

    for df in dfs:

        for c in all_cols:

            if c not in df.columns:

                df = df.withColumn(
                    c,
                    F.lit(
                        None
                    ).cast(
                        col_types[c]
                    )
                )

        df = df.select(
            all_cols
        )

        aligned.append(
            df
        )

    return aligned


# ==============================================================
# ADD UTC LOG COLUMNS IF MISSING
# ==============================================================

def add_missing_utc_log_columns(
    table_name
):

    if not table_exists(
        table_name
    ):

        return

    existing_columns = {

        c.lower()

        for c in spark.table(
            table_name
        ).columns

    }

    columns_to_add = []

    if (
        "insert_timestamp_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "insert_timestamp_utc TIMESTAMP"
        )

    if (
        "start_time_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "start_time_utc TIMESTAMP"
        )

    if (
        "end_time_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "end_time_utc TIMESTAMP"
        )

    if columns_to_add:

        columns_sql = ",\n".join(
            columns_to_add
        )

        spark.sql(
            f"""
            ALTER TABLE {table_name}
            ADD COLUMNS (
                {columns_sql}
            )
            """
        )


