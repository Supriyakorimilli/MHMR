CREATE PROCEDURE [DW].[usp_update_Appointments]
/********************************************************************************************************************************************
PROCEDURE NAME	: DW.usp_update_Appointments
DESCRIPTION		:
SAMPLE CALL		: EXEC DW.usp_update_Appointments;
VERSION			: 2.0
COMMENT			: DATE			USER				COMMENT:
				  3/05/2024	C. Sherrill			Procedure Creation
********************************************************************************************************************************************/

AS

SET NOCOUNT ON;

-- ##########################################################################################################################
-- Drop / Truncate Temp Holding Tables if they exist


IF OBJECT_ID ('tempdb..#APPT') IS NOT NULL
BEGIN
	DROP TABLE #APPT
END;

IF OBJECT_ID ('tempdb..#CHANGED') IS NOT NULL
BEGIN
	DROP TABLE #CHANGED
END;

IF OBJECT_ID ('tempdb..#ORPHANS') IS NOT NULL
BEGIN
	DROP TABLE #ORPHANS
END;

DECLARE  @TableName VARCHAR(40) = 'Appointments'
		,@BeginCount INT = 0
		,@BeginCurr INT = 0
		,@NewInserts INT = 0
		,@ChangeUpdates INT = 0
		,@ChangeInserts INT = 0
		,@DeleteUpdates INT = 0
		,@EndCount INT = 0
		,@EndCurr INT = 0
		,@ETLType VARCHAR(40) = 'PARTIAL MERGE'

SELECT @BeginCount = COUNT(*) FROM DW.Appointments;



CREATE TABLE #APPT
(
	[person_unique_identifier] [varchar](50) NOT NULL,
	[ClientKey] [int] NOT NULL,
	[CO_STAFFID_1] [varchar](10) NULL,
	[CO_STAFFID_2] [varchar](10) NULL,
	[EPISODE_NUMBER] [numeric](18, 0) NULL,
	[JOIN_TO_TX_HISTORY] [varchar](15) NULL,
	[NOT_uniqueid] [varchar](20) NULL,
	[PATID] [varchar](20) NOT NULL,
	[SERVICE_CODE] [varchar](40) NULL,
	[STAFFID] [varchar](40) NULL,
	[StaffKey] [int] NULL,
	[accounting_period] [datetime] NULL,
	[appointment_date] [datetime] NULL,
	[appointment_start_time] [varchar](50) NULL,
	[appointment_end_time] [varchar](50) NULL,
	[status_value] [varchar](40) NULL,
	[billable_value] [varchar](20) NULL,
	[check_in_status_value] [varchar](20) NULL,
	[data_entry_date] [datetime] NULL,
	[data_entry_user_id] [varchar](40) NULL,
	[duration_minutes] [varchar](10) NULL,
	[group_name] [varchar](40) NULL,
	[insurance_category_value] [varchar](40) NULL,
	[location_value] [varchar](40) NULL,
	[missed_visit_service_code] [varchar](40) NULL,
	[missed_visit_service_desc] [varchar](40) NULL,
	[number_of_clients] [varchar](10) NULL,
	[option_desc] [varchar](80) NULL,
	[option_id] [varchar](20) NULL,
	[program_code] [varchar](10) NULL,
	[ProgramKey] [int] NULL,
	[site_name] [varchar](40) NULL
	)

CREATE TABLE #CHANGES
	(person_unique_identifier VARCHAR(50),
	CHANGE_IND  VARCHAR(20)
	)

CREATE TABLE #ORPHANS
	(
	person_unique_identifier VARCHAR(50)
	)
	

INSERT INTO #APPT
SELECT AP.person_unique_identifier
	,DC.ClientKey
	,CO_STAFFID_1
	,CO_STAFFID_2
	,AP.EPISODE_NUMBER
	,AP.JOIN_TO_TX_HISTORY
	,AP.NOT_uniqueid
	,AP.PATID
	,AP.SERVICE_CODE
	,AP.STAFFID
	,DS.StaffKey
	,AP.accounting_period
	,AP.appointment_date
	,AP.appointment_start_time
	,AP.appointment_end_time
	,AP.status_value AS Appointment_Status
	,AP.billable_value
	,AP.check_in_status_value
	,AP.data_entry_date
	,AP.data_entry_user_id
	,AP.duration_minutes
	,AP.group_name
	,AP.insurance_category_value
	,AP.location_value
	,AP.missed_visit_service_code
	,AP.missed_visit_service_desc
	,AP.number_of_clients
	,AP.option_desc
	,AP.option_id
	,AP.program_code
	,DP.ProgramKey
	,AP.site_name
FROM AvatarDWReporting.SYSTEM.appt_data AP
JOIN DW.Dim_Client DC
	ON AP.PATID = DC.PATID
	AND DC.IsCurrent = 1
JOIN DW.Dim_Staff DS
	ON AP.STAFFID = DS.EmployeeID
	AND DS.IsCurrent = 1
LEFT JOIN DW.Dim_Program DP
	ON AP.program_code = DP.ProgramCode
	AND DP.IsCurrent = 1



INSERT INTO #CHANGES
SELECT AP.person_unique_identifier,
	CASE WHEN DWA.person_unique_identifier IS NULL	
			THEN 'NEW'
		WHEN AP.data_entry_date > DWA.data_entry_date
			THEN 'CHANGED'
		ELSE NULL END AS CHANGE_IND
FROM #APPT AP
LEFT JOIN DW.Appointments DWA
	ON AP.person_unique_identifier = DWA.person_unique_identifier


--insert new
INSERT INTO DW.Appointments
SELECT AP.person_unique_identifier
	,AP.ClientKey
	,AP.CO_STAFFID_1
	,AP.CO_STAFFID_2
	,AP.EPISODE_NUMBER
	,AP.JOIN_TO_TX_HISTORY
	,AP.NOT_uniqueid
	,AP.PATID
	,AP.SERVICE_CODE
	,AP.STAFFID
	,AP.StaffKey
	,AP.accounting_period
	,AP.appointment_date
	,AP.appointment_start_time
	,AP.appointment_end_time
	,AP.status_value AS Appointment_Status
	,AP.billable_value
	,AP.check_in_status_value
	,AP.data_entry_date
	,AP.data_entry_user_id
	,AP.duration_minutes
	,AP.group_name
	,AP.insurance_category_value
	,AP.location_value
	,AP.missed_visit_service_code
	,AP.missed_visit_service_desc
	,AP.number_of_clients
	,AP.option_desc
	,AP.option_id
	,AP.program_code
	,AP.ProgramKey
	,AP.site_name
FROM #APPT AP
JOIN #CHANGES CH
	ON AP.person_unique_identifier = CH.person_unique_identifier
	AND CH.CHANGE_IND = 'NEW'

SET @NewInserts = @@ROWCOUNT;


--DELETE CHANGED
DELETE DA
FROM DW.Appointments DA
JOIN #CHANGES CH
	ON DA.person_unique_identifier = CH.person_unique_identifier
	AND CH.CHANGE_IND = 'CHANGED'

SET @ChangeUpdates = @@ROWCOUNT;


--INSERT CHANGED RECORDS
INSERT INTO DW.Appointments
SELECT AP.person_unique_identifier
	,AP.ClientKey
	,AP.CO_STAFFID_1
	,AP.CO_STAFFID_2
	,AP.EPISODE_NUMBER
	,AP.JOIN_TO_TX_HISTORY
	,AP.NOT_uniqueid
	,AP.PATID
	,AP.SERVICE_CODE
	,AP.STAFFID
	,AP.StaffKey
	,AP.accounting_period
	,AP.appointment_date
	,AP.appointment_start_time
	,AP.appointment_end_time
	,AP.status_value AS Appointment_Status
	,AP.billable_value
	,AP.check_in_status_value
	,AP.data_entry_date
	,AP.data_entry_user_id
	,AP.duration_minutes
	,AP.group_name
	,AP.insurance_category_value
	,AP.location_value
	,AP.missed_visit_service_code
	,AP.missed_visit_service_desc
	,AP.number_of_clients
	,AP.option_desc
	,AP.option_id
	,AP.program_code
	,AP.ProgramKey
	,AP.site_name
FROM #APPT AP
JOIN #CHANGES CH
	ON AP.person_unique_identifier = CH.person_unique_identifier
	AND CH.CHANGE_IND = 'CHANGED'

SET @ChangeInserts = @@ROWCOUNT;


INSERT INTO #ORPHANS
SELECT DW.person_unique_identifier
FROM DW.Appointments DW
LEFT JOIN #APPT AP
	ON DW.person_unique_identifier = AP.person_unique_identifier
WHERE AP.person_unique_identifier IS NULL


DELETE DA
FROM DW.Appointments DA
JOIN #ORPHANS ORPH
	ON DA.person_unique_identifier = ORPH.person_unique_identifier

SET @DeleteUpdates = @@ROWCOUNT;



SELECT @EndCount = COUNT(*) FROM DW.Appointments;

INSERT INTO LOGGING.DW_PROCESS_LOG
(Logdate 
,TableName
,BeginRecCount
,BeginCurrCount
,NewInserts
,ChangeUpdates
,ChangeInserts
,DeleteUpdates
,EndRecCount
,EndCurrCount
,ETL_TYPE)
VALUES
	(GETDATE()
	,@TableName
	,@BeginCount
	,@BeginCurr
	,@NewInserts
	,@ChangeUpdates
	,@ChangeInserts
	,@DeleteUpdates
	,@EndCount
	,@EndCurr
	,@ETLType);



IF OBJECT_ID ('tempdb..#APPT') IS NOT NULL
BEGIN
	DROP TABLE #APPT
END;

IF OBJECT_ID ('tempdb..#CHANGED') IS NOT NULL
BEGIN
	DROP TABLE #CHANGED
END;

IF OBJECT_ID ('tempdb..#ORPHANS') IS NOT NULL
BEGIN
	DROP TABLE #ORPHANS
END;
GO


