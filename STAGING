# ==============================================================
# ALIGN CURRENT AND PREVIOUS SCHEMAS
# ==============================================================

def align_current_previous(
    current_df,
    previous_df
):


    all_columns = list(
        current_df.columns
    )


    for column in previous_df.columns:

        if column not in all_columns:

            all_columns.append(
                column
            )


    current_types = {

        field.name:
            field.dataType

        for field
        in current_df.schema.fields

    }


    previous_types = {

        field.name:
            field.dataType

        for field
        in previous_df.schema.fields

    }


    # Add missing columns to CURRENT

    for column in all_columns:

        if column not in current_df.columns:

            data_type = (
                previous_types.get(
                    column,
                    T.StringType()
                )
            )

            current_df = (
                current_df
                .withColumn(
                    column,
                    F.lit(None).cast(
                        data_type
                    )
                )
            )


    # Add missing columns to PREVIOUS

    for column in all_columns:

        if column not in previous_df.columns:

            data_type = (
                current_types.get(
                    column,
                    T.StringType()
                )
            )

            previous_df = (
                previous_df
                .withColumn(
                    column,
                    F.lit(None).cast(
                        data_type
                    )
                )
            )


    current_df = current_df.select(
        all_columns
    )

    previous_df = previous_df.select(
        all_columns
    )


    return (
        current_df,
        previous_df
    )


# ==============================================================
# KEY JOIN CONDITION
# ==============================================================

def build_key_join_condition(
    key_columns
):


    join_condition = None


    for key in key_columns:

        condition = (

            F.col(
                f"c.`{key}`"
            )

            .eqNullSafe(

                F.col(
                    f"p.`{key}`"
                )

            )
        )


        if join_condition is None:

            join_condition = (
                condition
            )

        else:

            join_condition = (
                join_condition
                & condition
            )


    return join_condition


# ==============================================================
# ALIGN DATAFRAMES FOR UNION
# ==============================================================

def align_for_union(
    dataframes
):


    all_columns = []

    column_types = {}


    for df in dataframes:

        for field in df.schema.fields:

            if field.name not in all_columns:

                all_columns.append(
                    field.name
                )

                column_types[
                    field.name
                ] = field.dataType


    aligned = []


    for df in dataframes:

        for column in all_columns:

            if column not in df.columns:

                df = (
                    df.withColumn(
                        column,
                        F.lit(None).cast(
                            column_types[
                                column
                            ]
                        )
                    )
                )


        aligned.append(
            df.select(
                all_columns
            )
        )


    return aligned


# ==============================================================
# CHANGE DETECTION
# LAST_MODIFIED BASED
# ==============================================================

def build_changes(
    current_df,
    previous_df,
    key_column,
    last_modified_column
):


    # ==========================================================
    # NORMALIZE
    # ==========================================================

    current_df = normalize_columns(
        current_df
    )

    previous_df = normalize_columns(
        previous_df
    )


    # ==========================================================
    # RESOLVE KEY COLUMNS
    # ==========================================================

    requested_keys = (
        parse_key_columns(
            key_column
        )
    )


    if len(requested_keys) == 0:

        raise Exception(
            "KEY_COLUMN cannot be empty."
        )


    resolved_keys = []


    for key in requested_keys:

        current_key = (
            resolve_column(
                current_df,
                key
            )
        )

        previous_key = (
            resolve_column(
                previous_df,
                key
            )
        )


        if current_key != previous_key:

            previous_df = (
                previous_df
                .withColumnRenamed(
                    previous_key,
                    current_key
                )
            )


        resolved_keys.append(
            current_key
        )


    # ==========================================================
    # RESOLVE LAST MODIFIED
    # ==========================================================

    current_last_modified = (
        resolve_column(
            current_df,
            last_modified_column
        )
    )


    previous_last_modified = (
        resolve_column(
            previous_df,
            last_modified_column
        )
    )


    if (
        current_last_modified
        != previous_last_modified
    ):

        previous_df = (
            previous_df
            .withColumnRenamed(
                previous_last_modified,
                current_last_modified
            )
        )


    resolved_last_modified = (
        current_last_modified
    )


    print(
        f"Resolved Keys: "
        f"{resolved_keys}"
    )

    print(
        f"Resolved Last Modified: "
        f"{resolved_last_modified}"
    )


    # ==========================================================
    # ALIGN SCHEMAS
    # ==========================================================

    (
        current_df,
        previous_df
    ) = align_current_previous(
        current_df,
        previous_df
    )


    # ==========================================================
    # VALIDATE KEYS
    # ==========================================================

    validate_keys(
        current_df,
        resolved_keys,
        "CURRENT RAW"
    )


    # Empty PREV is valid.
    if previous_df.limit(
        1
    ).count() > 0:

        validate_keys(
            previous_df,
            resolved_keys,
            "PREVIOUS RAW"
        )


    # ==========================================================
    # VALIDATE LAST_MODIFIED CONVERSION
    # ==========================================================

    invalid_current_timestamp = (

        current_df

        .where(
            F.col(
                resolved_last_modified
            ).isNotNull()
        )

        .where(
            F.col(
                resolved_last_modified
            ).cast(
                "timestamp"
            ).isNull()
        )

        .limit(1)

        .count()
    )


    if invalid_current_timestamp > 0:

        raise Exception(
            f"Some values in "
            f"{resolved_last_modified} "
            f"cannot be converted to TIMESTAMP."
        )


    # ==========================================================
    # ALIASES
    # ==========================================================

    current_alias = (
        current_df.alias("c")
    )

    previous_alias = (
        previous_df.alias("p")
    )


    key_join_condition = (
        build_key_join_condition(
            resolved_keys
        )
    )


    # ==========================================================
    # INSERTS
    #
    # CURRENT key does not exist in PREVIOUS
    # ==========================================================

    inserts_df = (

        current_alias

        .join(
            previous_alias,
            key_join_condition,
            "left_anti"
        )

        .select(
            *[
                F.col(
                    f"c.`{column}`"
                ).alias(column)

                for column
                in current_df.columns
            ]
        )

        .withColumn(
            "STATUS",
            F.lit("I")
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )


    # ==========================================================
    # DELETES
    #
    # PREVIOUS key does not exist in CURRENT
    #
    # IMPORTANT:
    # LastModified cannot identify a hard delete,
    # because deleted row no longer exists in CURRENT.
    # Key comparison is required.
    # ==========================================================

    deletes_df = (

        previous_alias

        .join(
            current_alias,
            key_join_condition,
            "left_anti"
        )

        .select(
            *[
                F.col(
                    f"p.`{column}`"
                ).alias(column)

                for column
                in previous_df.columns
            ]
        )

        .withColumn(
            "STATUS",
            F.lit("D")
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )


    # ==========================================================
    # UPDATES
    #
    # Same key exists in both.
    #
    # CURRENT LAST_MODIFIED
    # >
    # PREVIOUS LAST_MODIFIED
    # ==========================================================

    current_lm = (

        F.col(
            f"c.`{resolved_last_modified}`"
        )

        .cast(
            "timestamp"
        )
    )


    previous_lm = (

        F.col(
            f"p.`{resolved_last_modified}`"
        )

        .cast(
            "timestamp"
        )
    )


    update_condition = (

        # Previous timestamp NULL,
        # but current has timestamp

        (
            previous_lm.isNull()
            &
            current_lm.isNotNull()
        )

        |

        # Normal comparison

        (
            previous_lm.isNotNull()
            &
            current_lm.isNotNull()
            &
            (
                current_lm
                >
                previous_lm
            )
        )

    )


    updates_df = (

        current_alias

        .join(
            previous_alias,
            key_join_condition,
            "inner"
        )

        .where(
            update_condition
        )

        .select(
            *[
                F.col(
                    f"c.`{column}`"
                ).alias(column)

                for column
                in current_df.columns
            ]
        )

        .withColumn(
            "STATUS",
            F.lit("U")
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )


    # ==========================================================
    # ALIGN I/U/D
    # ==========================================================

    (
        inserts_df,
        updates_df,
        deletes_df
    ) = align_for_union(
        [
            inserts_df,
            updates_df,
            deletes_df
        ]
    )


    # ==========================================================
    # COMBINE
    # ==========================================================

    changes_df = (

        inserts_df

        .unionByName(
            updates_df,
            allowMissingColumns=True
        )

        .unionByName(
            deletes_df,
            allowMissingColumns=True
        )
    )


    return (
        changes_df,
        current_df,
        previous_df,
        resolved_last_modified
    )


# ==============================================================
# PREV RAW SNAPSHOT
# ==============================================================

def write_prev_snapshot(
    table_name,
    previous_df
):


    snapshot_table = (
        test_snapshot_table_name(
            table_name
        )
    )


    # ----------------------------------------------------------
    # Prevent duplicate snapshot rows if same run retries
    # ----------------------------------------------------------

    if table_exists(
        snapshot_table
    ):

        existing_columns = {

            column.lower()

            for column
            in spark.table(
                snapshot_table
            ).columns

        }


        if (
            "__snapshot_run_id"
            in existing_columns
        ):

            spark.sql(
                f"""
                DELETE FROM {snapshot_table}
                WHERE __snapshot_run_id = '{RUN_ID}'
                """
            )


    snapshot_df = (

        previous_df

        .withColumn(
            "__snapshot_run_id",
            F.lit(
                RUN_ID
            )
        )

        .withColumn(
            "__snapshot_date",
            F.current_date()
        )

        .withColumn(
            "__snapshot_timestamp",
            F.current_timestamp()
        )
    )


    (
        snapshot_df.write
        .mode("append")
        .option(
            "mergeSchema",
            "true"
        )
        .saveAsTable(
            snapshot_table
        )
    )


# ==============================================================
# PROCESS SINGLE TABLE
# ==============================================================

def process_single_table(
    table_name,
    key_column,
    last_modified_column
):


    start_time = datetime.now(
        CST_TZ
    )


    source_table = (
        source_table_name(
            table_name
        )
    )


    previous_table = (
        test_prev_table_name(
            table_name
        )
    )


    staging_table = (
        test_staging_table_name(
            table_name
        )
    )


    snapshot_table = (
        test_snapshot_table_name(
            table_name
        )
    )


    print(
        "\n"
        "============================================================="
    )

    print(
        "SINGLE TABLE LAST MODIFIED STAGING TEST"
    )

    print(
        "============================================================="
    )

    print(
        f"Table          : {table_name}"
    )

    print(
        f"RAW            : {source_table}"
    )

    print(
        f"TEST PREV_RAW  : {previous_table}"
    )

    print(
        f"TEST STAGING   : {staging_table}"
    )

    print(
        f"TEST SNAPSHOT  : {snapshot_table}"
    )

    print(
        f"Key            : {key_column}"
    )

    print(
        f"Last Modified  : {last_modified_column}"
    )

    print(
        "Row Hash       : NOT USED"
    )

    print(
        "ThreadPool     : NOT USED"
    )

    print(
        "============================================================="
    )


    # ==========================================================
    # CHECK SOURCE
    # ==========================================================

    if not table_exists(
        source_table
    ):

        raise Exception(
            f"RAW table does not exist: "
            f"{source_table}"
        )


    # ==========================================================
    # READ CURRENT RAW
    # ==========================================================

    current_df = normalize_columns(
        spark.table(
            source_table
        )
    )


    # ==========================================================
    # CHECK KEY EXISTS
    # ==========================================================

    requested_keys = (
        parse_key_columns(
            key_column
        )
    )


    if len(requested_keys) == 0:

        raise Exception(
            "KEY_COLUMN is empty."
        )


    for key in requested_keys:

        resolve_column(
            current_df,
            key
        )


    # ==========================================================
    # CHECK LAST MODIFIED EXISTS
    # ==========================================================

    resolve_column(
        current_df,
        last_modified_column
    )


    # ==========================================================
    # INITIALIZE TEST PREV
    # ==========================================================

    initialize_test_prev(
        table_name,
        current_df
    )


    # ==========================================================
    # READ TEST PREV
    # ==========================================================

    previous_df = normalize_columns(
        spark.table(
            previous_table
        )
    )


    # ==========================================================
    # BUILD I/U/D
    # ==========================================================

    (
        changes_df,
        aligned_current_df,
        aligned_previous_df,
        resolved_last_modified
    ) = build_changes(

        current_df=current_df,

        previous_df=previous_df,

        key_column=key_column,

        last_modified_column=(
            last_modified_column
        )
    )


    # ==========================================================
    # WRITE STAGING
    # ==============================================================

    (
        changes_df.write
        .mode("overwrite")
        .option(
            "overwriteSchema",
            "true"
        )
        .saveAsTable(
            staging_table
        )
    )


    # ==========================================================
    # READ WRITTEN STAGING FOR COUNTS
    # ==========================================================

    staging_df = spark.table(
        staging_table
    )


    count_rows = (

        staging_df

        .groupBy(
            "STATUS"
        )

        .agg(
            F.count("*").alias(
                "record_count"
            )
        )

        .collect()
    )


    counts = {

        row["STATUS"]:
            int(
                row["record_count"]
            )

        for row
        in count_rows

    }


    insert_count = counts.get(
        "I",
        0
    )

    update_count = counts.get(
        "U",
        0
    )

    delete_count = counts.get(
        "D",
        0
    )


    total_change_count = (

        insert_count
        +
        update_count
        +
        delete_count
    )


    # ==========================================================
    # GET MAX LAST MODIFIED FROM CURRENT RAW
    # ==========================================================

    max_last_modified = (

        aligned_current_df

        .select(
            F.max(
                F.col(
                    resolved_last_modified
                ).cast(
                    "timestamp"
                )
            ).alias(
                "max_last_modified"
            )
        )

        .collect()[0][
            "max_last_modified"
        ]
    )


    # ==========================================================
    # DISPLAY COUNTS
    # ==========================================================

    print(
        "\n"
        "================ CHANGE COUNTS ================="
    )

    print(
        f"INSERT COUNT : {insert_count}"
    )

    print(
        f"UPDATE COUNT : {update_count}"
    )

    print(
        f"DELETE COUNT : {delete_count}"
    )

    print(
        f"TOTAL CHANGE : {total_change_count}"
    )

    print(
        f"MAX LAST MODIFIED : "
        f"{max_last_modified}"
    )

    print(
        "================================================"
    )


    # ==========================================================
    # SNAPSHOT OLD TEST PREV RAW
    #
    # Snapshot BEFORE replacing PREV_RAW.
    # ==========================================================

    write_prev_snapshot(
        table_name,
        aligned_previous_df
    )


    # ==========================================================
    # UPDATE TEST PREV_RAW
    #
    # Current RAW becomes next run's PREV_RAW.
    # Production PREV_RAW remains untouched.
    # ==========================================================

    (
        aligned_current_df.write
        .mode("overwrite")
        .option(
            "overwriteSchema",
            "true"
        )
        .saveAsTable(
            previous_table
        )
    )


    end_time = datetime.now(
        CST_TZ
    )


    # ==========================================================
    # SUCCESS LOGS
    # ==========================================================

    add_log_row(

        table_name=table_name,

        status="I",

        count_value=insert_count,

        start_time=start_time,

        end_time=end_time

    )


    add_log_row(

        table_name=table_name,

        status="U",

        count_value=update_count,

        start_time=start_time,

        end_time=end_time

    )


    add_log_row(

        table_name=table_name,

        status="D",

        count_value=delete_count,

        start_time=start_time,

        end_time=end_time

    )


    return {

        "table_name":
            clean_table_name(
                table_name
            ),

        "last_modified_column":
            resolved_last_modified,

        "max_last_modified":
            max_last_modified,

        "insert_count":
            insert_count,

        "update_count":
            update_count,

        "delete_count":
            delete_count,

        "total_change_count":
            total_change_count,

        "status":
            "SUCCESS"
    }


# ==============================================================
# RETRY MECHANISM
# ==============================================================

def process_with_retry(
    table_name,
    key_column,
    last_modified_column
):


    last_error = None


    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):


        try:

            print(
                "\n"
                "================================================"
            )

            print(
                f"ATTEMPT {attempt} "
                f"OF {MAX_RETRIES}"
            )

            print(
                "================================================"
            )


            result = (
                process_single_table(

                    table_name=table_name,

                    key_column=key_column,

                    last_modified_column=(
                        last_modified_column
                    )

                )
            )


            print(
                f"\nSUCCESS - "
                f"Attempt {attempt}"
            )


            return result


        except Exception as e:

            last_error = str(e)


            print(
                "\n"
                "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            )

            print(
                f"FAILED ATTEMPT: {attempt}"
            )

            print(
                f"ERROR: {last_error}"
            )

            print(
                "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            )


            traceback.print_exc()


            if attempt < MAX_RETRIES:

                print(
                    f"\nRetrying after "
                    f"{SLEEP_BETWEEN_RETRIES} seconds..."
                )


                time.sleep(
                    SLEEP_BETWEEN_RETRIES
                )


    # ==========================================================
    # AFTER ALL RETRIES FAILED
    # ==========================================================

    failure_time = datetime.now(
        CST_TZ
    )


    add_log_row(

        table_name=table_name,

        status="FAILED",

        count_value=0,

        start_time=failure_time,

        end_time=failure_time,

        error_message=(
            f"Failed after "
            f"{MAX_RETRIES} attempts. "
            f"{last_error}"
        )[:4000]

    )


    return {

        "table_name":
            clean_table_name(
                table_name
            ),

        "last_modified_column":
            last_modified_column,

        "max_last_modified":
            None,

        "insert_count":
            0,

        "update_count":
            0,

        "delete_count":
            0,

        "total_change_count":
            0,

        "status":
            "FAILED",

        "error":
            last_error
    }


