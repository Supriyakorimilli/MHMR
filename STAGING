def add_missing_utc_log_columns(table_name):
    """
    Adds the three new UTC columns to an existing log table.

    This is required only when the log table was created using
    the older schema that contained only CST/CDT timestamp columns.
    """

    if not table_exists(table_name):
        return

    existing_columns = {
        c.lower()
        for c in spark.table(table_name).columns
    }

    columns_to_add = []

    if "insert_timestamp_utc" not in existing_columns:
        columns_to_add.append(
            "insert_timestamp_utc TIMESTAMP"
        )

    if "start_time_utc" not in existing_columns:
        columns_to_add.append(
            "start_time_utc TIMESTAMP"
        )

    if "end_time_utc" not in existing_columns:
        columns_to_add.append(
            "end_time_utc TIMESTAMP"
        )

    if columns_to_add:
        columns_sql = ",\n".join(columns_to_add)

        spark.sql(
            f"""
            ALTER TABLE {table_name}
            ADD COLUMNS (
                {columns_sql}
            )
            """
        )

        print(
            f"Added UTC log columns to: {table_name}"
        )


def ensure_staging_log_tables_exist():
    empty_log_df = spark.createDataFrame(
        [],
        staging_log_schema
    )

    # Daily log table
    if not table_exists(STAGING_DAILY_LOG_TBL):
        (
            empty_log_df.write
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(STAGING_DAILY_LOG_TBL)
        )

    else:
        add_missing_utc_log_columns(
            STAGING_DAILY_LOG_TBL
        )

    # Final log table
    if not table_exists(STAGING_FINAL_LOG_TBL):
        (
            empty_log_df.write
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(STAGING_FINAL_LOG_TBL)
        )

    else:
        add_missing_utc_log_columns(
            STAGING_FINAL_LOG_TBL
        )


def reset_staging_daily_log():
    """
    Clears only the daily log table.

    The table is recreated using the complete schema containing
    both the existing CST/CDT columns and the new UTC columns.
    """

    empty_log_df = spark.createDataFrame(
        [],
        staging_log_schema
    )

    (
        empty_log_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(STAGING_DAILY_LOG_TBL)
    )


def add_staging_log_row(
    table_name,
    status,
    count_value,
    start_time,
    end_time,
    error_message=None
):
    """
    Existing timestamp columns:
        insert_timestamp
        start_time
        end_time

    remain in America/Chicago CST/CDT.

    Additional timestamp columns:
        insert_timestamp_utc
        start_time_utc
        end_time_utc

    contain the corresponding UTC/GMT values.
    """

    # Current insertion time in CST/CDT
    insert_time_cst = datetime.now(tz)

    # Ensure start and end times are timezone-aware Chicago values
    if start_time.tzinfo is None:
        start_time_cst = tz.localize(start_time)
    else:
        start_time_cst = start_time.astimezone(tz)

    if end_time.tzinfo is None:
        end_time_cst = tz.localize(end_time)
    else:
        end_time_cst = end_time.astimezone(tz)

    # Convert the same timestamps into UTC
    insert_time_utc = insert_time_cst.astimezone(utc_tz)
    start_time_utc = start_time_cst.astimezone(utc_tz)
    end_time_utc = end_time_cst.astimezone(utc_tz)

    row = {
        # Business/load date remains based on CST/CDT
        "load_date": start_time_cst.date(),

        "table_name": str(table_name),
        "status": str(status),
        "count": (
            int(count_value)
            if count_value is not None
            else 0
        ),
        "error_message": error_message,

        # Existing CST/CDT values
        "insert_timestamp": insert_time_cst.replace(
            tzinfo=None
        ),
        "start_time": start_time_cst.replace(
            tzinfo=None
        ),
        "end_time": end_time_cst.replace(
            tzinfo=None
        ),

        # New UTC/GMT values
        "insert_timestamp_utc": insert_time_utc.replace(
            tzinfo=None
        ),
        "start_time_utc": start_time_utc.replace(
            tzinfo=None
        ),
        "end_time_utc": end_time_utc.replace(
            tzinfo=None
        ),

        "load_type": "staging"
    }

    with LOG_LOCK:
        STAGING_LOG_ROWS.append(row)


def write_staging_daily_logs():
    if len(STAGING_LOG_ROWS) == 0:
        return

    log_df = spark.createDataFrame(
        STAGING_LOG_ROWS,
        staging_log_schema
    )

    (
        log_df.write
        .mode("append")
        .option("mergeSchema", "true")
        .saveAsTable(STAGING_DAILY_LOG_TBL)
    )


def consolidate_staging_logs_to_final():
    daily_df = spark.table(
        STAGING_DAILY_LOG_TBL
    )

    if daily_df.count() > 0:
        (
            daily_df.write
            .mode("append")
            .option("mergeSchema", "true")
            .saveAsTable(STAGING_FINAL_LOG_TBL)
        )

    reset_staging_daily_log()


