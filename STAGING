# ==============================================================
# ADD STAGING LOG ROW
# ==============================================================

def add_staging_log_row(

    table_name,

    status,

    count_value,

    start_time,

    end_time,

    error_message=None

):


    # ==========================================================
    # CURRENT INSERT TIME CST/CDT
    # ==========================================================

    insert_time_cst = (
        datetime.now(
            tz
        )
    )


    # ==========================================================
    # START TIME CST/CDT
    # ==========================================================

    if start_time.tzinfo is None:

        start_time_cst = (
            tz.localize(
                start_time
            )
        )


    else:

        start_time_cst = (
            start_time.astimezone(
                tz
            )
        )


    # ==========================================================
    # END TIME CST/CDT
    # ==========================================================

    if end_time.tzinfo is None:

        end_time_cst = (
            tz.localize(
                end_time
            )
        )


    else:

        end_time_cst = (
            end_time.astimezone(
                tz
            )
        )


    # ==========================================================
    # CONVERT TO UTC
    # ==========================================================

    insert_time_utc = (
        insert_time_cst.astimezone(
            utc_tz
        )
    )


    start_time_utc = (
        start_time_cst.astimezone(
            utc_tz
        )
    )


    end_time_utc = (
        end_time_cst.astimezone(
            utc_tz
        )
    )


    # ==========================================================
    # BUILD LOG ROW
    # ==========================================================

    row = {


        "load_date":
            start_time_cst.date(),


        "table_name":
            str(
                table_name
            ),


        "status":
            str(
                status
            ),


        "count":
            (
                int(
                    count_value
                )

                if count_value
                is not None

                else 0
            ),


        "error_message":
            error_message,


        # ======================================================
        # CST/CDT
        # ======================================================

        "insert_timestamp":

            insert_time_cst.replace(
                tzinfo=None
            ),


        "start_time":

            start_time_cst.replace(
                tzinfo=None
            ),


        "end_time":

            end_time_cst.replace(
                tzinfo=None
            ),


        # ======================================================
        # UTC/GMT
        # ======================================================

        "insert_timestamp_utc":

            insert_time_utc.replace(
                tzinfo=None
            ),


        "start_time_utc":

            start_time_utc.replace(
                tzinfo=None
            ),


        "end_time_utc":

            end_time_utc.replace(
                tzinfo=None
            ),


        "load_type":
            "staging"

    }


    # ==========================================================
    # THREAD SAFE LOG APPEND
    # ==========================================================

    with LOG_LOCK:

        STAGING_LOG_ROWS.append(
            row
        )


