--
-- ##########################################################################################################################
-- PART 1  SERVICES WITH APPOINTMENT

INSERT INTO #PART1
SELECT 
	  SDM.ID AS ServiceFactID
	, SDM.PatientID
	, SDM.DateofService
	, CASE 
		WHEN ISNUMERIC(SUBSTRING(EpisodeNumAndName,1,2)) = 1 
			THEN LEFT(EpisodeNumAndName,2)
		ELSE LEFT(EpisodeNumAndName,1) 
	  END AS EPISODE_NUMBER
	, SDM.Facility
	, SDM.AdmittedProgram
	, SDM.DataEntrySource
	, SDM.DataEntryDate
	, SDM.DataEntryUser
	, SDM.AccountingPeriod
	, SDM.CrisisIndicator
	, SDM.COPSD
	, SDM.RecipientCode
	, SDM.EncounterType
	, SDM.PatientAgeonService
	, SDM.ServiceStatusCode
	, SDM.ServiceStatus
	, SDM.ProviderID
	, SDM.CoverageCode
	, SDM.Co_Practitioner_ID
	, SDM.Co_Practitioner2_ID
	, SDM.Tx_Note_UniqueId
	, SDM.ServiceUnits
	, SDM.ServiceCost
	, SDM.BalanceOfFeeOnService
	, SDM.PrimaryGuarantorID AS GuarantorID
	, SDM.PrimaryGuarantorLiability 
	, SDM.IsBillable 
	, SDM.InsuranceCategoryCode
	, SDM.[Service]
	, SDM.ServiceCode
	, SDM.ServiceLocationCode
	, SDM.ServiceLocation 
	, SDM.ServiceDuration
	, SDM.TreatmentSettingCode
	, SDM.TreatmentSetting
	, SDM.ServiceStartTime 
	, SDM.ServiceEndTime 
	, AP.AppointmentKey
	, SDM.ProgramCode
	, ROW_NUMBER() OVER (PARTITION BY SDM.PatientID, SUBSTRING(SDM.ID,CHARINDEX('||',SDM.ID,4) + 2,20), AP.NOT_uniqueid 
		ORDER BY CAST(AP.appointment_date AS DATETIME) + CAST(AP.appointment_start_time AS DATETIME)) AS RANK_NUM
FROM 
	MHMRReporting.RPT.ServiceDelivery_Master AS SDM WITH (NOLOCK, NOWAIT)
	LEFT JOIN DW.Appointments AS AP WITH (NOLOCK, NOWAIT)
		ON 
			SDM.PatientID = AP.PATID
			AND SUBSTRING(SDM.ID,CHARINDEX('||',SDM.ID,4) + 2,20) = AP.JOIN_TO_TX_HISTORY
			AND SUBSTRING(Tx_Note_UniqueId, CHARINDEX('N',Tx_Note_UniqueId,1),15) = AP.NOT_uniqueid

