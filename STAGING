# ==============================================================
# PREV_RAW SNAPSHOT
# ==============================================================

def write_prev_raw_snapshot(
    table_name,
    previous_df
):

    # Nothing to snapshot on first-ever run
    if previous_df.limit(
        1
    ).count() == 0:

        print(
            "\nPREV_RAW is empty."
        )

        print(
            "Skipping PREV_RAW snapshot."
        )

        return


    snapshot_table = snapshot_tbl(
        table_name
    )

    snapshot_df = (

        previous_df

        .withColumn(
            "__snapshot_run_id",
            F.lit(
                RUN_ID
            )
        )

        .withColumn(
            "__snapshot_date",
            F.current_date()
        )

        .withColumn(
            "__snapshot_timestamp",
            F.current_timestamp()
        )

    )


    (
        snapshot_df.write
        .mode(
            "append"
        )
        .option(
            "mergeSchema",
            "true"
        )
        .saveAsTable(
            snapshot_table
        )
    )


    print(
        f"\nPREV_RAW snapshot created: "
        f"{snapshot_table}"
    )


# ==============================================================
# BUILD CHANGES
# ==============================================================

def build_changes(
    current_df,
    previous_df,
    key_cols
):


    # ==========================================================
    # NORMALIZE
    # ==============================================================

    current_df = normalize_columns(
        current_df
    )

    previous_df = normalize_columns(
        previous_df
    )


    # ==========================================================
    # RESOLVE KEYS
    # ==============================================================

    key_cols = resolve_key_columns(
        current_df,
        key_cols
    )


    # ==========================================================
    # ALIGN PREVIOUS SCHEMA/DATATYPES TO CURRENT RAW
    # ==============================================================

    previous_df = align_previous_to_current(
        current_df,
        previous_df
    )


    # ==========================================================
    # SAME COLUMN ORDER
    # ==============================================================

    previous_df = previous_df.select(
        current_df.columns
    )


    # ==========================================================
    # PRINT HASH CONFIG
    # ==============================================================

    print_hash_configuration(
        current_df,
        key_cols
    )


    # ==========================================================
    # CALCULATE CURRENT HASH
    # ==============================================================

    current_hash = (

        add_hash(
            current_df,
            key_cols
        )

        .alias(
            "c"
        )

    )


    # ==========================================================
    # CALCULATE PREVIOUS HASH
    # ==============================================================

    previous_hash = (

        add_hash(
            previous_df,
            key_cols
        )

        .alias(
            "p"
        )

    )


    # ==========================================================
    # KEY JOIN
    # ==============================================================

    join_cond = [

        F.col(
            f"c.`{k}`"
        ).eqNullSafe(

            F.col(
                f"p.`{k}`"
            )

        )

        for k in key_cols

    ]


    # ==========================================================
    # INSERT
    #
    # CURRENT KEY NOT IN PREVIOUS
    # ==============================================================

    inserts_df = (

        current_hash

        .join(
            previous_hash,
            join_cond,
            "left_anti"
        )

        .drop(
            "_row_hash"
        )

        .withColumn(
            "STATUS",
            F.lit(
                "I"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # DELETE
    #
    # PREVIOUS KEY NOT IN CURRENT
    # ==============================================================

    deletes_df = (

        previous_hash

        .join(
            current_hash,
            join_cond,
            "left_anti"
        )

        .drop(
            "_row_hash"
        )

        .withColumn(
            "STATUS",
            F.lit(
                "D"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # UPDATE
    #
    # SAME KEY + BUSINESS DATA CHANGED
    # ==============================================================

    updates_df = (

        current_hash

        .join(
            previous_hash,
            join_cond,
            "inner"
        )

        .where(

            F.col(
                "c._row_hash"
            )

            !=

            F.col(
                "p._row_hash"
            )

        )

        .select([

            F.col(
                f"c.`{c}`"
            ).alias(
                c
            )

            for c in current_df.columns

        ])

        .withColumn(
            "STATUS",
            F.lit(
                "U"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # ALIGN I/U/D
    # ==============================================================

    (
        inserts_df,
        updates_df,
        deletes_df
    ) = align_dataframes_for_union([

        inserts_df,

        updates_df,

        deletes_df

    ])


    # ==========================================================
    # COMBINE
    # ==============================================================

    return (

        inserts_df

        .unionByName(
            updates_df,
            allowMissingColumns=True
        )

        .unionByName(
            deletes_df,
            allowMissingColumns=True
        )

    )


# ==============================================================
# PROCESS TABLE
# ==============================================================

def process_table(
    table_name,
    key_column
):

    start_time = datetime.now(
        tz
    )

    source_table = src_tbl(
        table_name
    )

    previous_table = prev_tbl(
        table_name
    )

    staging_table = stg_tbl(
        table_name
    )

    key_cols = parse_key_cols(
        key_column
    )


    # ==========================================================
    # VALIDATE KEY
    # ==============================================================

    if len(
        key_cols
    ) == 0:

        raise Exception(
            f"KEY_COLUMN is empty for {table_name}"
        )


    # ==========================================================
    # VALIDATE RAW
    # ==============================================================

    if not table_exists(
        source_table
    ):

        raise Exception(
            f"RAW source does not exist: "
            f"{source_table}"
        )


    print(
        "\n"
        "========================================================"
    )

    print(
        "DAILY ROW HASH PROCESS"
    )

    print(
        "========================================================"
    )

    print(
        f"Table       : {table_name}"
    )

    print(
        f"RAW         : {source_table}"
    )

    print(
        f"PREV_RAW    : {previous_table}"
    )

    print(
        f"STAGING     : {staging_table}"
    )

    print(
        f"SNAPSHOT    : {snapshot_tbl(table_name)}"
    )

    print(
        f"Key         : {key_cols}"
    )

    print(
        "Restore     : DISABLED"
    )

    print(
        "Hash        : CORRECTED SHA-256"
    )

    print(
        "========================================================"
    )


    # ==========================================================
    # CURRENT RAW
    # ==============================================================

    current_df = normalize_columns(

        spark.table(
            source_table
        )

    )


    current_count = current_df.count()


    print(
        f"\nCURRENT RAW COUNT : "
        f"{current_count}"
    )


    # ==========================================================
    # FIRST RUN
    #
    # IF PREV_RAW DOES NOT EXIST:
    # CREATE EMPTY PREV_RAW.
    #
    # Therefore ALL CURRENT RAW becomes INSERT.
    # ==============================================================

    if not table_exists(
        previous_table
    ):

        print(
            "\nPREV_RAW does not exist."
        )

        print(
            "Creating empty PREV_RAW."
        )

        (
            current_df
            .limit(
                0
            )
            .write
            .mode(
                "overwrite"
            )
            .option(
                "overwriteSchema",
                "true"
            )
            .saveAsTable(
                previous_table
            )
        )


    # ==========================================================
    # READ PREVIOUS
    # ==============================================================

    previous_df = normalize_columns(

        spark.table(
            previous_table
        )

    )


    previous_count = previous_df.count()


    print(
        f"PREVIOUS RAW COUNT: "
        f"{previous_count}"
    )


    # ==========================================================
    # BUILD CHANGES
    # ==============================================================

    changes_df = (

        build_changes(
            current_df,
            previous_df,
            key_cols
        )

        .cache()

    )


    # ==========================================================
    # GET I/U/D COUNTS
    # ==============================================================

    status_rows = (

        changes_df

        .groupBy(
            "STATUS"
        )

        .agg(
            F.count(
                "*"
            ).alias(
                "cnt"
            )
        )

        .collect()

    )


    status_counts = {

        row["STATUS"]:
            int(
                row["cnt"]
            )

        for row in status_rows

    }


    insert_count = status_counts.get(
        "I",
        0
    )

    update_count = status_counts.get(
        "U",
        0
    )

    delete_count = status_counts.get(
        "D",
        0
    )


    total_change_count = (

        insert_count
        +
        update_count
        +
        delete_count

    )


    # ==========================================================
    # PRINT COUNTS
    # ==============================================================

    print(
        "\n"
        "================ DAILY CHANGE COUNTS ================"
    )

    print(
        f"INSERT COUNT : "
        f"{insert_count}"
    )

    print(
        f"UPDATE COUNT : "
        f"{update_count}"
    )

    print(
        f"DELETE COUNT : "
        f"{delete_count}"
    )

    print(
        f"TOTAL CHANGE : "
        f"{total_change_count}"
    )

    print(
        "====================================================="
    )


    # ==========================================================
    # WRITE TODAY'S STAGING
    # ==============================================================

    (
        changes_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            staging_table
        )
    )


    print(
        f"\nSTAGING WRITTEN: "
        f"{staging_table}"
    )


    # ==========================================================
    # SNAPSHOT OLD PREV_RAW
    #
    # MUST HAPPEN BEFORE PREV_RAW OVERWRITE
    # ==============================================================

    write_prev_raw_snapshot(
        table_name,
        previous_df
    )


    # ==========================================================
    # TODAY'S RAW BECOMES TOMORROW'S PREV_RAW
    # ==============================================================

    (
        current_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            previous_table
        )
    )


    # ==========================================================
    # VERIFY NEW PREV COUNT
    # ==============================================================

    new_prev_count = (

        spark.table(
            previous_table
        )

        .count()

    )


    print(
        f"\nNEW PREV_RAW COUNT: "
        f"{new_prev_count}"
    )


    # ==========================================================
    # CLEAN CACHE
    # ==============================================================

    changes_df.unpersist()


    # ==========================================================
    # LOGGING
    # ==============================================================

    end_time = datetime.now(
        tz
    )


    add_staging_log_row(
        table_name,
        "I",
        insert_count,
        start_time,
        end_time,
        None
    )


    add_staging_log_row(
        table_name,
        "U",
        update_count,
        start_time,
        end_time,
        None
    )


    add_staging_log_row(
        table_name,
        "D",
        delete_count,
        start_time,
        end_time,
        None
    )


    return {

        "table_name":
            clean_table_name(
                table_name
            ),

        "status":
            "SUCCESS",

        "insert_count":
            insert_count,

        "update_count":
            update_count,

        "delete_count":
            delete_count,

        "total_change_count":
            total_change_count,

        "raw_count":
            current_count,

        "previous_count":
            previous_count,

        "new_prev_count":
            new_prev_count

    }


# ==============================================================
# RETRY WRAPPER
# ==============================================================

def process_table_with_retry(
    table_name,
    key_column
):

    last_error = None


    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):


        try:

            print(
                f"\nAttempt {attempt} "
                f"of {MAX_RETRIES}"
            )

            return process_table(
                table_name,
                key_column
            )


        except Exception as e:

            last_error = str(
                e
            )

            print(
                f"\nAttempt {attempt} FAILED"
            )

            print(
                last_error
            )


            if attempt == MAX_RETRIES:

                start_time = datetime.now(
                    tz
                )

                end_time = datetime.now(
                    tz
                )


                add_staging_log_row(
                    table_name,
                    "FAILED",
                    0,
                    start_time,
                    end_time,
                    last_error[:4000]
                )


                return {

                    "table_name":
                        clean_table_name(
                            table_name
                        ),

                    "status":
                        "FAILED",

                    "insert_count":
                        0,

                    "update_count":
                        0,

                    "delete_count":
                        0,

                    "total_change_count":
                        0,

                    "raw_count":
                        0,

                    "previous_count":
                        0,

                    "new_prev_count":
                        0,

                    "error":
                        last_error

                }


