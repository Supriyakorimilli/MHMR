CREATE PROCEDURE [DW].[usp_update_Dim_Client]
/********************************************************************************************************************************************
PROCEDURE NAME	: DW.usp_update_Dim_Client
DESCRIPTION		:
SAMPLE CALL		: EXEC DW.usp_update_Dim_Client;
VERSION			: 2.0
COMMENT			: DATE			USER				COMMENT:
				  1/9/2024	C. Sherrill			Procedure Creation
				  10/21/2024 C. Sherrill		Added code to help auto-correct in the even all clients get marked as not current
********************************************************************************************************************************************/

AS

SET NOCOUNT ON;

-- ##########################################################################################################################
-- Drop / Truncate Temp Holding Tables if the exist

IF OBJECT_ID ('tempdb..#Active_clients') IS NOT NULL
BEGIN
	DROP TABLE #Active_clients
END;

IF OBJECT_ID ('tempdb..#New_clients') IS NOT NULL
BEGIN
	DROP TABLE #New_clients
END;

IF OBJECT_ID ('tempdb..#Changed_clients') IS NOT NULL
BEGIN
	DROP TABLE #Changed_clients
END;

IF OBJECT_ID ('tempdb..#Deleted_clients') IS NOT NULL
BEGIN
	DROP TABLE #Deleted_clients
END;

DECLARE  @TableName VARCHAR(40) = 'Dim_Client'
		,@BeginCount INT = 0
		,@BeginCurr INT = 0
		,@NewInserts INT = 0
		,@ChangeUpdates INT = 0
		,@ChangeInserts INT = 0
		,@DeleteUpdates INT = 0
		,@EndCount INT = 0
		,@EndCurr INT = 0
		,@ETLType VARCHAR(40) = 'SCD MERGE'

SELECT @BeginCount = COUNT(*) FROM DW.Dim_Client;

SELECT @BeginCurr = COUNT(*) FROM DW.Dim_Client WHERE IsCurrent = 1;

CREATE TABLE #Active_clients
(PATID	VARCHAR(10))

CREATE TABLE #New_Clients
	(
	[PATID] [varchar](20) NOT NULL,
	[patient_name] [varchar](100) NULL,
	[patient_add_zipcode] [varchar](60) NULL,
	[client_alias] [varchar](80) NULL,
	[employment_status_value] [varchar](255) NULL,
	[education_code] [varchar](10) NULL,
	[marital_status_code] [varchar](15) NULL,
	[facility_chart_number] [varchar](40) NULL,
	[patient_sex_value] [varchar](40) NULL,
	[race_value] [varchar](255) NULL,
	[client_alias_7] [varchar](80) NULL,
	[client_alias_8] [varchar](80) NULL,
	[ethnic_origin_X_NRI_value] [varchar](255) NULL,
	[medicaid_number] [varchar](20) NULL,
	[patient_name_first] [varchar](40) NULL,
	[patient_name_last] [varchar](40) NULL,
	[patient_name_middle] [varchar](40) NULL,
	[patient_name_prefix_code] [varchar](40) NULL,
	[patient_name_prefix_value] [varchar](40) NULL,
	[patient_name_suffix_code] [varchar](40) NULL,
	[patient_name_suffix_value] [varchar](40) NULL,
	[primary_language_value] [varchar](50) NULL,
	[smoker_value] [varchar](50) NULL,
	[IsActiveClient] [bit] NULL
	)

CREATE TABLE #Changed_clients
(	[ClientKey] INT NOT NULL,
	[PATID] [varchar](20) NOT NULL,
	[patient_name] [varchar](100) NULL,
	[patient_add_zipcode] [varchar](60) NULL,
	[client_alias] [varchar](80) NULL,
	[employment_status_value] [varchar](255) NULL,
	[education_code] [varchar](10) NULL,
	[marital_status_code] [varchar](15) NULL,
	[facility_chart_number] [varchar](40) NULL,
	[patient_sex_value] [varchar](40) NULL,
	[race_value] [varchar](255) NULL,
	[client_alias_7] [varchar](80) NULL,
	[client_alias_8] [varchar](80) NULL,
	[ethnic_origin_X_NRI_value] [varchar](255) NULL,
	[medicaid_number] [varchar](20) NULL,
	[patient_name_first] [varchar](40) NULL,
	[patient_name_last] [varchar](40) NULL,
	[patient_name_middle] [varchar](40) NULL,
	[patient_name_prefix_code] [varchar](40) NULL,
	[patient_name_prefix_value] [varchar](40) NULL,
	[patient_name_suffix_code] [varchar](40) NULL,
	[patient_name_suffix_value] [varchar](40) NULL,
	[primary_language_value] [varchar](50) NULL,
	[smoker_value] [varchar](50) NULL,
	[IsActiveClient] [bit] NULL
	)

CREATE TABLE #Deleted_clients
	(
	[ClientKey] INT NOT NULL
	)

--Active clients
INSERT INTO #Active_clients
SELECT DISTINCT PATID
--INTO #Active_clients
from AvatarDWReporting.system.episode_history
where isnull(date_of_discharge, '2199-12-31') >= DATEADD(MONTH,-13,GETDATE())
  
INSERT INTO #New_clients
select p1.PATID
      ,p1.patient_name
      ,p1.patient_add_zipcode
      ,p1.client_alias
      ,p1.employment_status_value
      ,p1.education_code
      ,p1.marital_status_code
      ,p1.facility_chart_number
      ,p1.patient_sex_value
      ,p1.race_value
      ,p1.client_alias_7
      ,p1.client_alias_8
      ,p1.ethnic_origin_X_NRI_value
      ,p1.medicaid_number
      ,p1.patient_name_first
      ,p1.patient_name_last
      ,p1.patient_name_middle
      ,p1.patient_name_prefix_code
      ,p1.patient_name_prefix_value
      ,p1.patient_name_suffix_code
      ,p1.patient_name_suffix_value
      ,p1.primary_language_value
      ,p1.smoker_value  
	  ,CASE WHEN ACT.PATID IS NOT NULL THEN 1 ELSE 0 END AS IsActiveClient
--INTO #New_clients
from AvatarDWReporting.system.patient_current_demographics p1
LEFT JOIN #Active_clients ACT
	ON P1.PATID = ACT.PATID
left join dw.Dim_Client p2
on p1.patid = p2.patid
AND P2.IsCurrent = 1
where p2.patid is null
 
INSERT INTO #Changed_clients
select P2.ClientKey 
	  ,p1.PATID
      ,p1.patient_name
      ,p1.patient_add_zipcode
      ,p1.client_alias
      ,p1.employment_status_value
      ,p1.education_code
      ,p1.marital_status_code
      ,p1.facility_chart_number
      ,p1.patient_sex_value
      ,p1.race_value
      ,p1.client_alias_7
      ,p1.client_alias_8
      ,p1.ethnic_origin_X_NRI_value
      ,p1.medicaid_number
      ,p1.patient_name_first
      ,p1.patient_name_last
      ,p1.patient_name_middle
      ,p1.patient_name_prefix_code
      ,p1.patient_name_prefix_value
      ,p1.patient_name_suffix_code
      ,p1.patient_name_suffix_value
      ,p1.primary_language_value
      ,p1.smoker_value 
	  ,CASE WHEN ACT.PATID IS NOT NULL THEN 1 ELSE 0 END AS IsActiveClient
--INTO #Changed_clients
from AvatarDWReporting.system.patient_current_demographics p1
LEFT JOIN #Active_clients ACT
	ON P1.PATID = ACT.PATID
join dw.Dim_Client p2
on p1.patid = p2.patid
and concat(p1.patient_name      
      ,p1.patient_add_zipcode
      ,p1.client_alias
      ,p1.employment_status_value
      ,p1.education_code
      ,p1.marital_status_code
	  ,p1.client_alias_7
      ,p1.client_alias_8
	  ,p1.medicaid_number
      ,p1.patient_name_first
      ,p1.patient_name_last
      ,p1.patient_name_middle
      ,p1.patient_name_prefix_code
      ,p1.patient_name_prefix_value
      ,p1.patient_name_suffix_code
      ,p1.patient_name_suffix_value
      ,p1.primary_language_value
      ,p1.smoker_value
	  ,CASE WHEN ACT.PATID IS NOT NULL THEN 1 ELSE 0 END) <>
	  concat(p2.patient_name
      ,p2.patient_add_zipcode
      ,p2.client_alias
      ,p2.employment_status_value
      ,p2.education_code
      ,p2.marital_status_code
	  ,p2.client_alias_7
      ,p2.client_alias_8
	  ,p2.medicaid_number
      ,p2.patient_name_first
      ,p2.patient_name_last
      ,p2.patient_name_middle
      ,p2.patient_name_prefix_code
      ,p2.patient_name_prefix_value
      ,p2.patient_name_suffix_code
      ,p2.patient_name_suffix_value
      ,p2.primary_language_value
      ,p2.smoker_value 
	  ,p2.IsActiveClient)
WHERE P2.IsCurrent = 1


INSERT INTO #Deleted_clients
select DIM.ClientKey 
--INTO #Deleted_clients
from dw.Dim_Client DIM
LEFT JOIN AvatarDWReporting.system.patient_current_demographics PCD
	ON DIM.PATID = PCD.PATID
where PCD.PATID IS NULL
	AND DIM.IsCurrent = 1


--SET SCD END DATE TO TODAY AND ISCURRENT TO 0 FOR CHANGED RECORDS
UPDATE DC
SET DC.SCDEndDate = GETDATE()
	,DC.IsCurrent = 0
FROM DW.Dim_Client DC
JOIN #Changed_clients CC
	ON DC.ClientKey = CC.ClientKey

SET @ChangeUpdates = @@ROWCOUNT;

--SET END DATE AND ISCURRENT FOR DELETED RECORDS
UPDATE DC
SET DC.SCDEndDate = GETDATE()
	,DC.IsCurrent = 0
FROM DW.Dim_Client DC
JOIN #Deleted_clients DEL
	ON DC.ClientKey = DEL.ClientKey

SET @DeleteUpdates = @@ROWCOUNT;

--Add new clients
INSERT INTO DW.Dim_Client
(
      PATID
      ,patient_name
      ,patient_add_zipcode
      ,client_alias
      ,employment_status_value
      ,education_code
      ,marital_status_code
      ,facility_chart_number
      ,patient_sex_value
      ,race_value
      ,client_alias_7
      ,client_alias_8
      ,ethnic_origin_X_NRI_value
      ,medicaid_number
      ,patient_name_first
      ,patient_name_last
      ,patient_name_middle
      ,patient_name_prefix_code
      ,patient_name_prefix_value
      ,patient_name_suffix_code
      ,patient_name_suffix_value
      ,primary_language_value
      ,smoker_value
      ,IsActiveClient
      ,SCDStartDate
      ,SCDEndDate
	  ,IsCurrent)
SELECT
	  PATID
      ,patient_name
      ,patient_add_zipcode
      ,client_alias
      ,employment_status_value
      ,education_code
      ,marital_status_code
      ,facility_chart_number
      ,patient_sex_value
      ,race_value
      ,client_alias_7
      ,client_alias_8
      ,ethnic_origin_X_NRI_value
      ,medicaid_number
      ,patient_name_first
      ,patient_name_last
      ,patient_name_middle
      ,patient_name_prefix_code
      ,patient_name_prefix_value
      ,patient_name_suffix_code
      ,patient_name_suffix_value
      ,primary_language_value
      ,smoker_value
      ,IsActiveClient
      ,GETDATE() AS SCDStartDate
      ,'2199-12-31' AS SCDEndDate
	  ,1 AS IsCurrent
FROM #New_clients NEW

SET @NewInserts = @@ROWCOUNT;

-- add new changed records
INSERT INTO DW.Dim_Client
(
      PATID
      ,patient_name
      ,patient_add_zipcode
      ,client_alias
      ,employment_status_value
      ,education_code
      ,marital_status_code
      ,facility_chart_number
      ,patient_sex_value
      ,race_value
      ,client_alias_7
      ,client_alias_8
      ,ethnic_origin_X_NRI_value
      ,medicaid_number
      ,patient_name_first
      ,patient_name_last
      ,patient_name_middle
      ,patient_name_prefix_code
      ,patient_name_prefix_value
      ,patient_name_suffix_code
      ,patient_name_suffix_value
      ,primary_language_value
      ,smoker_value
      ,IsActiveClient
      ,SCDStartDate
      ,SCDEndDate
	  ,IsCurrent)
SELECT
	  PATID
      ,patient_name
      ,patient_add_zipcode
      ,client_alias
      ,employment_status_value
      ,education_code
      ,marital_status_code
      ,facility_chart_number
      ,patient_sex_value
      ,race_value
      ,client_alias_7
      ,client_alias_8
      ,ethnic_origin_X_NRI_value
      ,medicaid_number
      ,patient_name_first
      ,patient_name_last
      ,patient_name_middle
      ,patient_name_prefix_code
      ,patient_name_prefix_value
      ,patient_name_suffix_code
      ,patient_name_suffix_value
      ,primary_language_value
      ,smoker_value
      ,IsActiveClient
      ,GETDATE() AS SCDStartDate
      ,'2199-12-31' AS SCDEndDate
	  ,1 AS IsCurrent
FROM #Changed_clients

SET @ChangeInserts = @@ROWCOUNT;

SELECT @EndCount = COUNT(*) FROM DW.Dim_Client;

SELECT @EndCurr = COUNT(*) FROM DW.Dim_Client WHERE IsCurrent = 1;

INSERT INTO LOGGING.DW_PROCESS_LOG
(Logdate 
,TableName
,BeginRecCount
,BeginCurrCount
,NewInserts
,ChangeUpdates
,ChangeInserts
,DeleteUpdates
,EndRecCount
,EndCurrCount
,ETL_TYPE)
VALUES
	(GETDATE()
	,@TableName
	,@BeginCount
	,@BeginCurr
	,@NewInserts
	,@ChangeUpdates
	,@ChangeInserts
	,@DeleteUpdates
	,@EndCount
	,@EndCurr
	,@ETLType)

IF OBJECT_ID ('tempdb..#Active_clients') IS NOT NULL
BEGIN
	DROP TABLE #Active_clients
END;

IF OBJECT_ID ('tempdb..#Active_clients') IS NOT NULL
BEGIN
	DROP TABLE #New_clients
END;

IF OBJECT_ID ('tempdb..#Active_clients') IS NOT NULL
BEGIN
	DROP TABLE #Changed_clients
END;

IF OBJECT_ID ('tempdb..#Active_clients') IS NOT NULL
BEGIN
	DROP TABLE #Deleted_clients
END;
GO


