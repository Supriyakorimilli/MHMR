    )


# ==============================================================
# CHANGE DETECTION
# ROW HASH
# ==============================================================

def build_changes(

    current_df,

    previous_df,

    key_cols

):


    # ==========================================================
    # NORMALIZE
    # ==============================================================

    current_df = normalize_columns(
        current_df
    )

    previous_df = normalize_columns(
        previous_df
    )


    # ==========================================================
    # RESOLVE KEYS
    # ==============================================================

    key_cols = resolve_key_columns(

        current_df,

        key_cols

    )


    # ==========================================================
    # ALIGN PREVIOUS WITH CURRENT
    # ==============================================================

    previous_df = add_missing_columns(

        previous_df,

        current_df.columns,

        current_df

    )


    # ==========================================================
    # ALIGN CURRENT WITH PREVIOUS
    # ==============================================================

    current_df = add_missing_columns(

        current_df,

        previous_df.columns,

        previous_df

    )


    # ==========================================================
    # SAME COLUMN ORDER
    # ==============================================================

    current_df = current_df.select(
        previous_df.columns
    )


    # ==========================================================
    # CURRENT HASH
    # ==============================================================

    current_hash = (

        add_hash(

            current_df,

            key_cols

        )

        .alias(
            "c"
        )

    )


    # ==========================================================
    # PREVIOUS HASH
    # ==============================================================

    previous_hash = (

        add_hash(

            previous_df,

            key_cols

        )

        .alias(
            "p"
        )

    )


    # ==========================================================
    # KEY JOIN CONDITION
    # ==============================================================

    join_cond = [

        F.col(
            f"c.`{k}`"
        )

        ==

        F.col(
            f"p.`{k}`"
        )

        for k
        in key_cols

    ]


    # ==========================================================
    # INSERT
    #
    # CURRENT KEY NOT IN PREVIOUS
    # ==============================================================

    inserts_df = (

        current_hash

        .join(

            previous_hash,

            join_cond,

            "left_anti"

        )

        .drop(
            "_row_hash"
        )

        .withColumn(
            "STATUS",
            F.lit(
                "I"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # DELETE
    #
    # PREVIOUS KEY NOT IN CURRENT
    # ==============================================================

    deletes_df = (

        previous_hash

        .join(

            current_hash,

            join_cond,

            "left_anti"

        )

        .drop(
            "_row_hash"
        )

        .withColumn(
            "STATUS",
            F.lit(
                "D"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # UPDATE
    #
    # SAME KEY + DIFFERENT ROW HASH
    # ==============================================================

    updates_df = (

        current_hash

        .join(

            previous_hash,

            join_cond,

            "inner"

        )

        .where(

            F.col(
                "c._row_hash"
            )

            !=

            F.col(
                "p._row_hash"
            )

        )

        .select([

            F.col(
                f"c.`{c}`"
            ).alias(
                c
            )

            for c
            in current_df.columns

        ])

        .withColumn(
            "STATUS",
            F.lit(
                "U"
            )
        )

        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )

    )


    # ==========================================================
    # ALIGN I / U / D
    # ==============================================================

    (
        inserts_df,
        updates_df,
        deletes_df
    ) = align_dataframes_for_union([

        inserts_df,

        updates_df,

        deletes_df

    ])


    # ==========================================================
    # COMBINE
    # ==============================================================

    changes_df = (

        inserts_df

        .unionByName(

            updates_df,

            allowMissingColumns=True

        )

        .unionByName(

            deletes_df,

            allowMissingColumns=True

        )

    )


    return changes_df


# ==============================================================
# PROCESS SINGLE TABLE
# ==============================================================

def process_table(

    table_name,

    key_column

):


    # ==========================================================
    # START TIME
    # ==============================================================

    start_time = datetime.now(
        tz
    )


    source_table = src_tbl(
        table_name
    )


    staging_table = stg_tbl(
        table_name
    )


    previous_table = prev_tbl(
        table_name
    )


    key_cols = parse_key_cols(
        key_column
    )


    # ==========================================================
    # VALIDATE KEY
    # ==============================================================

    if len(
        key_cols
    ) == 0:


        end_time = datetime.now(
            tz
        )


        add_staging_log_row(

            table_name=
                clean_table_name(
                    table_name
                ),

            status=
                "FAILED",

            count_value=
                0,

            start_time=
                start_time,

            end_time=
                end_time,

            error_message=
                "KEY_COLUMN is empty"

        )


        raise Exception(
            f"KEY_COLUMN is empty "
            f"for {table_name}"
        )


    # ==========================================================
    # PRINT CONFIG
    # ==============================================================

    print(
        "\n"
        "============================================================"
    )

    print(
        f"Processing table : "
        f"{table_name}"
    )

    print(
        f"Source RAW       : "
        f"{source_table}"
    )

    print(
        f"Test PREV_RAW    : "
        f"{previous_table}"
    )

    print(
        f"Test Staging     : "
        f"{staging_table}"
    )

    print(
        f"Test Snapshot    : "
        f"{snapshot_tbl(table_name)}"
    )

    print(
        f"Keys             : "
        f"{key_cols}"
    )

    print(
        "Change Detection : ROW HASH"
    )

    print(
        "ThreadPool       : ENABLED"
    )

    print(
        "Retry            : ENABLED"
    )

    print(
        "Test Suffix      : _rowhash_test"
    )

    print(
        "============================================================"
    )


    # ==========================================================
    # VALIDATE SOURCE RAW
    # ==============================================================

    if not table_exists(
        source_table
    ):


        end_time = datetime.now(
            tz
        )


        add_staging_log_row(

            table_name=
                clean_table_name(
                    table_name
                ),

            status=
                "FAILED",

            count_value=
                0,

            start_time=
                start_time,

            end_time=
                end_time,

            error_message=
                (
                    f"Source table does not exist: "
                    f"{source_table}"
                )

        )


        raise Exception(
            f"Source table does not exist: "
            f"{source_table}"
        )


    # ==========================================================
    # CURRENT RAW
    # ==============================================================

    current_df = normalize_columns(

        spark.table(
            source_table
        )

    )


    # ==========================================================
    # CREATE EMPTY TEST PREV_RAW IF IT DOES NOT EXIST
    #
    # First execution:
    # all RAW rows become INSERT
    # ==============================================================

    if not table_exists(
        previous_table
    ):


        print(
            "\nTEST PREV_RAW does not exist."
        )


        print(
            f"Creating empty TEST PREV_RAW: "
            f"{previous_table}"
        )


        (
            current_df

            .limit(
                0
            )

            .write

            .mode(
                "overwrite"
            )

            .option(
                "overwriteSchema",
                "true"
            )

            .saveAsTable(
                previous_table
            )
        )


    # ==========================================================
    # READ TEST PREVIOUS RAW
    # ==============================================================

    previous_df = normalize_columns(

        spark.table(
            previous_table
        )

    )


    # ==========================================================
    # BUILD CHANGES USING ROW HASH
    # ==============================================================

    changes_df = (

        build_changes(

            current_df,

            previous_df,

            key_cols

        )

        .cache()

    )


    # ==========================================================
    # GET STATUS COUNTS
    # ==============================================================

    status_counts_rows = (

        changes_df

        .groupBy(
            "STATUS"
        )

        .agg(

            F.count(
                "*"
            ).alias(
                "cnt"
            )

        )

        .collect()

    )


    status_counts = {

        row["STATUS"]:
            int(
                row["cnt"]
            )

        for row
        in status_counts_rows

    }


    insert_count = status_counts.get(
        "I",
        0
    )


    update_count = status_counts.get(
        "U",
        0
    )


    delete_count = status_counts.get(
        "D",
        0
    )


    total_change_count = (

        insert_count
        +
        update_count
        +
        delete_count

    )


    # ==========================================================
    # PRINT COUNTS
    # ==============================================================

    print(
        "\n"
        "================ CHANGE COUNTS ================"
    )

    print(
        f"Insert count : "
        f"{insert_count}"
    )

    print(
        f"Update count : "
        f"{update_count}"
    )

    print(
        f"Delete count : "
        f"{delete_count}"
    )

    print(
        f"Total changes: "
        f"{total_change_count}"
    )

    print(
        "================================================"
    )


    # ==========================================================
    # WRITE TEST STAGING TABLE
    # ==============================================================

    (
        changes_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            staging_table
        )
    )


    # ==========================================================
    # SNAPSHOT OLD TEST PREV_RAW
    # ==============================================================

    write_prev_raw_snapshot(

        table_name,

        previous_df

    )


    # ==========================================================
    # CURRENT RAW BECOMES NEW TEST PREV_RAW
    # ==============================================================

    (
        current_df.write

        .mode(
            "overwrite"
        )

        .option(
            "overwriteSchema",
            "true"
        )

        .saveAsTable(
            previous_table
        )
    )


    # ==========================================================
    # UNPERSIST
    # ==============================================================

    changes_df.unpersist()


    # ==========================================================
    # END TIME
    # ==============================================================

    end_time = datetime.now(
        tz
    )


    # ==========================================================
    # INSERT LOG
    # ==============================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "I",

        insert_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # UPDATE LOG
    # ==============================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "U",

        update_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # DELETE LOG
    # ==============================================================

    add_staging_log_row(

        clean_table_name(
            table_name
        ),

        "D",

        delete_count,

        start_time,

        end_time,

        None

    )


    # ==========================================================
    # RESULT
    # ==============================================================

    return {


        "table_name":
            clean_table_name(
                table_name
            ),


        "insert_count":
            insert_count,


        "update_count":
            update_count,


        "delete_count":
            delete_count,


        "total_change_count":
            total_change_count,


        "status":
            "SUCCESS"

    }


# ==============================================================
# RETRY WRAPPER
# ==============================================================

def process_table_with_retry(

    table_name,

    key_column

):


    last_error = None


    for attempt in range(

        1,

        MAX_RETRIES + 1

    ):


        try:


            print(
                f"\nAttempt {attempt} "
                f"of {MAX_RETRIES} "
                f"for {table_name}"
            )


            return process_table(

                table_name,

                key_column

            )


        except Exception as e:


            last_error = str(
                e
            )


            print(

                f"Attempt {attempt} "
                f"failed for "
                f"{table_name}: "
                f"{last_error}"

            )


            # ==================================================
            # FINAL RETRY FAILED
            # ==================================================

            if attempt == MAX_RETRIES:


                start_time = datetime.now(
                    tz
                )


                end_time = datetime.now(
                    tz
                )


                add_staging_log_row(

                    table_name=
                        clean_table_name(
                            table_name
                        ),

                    status=
                        "FAILED",

                    count_value=
                        0,

                    start_time=
                        start_time,

                    end_time=
                        end_time,

                    error_message=
                        last_error[:4000]

                )


                return {


                    "table_name":
                        clean_table_name(
                            table_name
                        ),


                    "insert_count":
                        0,


                    "update_count":
                        0,


                    "delete_count":
                        0,


                    "total_change_count":
                        0,


                    "status":
                        "FAILED",


                    "error":
                        last_error

                }


# ==============================================================
# PROCESS ONE TABLE
#
# THREADPOOL RETAINED
# ==============================================================

def process_one_table():


    # ==========================================================
    # ENSURE SCHEMAS
    # ==============================================================

    ensure_schema(
        STAGING_SCHEMA
    )

    ensure_schema(
        PREV_SCHEMA
    )

    ensure_schema(
        SNAPSHOT_SCHEMA
    )

    ensure_schema(
        LOG_SCHEMA
    )


    # ==========================================================
    # ENSURE TEST LOG TABLES
    # ==============================================================

    ensure_staging_log_tables_exist()


    # ==========================================================
    # RESET ONLY ROWHASH TEST DAILY LOG
    # ==============================================================

    reset_staging_daily_log()


    # ==========================================================
    # CLEAR PYTHON MEMORY LOGS
    # ==============================================================

    with LOG_LOCK:

        STAGING_LOG_ROWS.clear()


    # ==========================================================
    # ONE TABLE
    # ==============================================================

    table_name = TEST_TABLE

    key_column = TEST_KEY_COLUMN


    print(
        "\n"
        "============================================================"
    )

    print(
        "SINGLE TABLE ROW HASH TEST"
    )

    print(
        "============================================================"
    )

    print(
        f"Table      : "
        f"{table_name}"
    )

    print(
        f"Key Column : "
        f"{key_column}"
    )

    print(
        f"Workers    : "
        f"{MAX_WORKERS}"
    )

    print(
        f"Retries    : "
        f"{MAX_RETRIES}"
    )

    print(
        "Row Hash   : ENABLED"
    )

    print(
        "ThreadPool : ENABLED"
    )

    print(
        "Logs       : ENABLED"
    )

    print(
        "Snapshot   : ENABLED"
    )

    print(
        "Suffix     : _rowhash_test"
    )

    print(
        "============================================================"
    )


    results = []


    # ==========================================================
    # THREADPOOL
    #
    # Only one table submitted
    # ==============================================================

    with ThreadPoolExecutor(

        max_workers=
            MAX_WORKERS

    ) as executor:


        future_map = {


            executor.submit(

                process_table_with_retry,

                table_name,

                key_column

            ):
                table_name

        }


        for future in as_completed(
            future_map
        ):


            current_table = future_map[
                future
            ]


            try:


                result = future.result()


                results.append(
                    result
                )


                print(

                    f"\nCompleted: "
                    f"{current_table} | "

                    f"Status: "
                    f"{result.get('status')} | "

                    f"I: "
                    f"{result.get('insert_count')} | "

                    f"U: "
                    f"{result.get('update_count')} | "

                    f"D: "
                    f"{result.get('delete_count')}"

                )


            except Exception as e:


                error_msg = traceback.format_exc()


                print(

                    f"Unexpected failure "
                    f"for {current_table}: "
                    f"{error_msg}"

                )


                results.append({


                    "table_name":
                        clean_table_name(
                            current_table
                        ),


                    "insert_count":
                        0,


                    "update_count":
                        0,


                    "delete_count":
                        0,


                    "total_change_count":
                        0,


                    "status":
                        "FAILED",


                    "error":
                        str(e)

                })


    # ==========================================================
    # WRITE TEST DAILY LOGS
    # ==============================================================

    write_staging_daily_logs()


    # ==========================================================
    # DAILY -> FINAL TEST LOG
    # ==============================================================

    consolidate_staging_logs_to_final()


    # ==========================================================
    # RESULT DATAFRAME
    # ==============================================================

    result_df = spark.createDataFrame(
        results
    )


    # ==========================================================
    # FINAL SUMMARY
    # ==============================================================

    print(
        "\n"
        "================ FINAL SUMMARY ================"
    )


    result_df.groupBy(
        "status"
    ).count().show(
        truncate=False
    )


    # ==========================================================
    # CHANGE COUNTS
    # ==============================================================

    print(
        "\n"
        "================ CHANGE COUNTS ================"
    )


    (
        result_df

        .select(

            "table_name",

            "status",

            "insert_count",

            "update_count",

            "delete_count",

            "total_change_count"

        )

        .show(
            truncate=False
        )
    )


    # ==========================================================
    # STAGING STATUS COUNTS
    # ==============================================================

    staging_table = stg_tbl(
        TEST_TABLE
    )


    if table_exists(
        staging_table
    ):


        print(
            "\n"
            "============= STAGING STATUS COUNTS ==========="
        )


        (
            spark.table(
                staging_table
            )

            .groupBy(
                "STATUS"
            )

            .count()

            .orderBy(
                "STATUS"
            )

            .show(
                truncate=False
            )
        )


    # ==========================================================
    # TEST TABLE LOCATIONS
    # ==============================================================

    print(
        "\n"
        "================ TABLE LOCATIONS =============="
    )


    print(
        f"RAW SOURCE     : "
        f"{src_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST PREV_RAW  : "
        f"{prev_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST STAGING   : "
        f"{stg_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST SNAPSHOT  : "
        f"{snapshot_tbl(TEST_TABLE)}"
    )


    print(
        f"TEST DAILY LOG : "
        f"{STAGING_DAILY_LOG_TBL}"
    )


    print(
        f"TEST FINAL LOG : "
        f"{STAGING_FINAL_LOG_TBL}"
    )


    print(
        "================================================"
    )


    return result_df


