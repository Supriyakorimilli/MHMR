# ==============================================================
# NORMALIZE COLUMN NAME
# ==============================================================

def normalize_column_name(
    column_name
):

    column_name = str(
        column_name
    ).strip()

    column_name = re.sub(
        r"[ ,;{}()\n\t=]",
        "_",
        column_name
    )

    return column_name


# ==============================================================
# NORMALIZE ALL DATAFRAME COLUMNS
# ==============================================================

def normalize_columns(df):

    new_columns = []

    seen = {}

    for old_column in df.columns:

        new_column = (
            normalize_column_name(
                old_column
            )
        )

        if new_column in seen:

            seen[new_column] += 1

            new_column = (
                f"{new_column}_"
                f"{seen[new_column]}"
            )

        else:

            seen[new_column] = 0

        new_columns.append(
            new_column
        )


    for old_column, new_column in zip(
        df.columns,
        new_columns
    ):

        if old_column != new_column:

            df = df.withColumnRenamed(
                old_column,
                new_column
            )

    return df


# ==============================================================
# PARSE KEY COLUMNS
# ==============================================================

def parse_key_columns(
    key_column
):

    if key_column is None:

        return []


    key_column = str(
        key_column
    ).strip()


    if key_column == "":

        return []


    key_column = key_column.replace(
        "|",
        ","
    )


    return [

        normalize_column_name(
            key.strip()
        )

        for key in key_column.split(",")

        if key.strip()
    ]


# ==============================================================
# RESOLVE COLUMN CASE-INSENSITIVELY
# ==============================================================

def resolve_column(
    df,
    requested_column
):

    requested_column = (
        normalize_column_name(
            requested_column
        )
    )


    column_map = {

        column.lower(): column

        for column in df.columns

    }


    if (
        requested_column.lower()
        not in column_map
    ):

        raise Exception(
            f"Column does not exist: "
            f"{requested_column}"
        )


    return column_map[
        requested_column.lower()
    ]


# ==============================================================
# VALIDATE KEY COLUMNS
# ==============================================================

def validate_keys(
    df,
    key_columns,
    dataframe_name
):

    # ----------------------------------------------------------
    # Check NULL keys
    # ----------------------------------------------------------

    null_condition = None

    for key in key_columns:

        condition = (
            F.col(key).isNull()
        )

        if null_condition is None:

            null_condition = condition

        else:

            null_condition = (
                null_condition
                | condition
            )


    if (
        df.where(
            null_condition
        ).limit(1).count()
        > 0
    ):

        raise Exception(
            f"{dataframe_name} contains NULL "
            f"values in key columns: "
            f"{key_columns}"
        )


    # ----------------------------------------------------------
    # Check duplicate keys
    # ----------------------------------------------------------

    duplicate_exists = (

        df
        .groupBy(
            *key_columns
        )
        .count()
        .where(
            F.col("count") > 1
        )
        .limit(1)
        .count()

    )


    if duplicate_exists > 0:

        raise Exception(
            f"{dataframe_name} contains "
            f"duplicate keys for: "
            f"{key_columns}"
        )


