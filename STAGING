# ==============================================================
# TABLE NAME HELPERS
# ==============================================================

def clean_table_name(table: str) -> str:
    table = str(table).strip()
    if table.upper().endswith("_RAW"):
        table = table[:-4]
    return table


def src_tbl(table: str) -> str:
    table = str(table).strip()
    if table.upper().endswith("_RAW"):
        return f"{SOURCE_SCHEMA}.{table}"
    return f"{SOURCE_SCHEMA}.{table}_RAW"


def stg_tbl(table: str) -> str:
    table = clean_table_name(table)
    return f"{STAGING_SCHEMA}.stg_{table}"


def prev_tbl(table: str) -> str:
    table = str(table).strip()
    if table.upper().endswith("_RAW"):
        return f"{PREV_SCHEMA}.{table}"
    return f"{PREV_SCHEMA}.{table}_RAW"


def snapshot_tbl(table: str) -> str:
    table = str(table).strip()
    if table.upper().endswith("_RAW"):
        return f"{SNAPSHOT_SCHEMA}.{table}"
    return f"{SNAPSHOT_SCHEMA}.{table}_RAW"


# ==============================================================
# COMMON HELPERS
# ==============================================================

def table_exists(table_name: str) -> bool:
    try:
        return spark.catalog.tableExists(table_name)
    except Exception:
        try:
            spark.table(table_name).limit(1).count()
            return True
        except Exception:
            return False


def ensure_schema(schema_name: str):
    spark.sql(f"CREATE SCHEMA IF NOT EXISTS {schema_name}")


def normalize_columns(df):
    new_cols = []
    seen = {}

    for c in df.columns:
        new_c = c.strip()
        new_c = re.sub(r"[ ,;{}()\n\t=]", "_", new_c)

        if new_c in seen:
            seen[new_c] += 1
            new_c = f"{new_c}_{seen[new_c]}"
        else:
            seen[new_c] = 0

        new_cols.append(new_c)

    for old_c, new_c in zip(df.columns, new_cols):
        if old_c != new_c:
            df = df.withColumnRenamed(old_c, new_c)

    return df


def parse_key_cols(key_column):
    if key_column is None:
        return []

    key_column = str(key_column).strip()

    if key_column == "":
        return []

    key_column = key_column.replace("|", ",")
    return [k.strip() for k in key_column.split(",") if k.strip()]


def resolve_key_columns(df, key_cols):
    col_map = {c.lower(): c for c in df.columns}
    resolved = []

    for k in key_cols:
        if k.lower() not in col_map:
            raise Exception(f"Key column missing in RAW table: {k}")
        resolved.append(col_map[k.lower()])

    return resolved


def add_missing_columns(df, required_cols, reference_df):
    existing_lower = {c.lower(): c for c in df.columns}

    for c in required_cols:
        if c.lower() not in existing_lower:
            ref_type = reference_df.schema[c].dataType if c in reference_df.columns else T.StringType()
            df = df.withColumn(c, F.lit(None).cast(ref_type))

    return df


def align_dataframes_for_union(dfs):
    all_cols = []
    col_types = {}

    for df in dfs:
        for field in df.schema.fields:
            if field.name not in all_cols:
                all_cols.append(field.name)
                col_types[field.name] = field.dataType

    aligned = []

    for df in dfs:
        for c in all_cols:
            if c not in df.columns:
                df = df.withColumn(c, F.lit(None).cast(col_types[c]))
        df = df.select(all_cols)
        aligned.append(df)

    return aligned


def get_hash_columns(df, key_cols):
    exclude_cols = set([k.lower() for k in key_cols])
    exclude_cols.update(["status", "insert_timestamp", "_row_hash"])

    return [c for c in df.columns if c.lower() not in exclude_cols]


def add_hash(df, key_cols):
    hash_cols = get_hash_columns(df, key_cols)

    if len(hash_cols) == 0:
        return df.withColumn("_row_hash", F.lit(""))

    return df.withColumn(
        "_row_hash",
        F.sha2(
            F.concat_ws(
                "||",
                *[
                    F.coalesce(F.col(c).cast("string"), F.lit(""))
                    for c in hash_cols
                ]
            ),
            256
        )
    )


# ==============================================================
# LOG HELPERS
# ==============================================================

def ensure_staging_log_tables_exist():
    empty_log_df = spark.createDataFrame([], staging_log_schema)

    if not table_exists(STAGING_DAILY_LOG_TBL):
        empty_log_df.write.mode("overwrite").saveAsTable(STAGING_DAILY_LOG_TBL)

    if not table_exists(STAGING_FINAL_LOG_TBL):
        empty_log_df.write.mode("overwrite").saveAsTable(STAGING_FINAL_LOG_TBL)


def reset_staging_daily_log():
    empty_log_df = spark.createDataFrame([], staging_log_schema)
    empty_log_df.write.mode("overwrite").option("overwriteSchema", "true").saveAsTable(STAGING_DAILY_LOG_TBL)


def add_staging_log_row(
    table_name,
    status,
    count_value,
    start_time,
    end_time,
    error_message=None
):
    row = {
        "load_date": start_time.date(),
        "table_name": str(table_name),
        "status": str(status),
        "count": int(count_value) if count_value is not None else 0,
        "error_message": error_message,
        "insert_timestamp": datetime.now(tz).replace(tzinfo=None),
        "start_time": start_time.replace(tzinfo=None),
        "end_time": end_time.replace(tzinfo=None),
        "load_type": "staging"
    }

    with LOG_LOCK:
        STAGING_LOG_ROWS.append(row)


def write_staging_daily_logs():
    if len(STAGING_LOG_ROWS) == 0:
        return

    log_df = spark.createDataFrame(STAGING_LOG_ROWS, staging_log_schema)
    log_df.write.mode("append").saveAsTable(STAGING_DAILY_LOG_TBL)


def consolidate_staging_logs_to_final():
    daily_df = spark.table(STAGING_DAILY_LOG_TBL)

    if daily_df.count() > 0:
        daily_df.write.mode("append").saveAsTable(STAGING_FINAL_LOG_TBL)

    reset_staging_daily_log()


# ==============================================================
# SNAPSHOT HELPER
# ==============================================================

def write_prev_raw_snapshot(table_name, previous_df):
    snapshot_table = snapshot_tbl(table_name)

    snapshot_df = (
        previous_df
        .withColumn("__snapshot_run_id", F.lit(RUN_ID))
        .withColumn("__snapshot_date", F.current_date())
        .withColumn("__snapshot_timestamp", F.current_timestamp())
    )

    (
        snapshot_df.write
        .mode("append")
        .option("mergeSchema", "true")
        .saveAsTable(snapshot_table)
    )


# ==============================================================
# CHANGE DETECTION
# ==============================================================

def build_changes(current_df, previous_df, key_cols):
    current_df = normalize_columns(current_df)
    previous_df = normalize_columns(previous_df)

    key_cols = resolve_key_columns(current_df, key_cols)

    previous_df = add_missing_columns(previous_df, current_df.columns, current_df)
    current_df = add_missing_columns(current_df, previous_df.columns, previous_df)

    current_df = current_df.select(previous_df.columns)

    current_hash = add_hash(current_df, key_cols).alias("c")
    previous_hash = add_hash(previous_df, key_cols).alias("p")

    join_cond = [
        F.col(f"c.`{k}`") == F.col(f"p.`{k}`")
        for k in key_cols
    ]

    inserts_df = (
        current_hash
        .join(previous_hash, join_cond, "left_anti")
        .drop("_row_hash")
        .withColumn("STATUS", F.lit("I"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    deletes_df = (
        previous_hash
        .join(current_hash, join_cond, "left_anti")
        .drop("_row_hash")
        .withColumn("STATUS", F.lit("D"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    updates_df = (
        current_hash
        .join(previous_hash, join_cond, "inner")
        .where(F.col("c._row_hash") != F.col("p._row_hash"))
        .select([F.col(f"c.`{c}`").alias(c) for c in current_df.columns])
        .withColumn("STATUS", F.lit("U"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    inserts_df, updates_df, deletes_df = align_dataframes_for_union([
        inserts_df,
        updates_df,
        deletes_df
    ])

    changes_df = (
        inserts_df
        .unionByName(updates_df, allowMissingColumns=True)
        .unionByName(deletes_df, allowMissingColumns=True)
    )

    return changes_df


# ==============================================================
# PROCESS SINGLE TABLE
# ==============================================================

def process_table(table_name, key_column):
    start_time = datetime.now(tz)

    source_table = src_tbl(table_name)
    staging_table = stg_tbl(table_name)
    previous_table = prev_tbl(table_name)

    key_cols = parse_key_cols(key_column)

    if len(key_cols) == 0:
        end_time = datetime.now(tz)
        add_staging_log_row(
            table_name=clean_table_name(table_name),
            status="FAILED",
            count_value=0,
            start_time=start_time,
            end_time=end_time,
            error_message="KEY_COLUMN is empty"
        )
        raise Exception(f"KEY_COLUMN is empty for {table_name}")

    print(f"\n============================================================")
    print(f"Processing table: {table_name}")
    print(f"Source   : {source_table}")
    print(f"Previous : {previous_table}")
    print(f"Staging  : {staging_table}")
    print(f"Keys     : {key_cols}")
    print(f"============================================================")

    if not table_exists(source_table):
        end_time = datetime.now(tz)
        add_staging_log_row(
            table_name=clean_table_name(table_name),
            status="FAILED",
            count_value=0,
            start_time=start_time,
            end_time=end_time,
            error_message=f"Source table does not exist: {source_table}"
        )
        raise Exception(f"Source table does not exist: {source_table}")

    current_df = normalize_columns(spark.table(source_table))

    if not table_exists(previous_table):
        (
            current_df.limit(0)
            .write
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(previous_table)
        )

    previous_df = normalize_columns(spark.table(previous_table))

    changes_df = build_changes(current_df, previous_df, key_cols).cache()

    status_counts_rows = (
        changes_df
        .groupBy("STATUS")
        .agg(F.count("*").alias("cnt"))
        .collect()
    )

    status_counts = {
        row["STATUS"]: int(row["cnt"])
        for row in status_counts_rows
    }

    insert_count = status_counts.get("I", 0)
    update_count = status_counts.get("U", 0)
    delete_count = status_counts.get("D", 0)

    total_change_count = insert_count + update_count + delete_count

    print(f"Insert count : {insert_count}")
    print(f"Update count : {update_count}")
    print(f"Delete count : {delete_count}")
    print(f"Total changes: {total_change_count}")

    (
        changes_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(staging_table)
    )

    # Snapshot old PREV_RAW before overwriting it
    write_prev_raw_snapshot(table_name, previous_df)

    # Update PREV_RAW with current RAW after staging is created
    (
        current_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(previous_table)
    )

    changes_df.unpersist()

    end_time = datetime.now(tz)

    add_staging_log_row(clean_table_name(table_name), "I", insert_count, start_time, end_time, None)
    add_staging_log_row(clean_table_name(table_name), "U", update_count, start_time, end_time, None)
    add_staging_log_row(clean_table_name(table_name), "D", delete_count, start_time, end_time, None)

    return {
        "table_name": clean_table_name(table_name),
        "insert_count": insert_count,
        "update_count": update_count,
        "delete_count": delete_count,
        "total_change_count": total_change_count,
        "status": "SUCCESS"
    }


# ==============================================================
# RETRY WRAPPER
# ==============================================================

def process_table_with_retry(table_name, key_column):
    last_error = None

    for attempt in range(1, MAX_RETRIES + 1):
        try:
            return process_table(table_name, key_column)

        except Exception as e:
            last_error = str(e)
            print(f"Attempt {attempt} failed for {table_name}: {last_error}")

            if attempt == MAX_RETRIES:
                start_time = datetime.now(tz)
                end_time = datetime.now(tz)

                add_staging_log_row(
                    table_name=clean_table_name(table_name),
                    status="FAILED",
                    count_value=0,
                    start_time=start_time,
                    end_time=end_time,
                    error_message=last_error[:4000]
                )

                return {
                    "table_name": clean_table_name(table_name),
                    "insert_count": 0,
                    "update_count": 0,
                    "delete_count": 0,
                    "total_change_count": 0,
                    "status": "FAILED",
                    "error": last_error
                }


# ==============================================================
# READ TABLE LISTS
# ==============================================================

def read_table_list_table(table_list_name):
    try:
        return spark.table(table_list_name)
    except Exception:
        return spark.table(f"{CATALOG}.{table_list_name}")


def read_all_table_lists():
    dfs = []

    for tbl in TABLES_LISTS:
        df = (
            read_table_list_table(tbl)
            .select(
                F.col("TABLE_NAME").cast("string").alias("TABLE_NAME"),
                F.col("KEY_COLUMN").cast("string").alias("KEY_COLUMN")
            )
            .where(F.col("TABLE_NAME").isNotNull())
        )
        dfs.append(df)

    final_df = reduce(lambda a, b: a.unionByName(b, allowMissingColumns=True), dfs)

    final_df = (
        final_df
        .dropDuplicates(["TABLE_NAME"])
        .orderBy("TABLE_NAME")
    )

    return final_df


# ==============================================================
# PROCESS ALL TABLES
# ==============================================================

def process_all_tables():
    ensure_schema(STAGING_SCHEMA)
    ensure_schema(PREV_SCHEMA)
    ensure_schema(SNAPSHOT_SCHEMA)
    ensure_schema(LOG_SCHEMA)

    ensure_staging_log_tables_exist()
    reset_staging_daily_log()

    table_list_df = read_all_table_lists()

    table_rows = table_list_df.collect()

    print(f"Total tables to process: {len(table_rows)}")

    results = []

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        future_map = {
            executor.submit(
                process_table_with_retry,
                row["TABLE_NAME"],
                row["KEY_COLUMN"]
            ): row["TABLE_NAME"]
            for row in table_rows
        }

        for future in as_completed(future_map):
            table_name = future_map[future]

            try:
                result = future.result()
                results.append(result)

                print(
                    f"Completed: {table_name} | "
                    f"Status: {result.get('status')} | "
                    f"I: {result.get('insert_count')} | "
                    f"U: {result.get('update_count')} | "
                    f"D: {result.get('delete_count')}"
                )

            except Exception as e:
                error_msg = traceback.format_exc()
                print(f"Unexpected failure for {table_name}: {error_msg}")

                results.append({
                    "table_name": clean_table_name(table_name),
                    "insert_count": 0,
                    "update_count": 0,
                    "delete_count": 0,
                    "total_change_count": 0,
                    "status": "FAILED",
                    "error": str(e)
                })

    write_staging_daily_logs()
    consolidate_staging_logs_to_final()

    result_df = spark.createDataFrame(results)

    print("\n================ FINAL SUMMARY ================")
    result_df.groupBy("status").count().show(truncate=False)

    print("\n================ CHANGE COUNTS ================")
    result_df.select(
        "table_name",
        "status",
        "insert_count",
        "update_count",
        "delete_count",
        "total_change_count"
    ).orderBy("table_name").show(1000, truncate=False)

    return result_df


# ==============================================================
# RUN
# ==============================================================

final_result_df = process_all_tables()
