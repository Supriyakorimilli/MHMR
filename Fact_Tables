CREATE PROCEDURE [DW].[usp_update_Dim_Client_Guarantors]
/********************************************************************************************************************************************
PROCEDURE NAME	: DW.usp_update_Dim_Client_Guarantors
DESCRIPTION		:
SAMPLE CALL		: EXEC DW.usp_update_Dim_Client_Guarantors;
VERSION			: 2.0
COMMENT			: DATE			USER				COMMENT:
				  3/1/2024	C. Sherrill			Procedure Creation
********************************************************************************************************************************************/

AS

SET NOCOUNT ON;

-- ##########################################################################################################################
-- Drop / Truncate Temp Holding Tables if the exist

IF OBJECT_ID ('tempdb..#GUARANTORS') IS NOT NULL
BEGIN
	DROP TABLE #GUARANTORS
END;

IF OBJECT_ID ('tempdb..#COMPARE') IS NOT NULL
BEGIN
	DROP TABLE #COMPARE
END;

IF OBJECT_ID ('tempdb..#DELETED') IS NOT NULL
BEGIN
	DROP TABLE #DELETED
END;


DECLARE  @TableName VARCHAR(40) = 'Dim_Client_Guarantors'
		,@BeginCount INT = 0
		,@BeginCurr INT = 0
		,@NewInserts INT = 0
		,@ChangeUpdates INT = 0
		,@ChangeInserts INT = 0
		,@DeleteUpdates INT = 0
		,@EndCount INT = 0
		,@EndCurr INT = 0
		,@ETLType VARCHAR(40) = 'SCD MERGE'

SELECT @BeginCount = COUNT(*) FROM DW.Dim_Client_Guarantors;

SELECT @BeginCurr = COUNT(*) FROM DW.Dim_Client_Guarantors WHERE IsCurrent = 1;



CREATE TABLE #GUARANTORS
(	PATID	VARCHAR(20) NOT NULL,
	ClientKey	INT NOT NULL,
	EPISODE_NUMBER NUMERIC(10,0) NOT NULL,
	GuarantorID VARCHAR(40) NOT NULL,
	GuarantorName VARCHAR(40) NULL,
	FinancialClass	VARCHAR(40) NULL,
	SubscriberName	VARCHAR(87) NULL,
	ClientRelationToSub	VARCHAR(40) NULL,
	SubsPolicy	VARCHAR(20) NULL,
	SubsReleaseInfoCode	VARCHAR(5) NULL,
	SubsIDCardIssueDate	DATE NULL
 )


CREATE TABLE #COMPARE
(
	PATID	VARCHAR(20) NOT NULL,
	ClientKey	INT NOT NULL,
	EPISODE_NUMBER NUMERIC(10,0) NOT NULL,
	GuarantorID VARCHAR(40) NOT NULL,
	GuarantorName VARCHAR(40) NULL,
	FinancialClass	VARCHAR(40) NULL,
	SubscriberName	VARCHAR(87) NULL,
	ClientRelationToSub	VARCHAR(40) NULL,
	SubsPolicy	VARCHAR(20) NULL,
	SubsReleaseInfoCode	VARCHAR(5) NULL,
	SubsIDCardIssueDate	DATE NULL,
	GuarantorKey	INT NULL,
	CHANGE_IND	VARCHAR(20) NULL
)

CREATE TABLE #DELETED
(
	GuarantorKey	INT NOT NULL
)


INSERT INTO #GUARANTORS
SELECT  SUB.PATID
		,DC.ClientKey
		,SUB.EPISODE_NUMBER
		,SUB.GUARANTOR_ID AS GuarantorID
		,SUB.guarantor_name AS GuarantorName
		,GUAR.financial_class_value AS FinancialClass
		,SUB.subs_name AS SubscriberName
		,SUB.client_relation_to_subs_value AS ClientRelationToSub
		,SUB.subs_policy
		,SUB.subs_release_info_code
		,SUB.subs_id_card_issue_date
  FROM AvatarDWReporting.SYSTEM.billing_guar_subs_data SUB
  JOIN AvatarDWReporting.SYSTEM.billing_guar_table GUAR
	ON SUB.GUARANTOR_ID = GUAR.GUARANTOR_ID
JOIN DW.Dim_Client DC
	ON SUB.PATID = DC.PATID
	AND DC.IsCurrent = 1

INSERT INTO #COMPARE
SELECT GUAR.PATID
	,GUAR.ClientKey
	,GUAR.EPISODE_NUMBER
	,GUAR.GuarantorID
	,GUAR.GuarantorName
	,GUAR.FinancialClass
	,GUAR.SubscriberName
	,GUAR.ClientRelationToSub
	,GUAR.SubsPolicy
	,GUAR.SubsReleaseInfoCode
	,GUAR.SubsIDCardIssueDate
	,DCG.GuarantorKey
	,CASE WHEN DCG.PATID IS NULL THEN 'NEW INSERT'
		WHEN CONCAT(GUAR.SubscriberName
	,GUAR.ClientRelationToSub
	,GUAR.SubsPolicy
	,GUAR.SubsReleaseInfoCode
	,GUAR.SubsIDCardIssueDate) <>
			CONCAT(DCG.SubscriberName
	,DCG.ClientRelationToSub
	,DCG.SubsPolicy
	,DCG.SubsReleaseInfoCode
	,DCG.SubsIDCardIssueDate) THEN 'CHANGED'
	ELSE NULL END AS CHANGE_IND
FROM #GUARANTORS GUAR
LEFT JOIN DW.Dim_Client_Guarantors DCG
	ON GUAR.PATID = DCG.PATID
	AND GUAR.EPISODE_NUMBER = DCG.EPISODE_NUMBER
	AND GUAR.GuarantorID = DCG.GuarantorID
	AND DCG.IsCurrent = 1



INSERT INTO DW.Dim_Client_Guarantors
select PATID
	,ClientKey
	,EPISODE_NUMBER
	,GuarantorID
	,GuarantorName
	,FinancialClass
	,SubscriberName
	,ClientRelationToSub
	,SubsPolicy
	,SubsReleaseInfoCode
	,SubsIDCardIssueDate
	,GETDATE() 
	,'2199-12-31'
	,1
from #COMPARE 
where CHANGE_IND = 'NEW INSERT'

SET @NewInserts = @@ROWCOUNT;

UPDATE DCG
SET	DCG.SCD_End_Date = GETDATE(),
	DCG.IsCurrent = 0
FROM DW.Dim_Client_Guarantors DCG
JOIN #COMPARE COMP
	ON DCG.PATID = COMP.PATID
	AND DCG.EPISODE_NUMBER = COMP.EPISODE_NUMBER
	AND DCG.GuarantorID = COMP.GuarantorID
	AND COMP.CHANGE_IND = 'CHANGED'

SET @ChangeUpdates = @@ROWCOUNT;


INSERT INTO DW.Dim_Client_Guarantors
select PATID
	,ClientKey
	,EPISODE_NUMBER
	,GuarantorID
	,GuarantorName
	,FinancialClass
	,SubscriberName
	,ClientRelationToSub
	,SubsPolicy
	,SubsReleaseInfoCode
	,SubsIDCardIssueDate
	,GETDATE() 
	,'2199-12-31'
	,1
from #COMPARE 
where CHANGE_IND = 'CHANGED'

SET @ChangeInserts = @@ROWCOUNT;


INSERT INTO #DELETED
SELECT DCG.GuarantorKey
FROM DW.Dim_Client_Guarantors DCG
LEFT JOIN #COMPARE COMP
	ON DCG.PATID = COMP.PATID
	AND DCG.EPISODE_NUMBER = COMP.EPISODE_NUMBER
	AND DCG.GuarantorID = COMP.GuarantorID
WHERE COMP.PATID IS NULL


UPDATE DCG
SET DCG.SCD_End_Date = GETDATE(),
	DCG.IsCurrent = 0
FROM DW.Dim_Client_Guarantors DCG
JOIN #DELETED DEL
	ON DCG.GuarantorKey = DEL.GuarantorKey

SET @DeleteUpdates = @@ROWCOUNT;


SELECT @EndCount = COUNT(*) FROM DW.Dim_Client_Guarantors;

SELECT @EndCurr = COUNT(*) FROM DW.Dim_Client_Guarantors WHERE IsCurrent = 1;

INSERT INTO LOGGING.DW_PROCESS_LOG
(Logdate 
,TableName
,BeginRecCount
,BeginCurrCount
,NewInserts
,ChangeUpdates
,ChangeInserts
,DeleteUpdates
,EndRecCount
,EndCurrCount
,ETL_TYPE)
VALUES
	(GETDATE()
	,@TableName
	,@BeginCount
	,@BeginCurr
	,@NewInserts
	,@ChangeUpdates
	,@ChangeInserts
	,@DeleteUpdates
	,@EndCount
	,@EndCurr
	,@ETLType)



IF OBJECT_ID ('tempdb..#GUARANTORS') IS NOT NULL
BEGIN
	DROP TABLE #GUARANTORS
END;

IF OBJECT_ID ('tempdb..#COMPARE') IS NOT NULL
BEGIN
	DROP TABLE #COMPARE
END;

IF OBJECT_ID ('tempdb..#DELETED') IS NOT NULL
BEGIN
	DROP TABLE #DELETED
END;
GO


