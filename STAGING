def write_prev_raw_snapshot(table_name, previous_df):
    snapshot_table = snapshot_tbl(table_name)

    snapshot_df = (
        previous_df
        .withColumn(
            "__snapshot_run_id",
            F.lit(RUN_ID)
        )
        .withColumn(
            "__snapshot_date",
            F.current_date()
        )
        .withColumn(
            "__snapshot_timestamp",
            F.current_timestamp()
        )
    )

    (
        snapshot_df.write
        .mode("append")
        .option("mergeSchema", "true")
        .saveAsTable(snapshot_table)
    )


# ==============================================================
# CHANGE DETECTION
# ==============================================================

def build_changes(current_df, previous_df, key_cols):
    current_df = normalize_columns(current_df)
    previous_df = normalize_columns(previous_df)

    key_cols = resolve_key_columns(
        current_df,
        key_cols
    )

    previous_df = add_missing_columns(
        previous_df,
        current_df.columns,
        current_df
    )

    current_df = add_missing_columns(
        current_df,
        previous_df.columns,
        previous_df
    )

    current_df = current_df.select(
        previous_df.columns
    )

    current_hash = add_hash(
        current_df,
        key_cols
    ).alias("c")

    previous_hash = add_hash(
        previous_df,
        key_cols
    ).alias("p")

    join_cond = [
        F.col(f"c.`{k}`") == F.col(f"p.`{k}`")
        for k in key_cols
    ]

    inserts_df = (
        current_hash
        .join(
            previous_hash,
            join_cond,
            "left_anti"
        )
        .drop("_row_hash")
        .withColumn(
            "STATUS",
            F.lit("I")
        )
        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )

    deletes_df = (
        previous_hash
        .join(
            current_hash,
            join_cond,
            "left_anti"
        )
        .drop("_row_hash")
        .withColumn(
            "STATUS",
            F.lit("D")
        )
        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )

    updates_df = (
        current_hash
        .join(
            previous_hash,
            join_cond,
            "inner"
        )
        .where(
            F.col("c._row_hash") !=
            F.col("p._row_hash")
        )
        .select([
            F.col(f"c.`{c}`").alias(c)
            for c in current_df.columns
        ])
        .withColumn(
            "STATUS",
            F.lit("U")
        )
        .withColumn(
            "insert_timestamp",
            F.current_timestamp()
        )
    )

    inserts_df, updates_df, deletes_df = (
        align_dataframes_for_union([
            inserts_df,
            updates_df,
            deletes_df
        ])
    )

    changes_df = (
        inserts_df
        .unionByName(
            updates_df,
            allowMissingColumns=True
        )
        .unionByName(
            deletes_df,
            allowMissingColumns=True
        )
    )

    return changes_df


# ==============================================================
# PROCESS SINGLE TABLE
# ==============================================================

def process_table(table_name, key_column):
    # Existing processing start time remains CST/CDT
    start_time = datetime.now(tz)

    source_table = src_tbl(table_name)
    staging_table = stg_tbl(table_name)
    previous_table = prev_tbl(table_name)

    key_cols = parse_key_cols(key_column)

    if len(key_cols) == 0:
        end_time = datetime.now(tz)

        add_staging_log_row(
            table_name=clean_table_name(table_name),
            status="FAILED",
            count_value=0,
            start_time=start_time,
            end_time=end_time,
            error_message="KEY_COLUMN is empty"
        )

        raise Exception(
            f"KEY_COLUMN is empty for {table_name}"
        )

    print(
        "\n============================================================"
    )
    print(f"Processing table: {table_name}")
    print(f"Source   : {source_table}")
    print(f"Previous : {previous_table}")
    print(f"Staging  : {staging_table}")
    print(f"Keys     : {key_cols}")
    print(
        "============================================================"
    )

    if not table_exists(source_table):
        end_time = datetime.now(tz)

        add_staging_log_row(
            table_name=clean_table_name(table_name),
            status="FAILED",
            count_value=0,
            start_time=start_time,
            end_time=end_time,
            error_message=(
                f"Source table does not exist: "
                f"{source_table}"
            )
        )

        raise Exception(
            f"Source table does not exist: "
            f"{source_table}"
        )

    current_df = normalize_columns(
        spark.table(source_table)
    )

    if not table_exists(previous_table):
        (
            current_df.limit(0)
            .write
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(previous_table)
        )

    previous_df = normalize_columns(
        spark.table(previous_table)
    )

    changes_df = build_changes(
        current_df,
        previous_df,
        key_cols
    ).cache()

    status_counts_rows = (
        changes_df
        .groupBy("STATUS")
        .agg(
            F.count("*").alias("cnt")
        )
        .collect()
    )

    status_counts = {
        row["STATUS"]: int(row["cnt"])
        for row in status_counts_rows
    }

    insert_count = status_counts.get("I", 0)
    update_count = status_counts.get("U", 0)
    delete_count = status_counts.get("D", 0)

    total_change_count = (
        insert_count +
        update_count +
        delete_count
    )

    print(f"Insert count : {insert_count}")
    print(f"Update count : {update_count}")
    print(f"Delete count : {delete_count}")
    print(f"Total changes: {total_change_count}")

    (
        changes_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(staging_table)
    )

    # Snapshot old PREV_RAW before overwriting it
    write_prev_raw_snapshot(
        table_name,
        previous_df
    )

    # Update PREV_RAW with current RAW after staging is created
    (
        current_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(previous_table)
    )

    changes_df.unpersist()

    # Existing processing end time remains CST/CDT
    end_time = datetime.now(tz)

    add_staging_log_row(
        clean_table_name(table_name),
        "I",
        insert_count,
        start_time,
        end_time,
        None
    )

    add_staging_log_row(
        clean_table_name(table_name),
        "U",
        update_count,
        start_time,
        end_time,
        None
    )

    add_staging_log_row(
        clean_table_name(table_name),
        "D",
        delete_count,
        start_time,
        end_time,
        None
    )

    return {
        "table_name": clean_table_name(table_name),
        "insert_count": insert_count,
        "update_count": update_count,
        "delete_count": delete_count,
        "total_change_count": total_change_count,
        "status": "SUCCESS"
    }


# ==============================================================
# RETRY WRAPPER
# ==============================================================

def process_table_with_retry(table_name, key_column):
    last_error = None

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):
        try:
            return process_table(
                table_name,
                key_column
            )

        except Exception as e:
            last_error = str(e)

            print(
                f"Attempt {attempt} failed for "
                f"{table_name}: {last_error}"
            )

            if attempt == MAX_RETRIES:
                start_time = datetime.now(tz)
                end_time = datetime.now(tz)

                add_staging_log_row(
                    table_name=clean_table_name(
                        table_name
                    ),
                    status="FAILED",
                    count_value=0,
                    start_time=start_time,
                    end_time=end_time,
                    error_message=last_error[:4000]
                )

                return {
                    "table_name": clean_table_name(
                        table_name
                    ),
                    "insert_count": 0,
                    "update_count": 0,
                    "delete_count": 0,
                    "total_change_count": 0,
                    "status": "FAILED",
                    "error": last_error
                }


# ==============================================================
# READ TABLE LISTS
# ==============================================================

def read_table_list_table(table_list_name):
    try:
        return spark.table(
            table_list_name
        )

    except Exception:
        return spark.table(
            f"{CATALOG}.{table_list_name}"
        )


def read_all_table_lists():
    dfs = []

    for tbl in TABLES_LISTS:
        df = (
            read_table_list_table(tbl)
            .select(
                F.col("TABLE_NAME")
                .cast("string")
                .alias("TABLE_NAME"),

                F.col("KEY_COLUMN")
                .cast("string")
                .alias("KEY_COLUMN")
            )
            .where(
                F.col("TABLE_NAME").isNotNull()
            )
        )

        dfs.append(df)

    final_df = reduce(
        lambda a, b: a.unionByName(
            b,
            allowMissingColumns=True
        ),
        dfs
    )

    final_df = (
        final_df
        .dropDuplicates(["TABLE_NAME"])
        .orderBy("TABLE_NAME")
    )

    return final_df


# ==============================================================
# PROCESS ALL TABLES
# ==============================================================

def process_all_tables():
    ensure_schema(STAGING_SCHEMA)
    ensure_schema(PREV_SCHEMA)
    ensure_schema(SNAPSHOT_SCHEMA)
    ensure_schema(LOG_SCHEMA)

    ensure_staging_log_tables_exist()
    reset_staging_daily_log()

    # Clear any rows left in Python memory if the notebook cell
    # is rerun in the same Spark session.
    with LOG_LOCK:
        STAGING_LOG_ROWS.clear()

    table_list_df = read_all_table_lists()

    # Collect only the table-name and key metadata.
    # RAW tables are not loaded here.
    table_rows = table_list_df.collect()

    print(
        f"Total tables to process: "
        f"{len(table_rows)}"
    )

    results = []

    with ThreadPoolExecutor(
        max_workers=MAX_WORKERS
    ) as executor:

        future_map = {
            executor.submit(
                process_table_with_retry,
                row["TABLE_NAME"],
                row["KEY_COLUMN"]
            ): row["TABLE_NAME"]

            for row in table_rows
        }

        for future in as_completed(future_map):
            table_name = future_map[future]

            try:
                result = future.result()
                results.append(result)

                print(
                    f"Completed: {table_name} | "
                    f"Status: {result.get('status')} | "
                    f"I: {result.get('insert_count')} | "
                    f"U: {result.get('update_count')} | "
                    f"D: {result.get('delete_count')}"
                )

            except Exception as e:
                error_msg = traceback.format_exc()

                print(
                    f"Unexpected failure for "
                    f"{table_name}: {error_msg}"
                )

                results.append({
                    "table_name": clean_table_name(
                        table_name
                    ),
                    "insert_count": 0,
                    "update_count": 0,
                    "delete_count": 0,
                    "total_change_count": 0,
                    "status": "FAILED",
                    "error": str(e)
                })

    write_staging_daily_logs()
    consolidate_staging_logs_to_final()

    result_df = spark.createDataFrame(results)

    print(
        "\n================ FINAL SUMMARY ================"
    )

    result_df.groupBy(
        "status"
    ).count().show(
        truncate=False
    )

    print(
        "\n================ CHANGE COUNTS ================"
    )

    (
        result_df
        .select(
            "table_name",
            "status",
            "insert_count",
            "update_count",
            "delete_count",
            "total_change_count"
        )
        .orderBy("table_name")
        .show(
            1000,
            truncate=False
        )
    )

    return result_df


