def table_exists(table_path):
    try:
        return spark.catalog.tableExists(table_path)
    except Exception:
        return False


def get_row_count(table_path):
    try:
        if table_exists(table_path):
            return int(spark.read.table(table_path).count())
        return 0
    except Exception:
        return 0


def get_current_count(table_path):
    try:
        if table_exists(table_path):
            df = spark.read.table(table_path)

            if "IsCurrent" in df.columns:
                df = df.filter(F.col("IsCurrent") == True)

            if "IsDeleted" in df.columns:
                df = df.filter(F.coalesce(F.col("IsDeleted"), F.lit(False)) == False)

            return int(df.count())

        return 0
    except Exception:
        return 0


def ensure_scd2_columns(table_path):
    if not table_exists(table_path):
        return

    existing_cols = spark.read.table(table_path).columns
    new_cols = []

    if "EffectiveStartDate" not in existing_cols:
        new_cols.append("EffectiveStartDate TIMESTAMP")
    if "EffectiveEndDate" not in existing_cols:
        new_cols.append("EffectiveEndDate TIMESTAMP")
    if "IsCurrent" not in existing_cols:
        new_cols.append("IsCurrent BOOLEAN")
    if "IsDeleted" not in existing_cols:
        new_cols.append("IsDeleted BOOLEAN")
    if "RecordHash" not in existing_cols:
        new_cols.append("RecordHash STRING")
    if "CreatedDate" not in existing_cols:
        new_cols.append("CreatedDate TIMESTAMP")
    if "UpdatedDate" not in existing_cols:
        new_cols.append("UpdatedDate TIMESTAMP")
    if "BatchRunId" not in existing_cols:
        new_cols.append("BatchRunId STRING")

    if len(new_cols) > 0:
        spark.sql(f"ALTER TABLE {table_path} ADD COLUMNS ({', '.join(new_cols)})")

    dt = DeltaTable.forName(spark, table_path)

    dt.update(
        condition="IsCurrent IS NULL",
        set={
            "EffectiveStartDate": "current_timestamp()",
            "EffectiveEndDate": f"CAST('{OPEN_END_DATE}' AS TIMESTAMP)",
            "IsCurrent": "true",
            "IsDeleted": "false",
            "RecordHash": "sha2(concat_ws('||', ServiceFactID, cast(DataEntryDate as string)), 256)",
            "CreatedDate": "current_timestamp()",
            "UpdatedDate": "current_timestamp()",
            "BatchRunId": f"'{BATCH_RUN_ID}'"
        }
    )


