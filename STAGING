# ==============================================================
# SINGLE TABLE STAGING TEST
# RAW vs PREV_RAW USING LAST_MODIFIED TIMESTAMP
#
# NO ROW HASH
# NO THREADPOOL
#
# INSERT:
#   Key exists in CURRENT RAW but not PREV_RAW
#
# UPDATE:
#   Key exists in both
#   AND CURRENT.LAST_MODIFIED > PREVIOUS.LAST_MODIFIED
#
# DELETE:
#   Key exists in PREV_RAW but not CURRENT RAW
#
# Includes:
#   - Single table only
#   - Last Modified timestamp comparison
#   - I / U / D calculation
#   - Retry mechanism
#   - Daily logs
#   - Final logs
#   - CST/CDT timestamps
#   - UTC/GMT timestamps
#   - PREV_RAW backup snapshot
#   - Separate test tables
# ==============================================================


