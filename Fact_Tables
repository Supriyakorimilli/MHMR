	, SDM.EncounterType
	, SDM.PatientAgeonService
	, SDM.ServiceStatusCode
	, SDM.ServiceStatus
	, SDM.ProviderID
	, SDM.CoverageCode
	, SDM.Co_Practitioner_ID
	, SDM.Co_Practitioner2_ID
	, SDM.Tx_Note_UniqueId
	, SDM.ServiceUnits
	, SDM.ServiceCost
	, SDM.BalanceOfFeeOnService
	, CG.GuarantorKey
	, SDM.PrimaryGuarantorLiability 
	, SDM.IsBillable 
	, SDM.InsuranceCategoryCode
	, SDM.[Service]
	, SDM.ServiceCode
	, SDM.ServiceLocationCode
	, SDM.ServiceLocation 
	, SDM.ServiceDuration
	, SDM.TreatmentSettingCode
	, SDM.TreatmentSetting
	, SDM.ServiceStartTime 
	, SDM.ServiceEndTime 
	, DC.ClientKey
	, DS.StaffKey
	, DP.ProgramKey
	, SDM.AppointmentKey
FROM 
	#PART1 AS SDM WITH (NOLOCK, NOWAIT)
	JOIN DW.Dim_Client AS DC WITH (NOLOCK, NOWAIT)
		ON 
			SDM.PatientID = DC.PATID
			AND DC.IsCurrent = 1
	LEFT JOIN DW.Dim_Staff AS DS WITH (NOLOCK, NOWAIT)
		ON 
			SDM.ProviderID = DS.EmployeeID
			AND DS.IsCurrent = 1
	LEFT JOIN DW.Dim_Program AS DP WITH (NOLOCK, NOWAIT)
		ON 
			SDM.ProgramCode = DP.ProgramCode
			AND DP.IsCurrent = 1
	LEFT JOIN DW.Dim_Client_Guarantors AS CG WITH (NOLOCK, NOWAIT)
		ON 
			SDM.PatientID = CG.PATID
			AND SDM.GuarantorID = CG.GuarantorID
			AND SDM.EPISODE_NUMBER = CG.EPISODE_NUMBER
			AND CG.IsCurrent = 1
WHERE 
	SDM.RANK_NUM = 1

