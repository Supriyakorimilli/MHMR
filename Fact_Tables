from pyspark.sql import SparkSession, functions as F, Window
from pyspark.sql.types import (
    StructType, StructField, IntegerType, LongType, StringType, TimestampType
)
import traceback
from datetime import datetime

# =========================================================================================
# SPARK SESSION CONFIGURATION
# =========================================================================================
spark = SparkSession.builder.appName("Build.DW.Dim_Client").getOrCreate()
spark.conf.set("spark.sql.session.timeZone", "America/Chicago")
spark.conf.set("spark.databricks.delta.schema.autoMerge.enabled", "true")
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)

# =========================================================================================
# CONFIGURATION VARIABLES
# =========================================================================================
DB = "MHMR_LAKEHOUSE"

SRC_EPISODE_TBL = f"{DB}.RAW.episode_history_RAW"
SRC_DEMO_TBL    = f"{DB}.RAW.patient_current_demographics_RAW"

TARGET_TBL         = f"{DB}.DW.Dim_Client"
FINAL_LOG_TBL      = f"{DB}.LOGS.client_final_log"
TABLE_NAME_FOR_LOG = "Dim_Client"
ETL_TYPE_FOR_LOG   = "SCD MERGE"
FUTURE_END_DATE    = "2199-12-31"

# =========================================================================================
# AUTOMATED TABLE INITIALIZATION
# =========================================================================================
def table_exists(table_name: str) -> bool:
    try:
        spark.table(table_name)
        return True
    except Exception:
        return False

if not table_exists(TARGET_TBL):
    target_schema = StructType([
        StructField("ClientKey", LongType(), False),
        StructField("PATID", StringType(), False),
        StructField("patient_name", StringType(), True),
        StructField("patient_add_zipcode", StringType(), True),
        StructField("client_alias", StringType(), True),
        StructField("employment_status_value", StringType(), True),
        StructField("education_code", StringType(), True),
        StructField("marital_status_code", StringType(), True),
        StructField("facility_chart_number", StringType(), True),
        StructField("patient_sex_value", StringType(), True),
        StructField("race_value", StringType(), True),
        StructField("client_alias_7", StringType(), True),
        StructField("client_alias_8", StringType(), True),
        StructField("ethnic_origin_X_NRI_value", StringType(), True),
        StructField("medicaid_number", StringType(), True),
        StructField("patient_name_first", StringType(), True),
        StructField("patient_name_last", StringType(), True),
        StructField("patient_name_middle", StringType(), True),
        StructField("patient_name_prefix_code", StringType(), True),
        StructField("patient_name_prefix_value", StringType(), True),
        StructField("patient_name_suffix_code", StringType(), True),
        StructField("patient_name_suffix_value", StringType(), True),
        StructField("primary_language_value", StringType(), True),
        StructField("smoker_value", StringType(), True),
        StructField("IsActiveClient", IntegerType(), True),
        StructField("SCDStartDate", TimestampType(), True),
        StructField("SCDEndDate", TimestampType(), True),
        StructField("IsCurrent", IntegerType(), True)
    ])
    spark.createDataFrame([], target_schema).write.format("delta").mode("overwrite").saveAsTable(TARGET_TBL)

if not table_exists(FINAL_LOG_TBL):
    log_schema = StructType([
        StructField("Logdate", TimestampType(), True),
        StructField("TableName", StringType(), True),
        StructField("BeginRecCount", LongType(), True),
        StructField("BeginCurrCount", LongType(), True),
        StructField("NewInserts", LongType(), True),
        StructField("ChangeUpdates", LongType(), True),
        StructField("ChangeInserts", LongType(), True),
        StructField("DeleteUpdates", LongType(), True),
        StructField("EndRecCount", LongType(), True),
        StructField("EndCurrCount", LongType(), True),
        StructField("ETL_TYPE", StringType(), True),
        StructField("RunStatus", StringType(), True),
        StructField("ErrorMessage", StringType(), True)
    ])
    spark.createDataFrame([], log_schema).write.format("delta").mode("overwrite").saveAsTable(FINAL_LOG_TBL)

# =========================================================================================
# STRATEGIC T-SQL CONCAT MECHANISM REPLICATION
# =========================================================================================
def build_sql_concat_string(df_alias):
    fields = [
        "patient_name", "patient_add_zipcode", "client_alias", "employment_status_value",
        "education_code", "marital_status_code", "client_alias_7", "client_alias_8",
        "medicaid_number", "patient_name_first", "patient_name_last", "patient_name_middle",
        "patient_name_prefix_code", "patient_name_prefix_value", "patient_name_suffix_code",
        "patient_name_suffix_value", "primary_language_value", "smoker_value", "IsActiveClient"
    ]
    concat_exprs = []
    for f in fields:
        col_expr = F.coalesce(F.trim(F.col(f"{df_alias}.{f}").cast("string")), F.lit(""))
        concat_exprs.append(col_expr)
    return F.concat(*concat_exprs)

# =========================================================================================
# CORE EXECUTION PIPELINE
# =========================================================================================
begin_count, begin_curr = 0, 0
new_inserts, change_updates, change_inserts, delete_updates = 0, 0, 0, 0
end_count, end_curr = 0, 0

try:
    # Read initial target state metrics
    base_target_df = spark.table(TARGET_TBL)
    begin_count = base_target_df.count()
    begin_curr = base_target_df.filter(F.col("IsCurrent") == 1).count()

    # 1. Identify Active Status Flags (Episode Check)
    episode_df = spark.table(SRC_EPISODE_TBL)
    active_clients_df = episode_df.withColumn(
        "clean_discharge_date",
        F.coalesce(F.to_date(F.col("date_of_discharge")), F.to_date(F.lit("2199-12-31")))
    ).filter(
        F.col("clean_discharge_date") >= F.date_sub(F.current_date(), 13 * 30)
    ).select(F.upper(F.trim(F.col("PATID"))).alias("ACTIVE_PATID")).distinct().cache()

    # 2. Enrich Demographics and Standardize Natural Keys
    demo_df = spark.table(SRC_DEMO_TBL)
    demo_cleaned_df = demo_df.withColumn("CLEAN_PATID", F.upper(F.trim(F.col("PATID"))))
    
    demo_enriched_df = demo_cleaned_df.join(
        active_clients_df,
        demo_cleaned_df.CLEAN_PATID == active_clients_df.ACTIVE_PATID,
        "left"
    ).withColumn(
        "IsActiveClient",
        F.when(F.col("ACTIVE_PATID").isNotNull(), F.lit(1)).otherwise(F.lit(0))
    ).drop("ACTIVE_PATID").cache()

    # Isolate current records for comparison
    comparison_target_df = base_target_df.filter(F.col("IsCurrent") == 1).alias("tgt")

    # 3. New Dimension Records Identification
    new_clients_df = demo_enriched_df.alias("stg").join(
        comparison_target_df,
        F.col("stg.CLEAN_PATID") == F.upper(F.trim(F.col("tgt.PATID"))),
        "left_anti"
    ).select("stg.*")

    # 4. Version Change Identification (SCD Type 2 Tracked Mutations)
    changed_clients_df = demo_enriched_df.alias("stg").join(
        comparison_target_df,
        F.col("stg.CLEAN_PATID") == F.upper(F.trim(F.col("tgt.PATID"))),
        "inner"
    ).filter(
        build_sql_concat_string("stg") != build_sql_concat_string("tgt")
    ).select(
        F.col("tgt.ClientKey").alias("DeactivateClientKey"),
        "stg.*"
    )

    # 5. Missing / Closed Records Deletion Tracking
    deleted_clients_df = comparison_target_df.join(
        demo_enriched_df.alias("stg"),
        F.upper(F.trim(F.col("tgt.PATID"))) == F.col("stg.CLEAN_PATID"),
        "left_anti"
    ).select(F.col("tgt.ClientKey").alias("DeactivateClientKey"))

    # Compute operational changes metrics
    new_inserts = int(new_clients_df.count())
    change_inserts = int(changed_clients_df.count())
    change_updates = change_inserts
    delete_updates = int(deleted_clients_df.count())

    # 6. Re-assembling Timelines and Closing Expired Records
    deactivation_keys_df = changed_clients_df.select("DeactivateClientKey") \
        .unionByName(deleted_clients_df.select("DeactivateClientKey")) \
        .distinct()

    # Pull completely fresh instances of the table from storage to clear any lingering context graph reference tags
    fresh_target_1 = spark.table(TARGET_TBL)
    fresh_target_2 = spark.table(TARGET_TBL)
    fresh_target_3 = spark.table(TARGET_TBL)

    # Historical items remain unmodified
    historical_target_df = fresh_target_1.filter(F.col("IsCurrent") != 1)

    # Current items that are remaining active and completely untouched
    current_unchanged_df = fresh_target_2.filter(F.col("IsCurrent") == 1).alias("c").join(
        deactivation_keys_df.alias("d"),
        F.col("c.ClientKey") == F.col("d.DeactivateClientKey"),
        "left_anti"
    ).select("c.*")

    # Current items that must be expired now (Cleaned up continuation lines)
    expired_mutations_df = fresh_target_3.filter(F.col("IsCurrent") == 1).alias("c").join(
        deactivation_keys_df.alias("d"),
        F.col("c.ClientKey") == F.col("d.DeactivateClientKey"),
        "inner"
    ).withColumn("SCDEndDate", F.current_timestamp()) \
     .withColumn("IsCurrent", F.lit(0)) \
     .select("c.ClientKey", *[F.col(f"c.{col}") for col in base_target_df.columns if col != "ClientKey"])

    # 7. Surrogate Key Generation and Insert Stack assembly
    inserts_to_add_df = new_clients_df.unionByName(changed_clients_df.drop("DeactivateClientKey")).dropDuplicates(["CLEAN_PATID"])
    
    max_key_val = base_target_df.select(F.coalesce(F.max("ClientKey"), F.lit(0)).alias("max_key")).collect()[0]["max_key"]
    surrogate_window = Window.orderBy("CLEAN_PATID")

    new_current_records_df = inserts_to_add_df.withColumn(
        "ClientKey",
        F.row_number().over(surrogate_window) + F.lit(int(max_key_val))
    ).withColumn("SCDStartDate", F.current_timestamp()) \
     .withColumn("SCDEndDate", F.to_timestamp(F.lit(FUTURE_END_DATE))) \
     .withColumn("IsCurrent", F.lit(1))

    # Union all pieces together cleanly matching schema structure
    final_target_snapshot = historical_target_df.select(base_target_df.columns) \
        .unionByName(current_unchanged_df.select(base_target_df.columns)) \
        .unionByName(expired_mutations_df.select(base_target_df.columns)) \
        .unionByName(new_current_records_df.select(base_target_df.columns))

    # Transactional Overwrite to the Delta Table file layer
    final_target_snapshot.write.format("delta").mode("overwrite").option("overwriteSchema", "true").saveAsTable(TARGET_TBL)

    # Post-execution logging metrics
    refreshed_target_df = spark.table(TARGET_TBL)
    end_count = refreshed_target_df.count()
    end_curr = refreshed_target_df.filter(F.col("IsCurrent") == 1).count()

    log_row = [(
        datetime.now(), TABLE_NAME_FOR_LOG, int(begin_count), int(begin_curr),
        int(new_inserts), int(change_updates), int(change_inserts), int(delete_updates),
        int(end_count), int(end_curr), ETL_TYPE_FOR_LOG, "SUCCESS", ""
    )]
    log_cols = ["Logdate", "TableName", "BeginRecCount", "BeginCurrCount", "NewInserts", "ChangeUpdates", "ChangeInserts", "DeleteUpdates", "EndRecCount", "EndCurrCount", "ETL_TYPE", "RunStatus", "ErrorMessage"]
    spark.createDataFrame(log_row, log_cols).write.format("delta").mode("append").saveAsTable(FINAL_LOG_TBL)

    print("Pipeline executed successfully. Old notebook references cleared and parity confirmed.")

except Exception as e:
    err_msg = traceback.format_exc()
    try:
        log_row = [(
            datetime.now(), TABLE_NAME_FOR_LOG, int(begin_count), int(begin_curr),
            int(new_inserts), int(change_updates), int(change_inserts), int(delete_updates),
            int(end_count), int(end_curr), ETL_TYPE_FOR_LOG, "FAILED", str(e)[:4000]
        )]
        log_cols = ["Logdate", "TableName", "BeginRecCount", "BeginCurrCount", "NewInserts", "ChangeUpdates", "ChangeInserts", "DeleteUpdates", "EndRecCount", "EndCurrCount", "ETL_TYPE", "RunStatus", "ErrorMessage"]
        spark.createDataFrame(log_row, log_cols).write.format("delta").mode("append").saveAsTable(FINAL_LOG_TBL)
    except Exception:
        pass
    print(err_msg)
    raise

finally:
    try: active_clients_df.unpersist()
    except Exception: pass
    try: demo_enriched_df.unpersist()
    except Exception: pass
