# ==============================================================
# NORMALIZE COLUMN NAMES
# ==============================================================

def normalize_columns(df):

    new_cols = []

    seen = {}

    for c in df.columns:

        new_c = c.strip()

        new_c = re.sub(
            r"[ ,;{}()\n\t=]",
            "_",
            new_c
        )

        if new_c in seen:

            seen[new_c] += 1

            new_c = (
                f"{new_c}_"
                f"{seen[new_c]}"
            )

        else:

            seen[new_c] = 0

        new_cols.append(
            new_c
        )

    for old_c, new_c in zip(
        df.columns,
        new_cols
    ):

        if old_c != new_c:

            df = df.withColumnRenamed(
                old_c,
                new_c
            )

    return df


# ==============================================================
# PARSE KEY COLUMNS
# ==============================================================

def parse_key_cols(key_column):

    if key_column is None:

        return []

    key_column = str(
        key_column
    ).strip()

    if key_column == "":

        return []

    key_column = key_column.replace(
        "|",
        ","
    )

    return [

        k.strip()

        for k in key_column.split(",")

        if k.strip()

    ]


# ==============================================================
# RESOLVE KEY COLUMNS
# ==============================================================

def resolve_key_columns(
    df,
    key_cols
):

    col_map = {

        c.lower(): c

        for c in df.columns

    }

    resolved = []

    for k in key_cols:

        if k.lower() not in col_map:

            raise Exception(
                f"Key column missing in RAW table: {k}"
            )

        resolved.append(
            col_map[k.lower()]
        )

    return resolved


# ==============================================================
# ALIGN PREVIOUS TO CURRENT RAW SCHEMA
#
# CURRENT RAW IS SOURCE OF TRUTH
# ==============================================================

def align_previous_to_current(
    current_df,
    previous_df
):

    current_schema = {

        field.name:
            field.dataType

        for field in current_df.schema.fields

    }

    previous_map = {

        c.lower(): c

        for c in previous_df.columns

    }

    expressions = []

    for current_col in current_df.columns:

        current_type = current_schema[
            current_col
        ]

        if current_col.lower() in previous_map:

            previous_col = previous_map[
                current_col.lower()
            ]

            expressions.append(

                F.col(
                    f"`{previous_col}`"
                )
                .cast(
                    current_type
                )
                .alias(
                    current_col
                )

            )

        else:

            expressions.append(

                F.lit(
                    None
                )
                .cast(
                    current_type
                )
                .alias(
                    current_col
                )

            )

    return previous_df.select(
        *expressions
    )


# ==============================================================
# ROW HASH COLUMN SELECTION
# ==============================================================

def get_hash_columns(
    df,
    key_cols
):

    exclude_cols = {

        k.lower()

        for k in key_cols

    }


    # ==========================================================
    # DO NOT HASH TECHNICAL / GENERATED COLUMNS
    # ==============================================================

    exclude_cols.update([

        "status",

        "insert_timestamp",

        "_row_hash",

        # Existing RAW hash
        "row_hash",

        # Snapshot technical fields
        "__snapshot_run_id",

        "__snapshot_date",

        "__snapshot_timestamp"

    ])


    hash_cols = [

        c

        for c in df.columns

        if c.lower()
        not in exclude_cols

    ]


    # ==========================================================
    # SAME ORDER EVERY RUN
    # ==============================================================

    return sorted(
        hash_cols,
        key=lambda x: x.lower()
    )


# ==============================================================
# ADD CORRECTED SHA-256 ROW HASH
# ==============================================================

def add_hash(
    df,
    key_cols
):

    hash_cols = get_hash_columns(
        df,
        key_cols
    )

    if len(
        hash_cols
    ) == 0:

        return df.withColumn(
            "_row_hash",
            F.lit("")
        )


    # ==========================================================
    # CREATE DETERMINISTIC STRUCT
    # ==============================================================

    hash_struct = F.struct(

        *[

            F.col(
                f"`{c}`"
            ).alias(
                c
            )

            for c in hash_cols

        ]

    )


    # ==========================================================
    # CONVERT TO JSON
    #
    # NULL fields retained.
    # ==============================================================

    canonical_json = F.to_json(

        hash_struct,

        {
            "ignoreNullFields":
                "false"
        }

    )


    # ==========================================================
    # SHA-256
    # ==============================================================

    return df.withColumn(

        "_row_hash",

        F.sha2(
            canonical_json,
            256
        )

    )


