def add_scd2_metadata(df):
    data_cols = [c for c in df.columns if c != "CHANGE_IND"]

    hash_expr = F.sha2(
        F.concat_ws(
            "||",
            *[F.coalesce(F.col(c).cast("string"), F.lit("NULL")) for c in data_cols]
        ),
        256
    )

    return df.withColumn(
        "EffectiveStartDate",
        F.lit(RUN_TS).cast("timestamp")
    ).withColumn(
        "EffectiveEndDate",
        F.to_timestamp(F.lit(OPEN_END_DATE))
    ).withColumn(
        "IsCurrent",
        F.lit(True)
    ).withColumn(
        "IsDeleted",
        F.lit(False)
    ).withColumn(
        "RecordHash",
        hash_expr
    ).withColumn(
        "CreatedDate",
        F.lit(RUN_TS).cast("timestamp")
    ).withColumn(
        "UpdatedDate",
        F.lit(RUN_TS).cast("timestamp")
    ).withColumn(
        "BatchRunId",
        F.lit(BATCH_RUN_ID)
    ).drop("CHANGE_IND")


def execute_scd2_upsert(df, target_table_path):
    df = df.cache()

    new_df = df.filter(F.col("CHANGE_IND") == "NEW")
    change_df = df.filter(F.col("CHANGE_IND") == "CHANGE")

    new_insert_count = int(new_df.count())
    change_insert_count = int(change_df.count())
    change_update_count = 0

    if not table_exists(target_table_path):
        initial_df = add_scd2_metadata(df)

        (
            initial_df.write
            .format("delta")
            .mode("overwrite")
            .option("overwriteSchema", "true")
            .saveAsTable(target_table_path)
        )

        df.unpersist()
        return new_insert_count, change_update_count, change_insert_count

    ensure_scd2_columns(target_table_path)

    if change_insert_count > 0:
        change_keys_df = change_df.select("ServiceFactID").distinct().cache()

        current_target_df = spark.read.table(target_table_path) \
            .filter(F.col("IsCurrent") == True) \
            .filter(F.coalesce(F.col("IsDeleted"), F.lit(False)) == False) \
            .select("ServiceFactID")

        change_update_count = int(
            current_target_df.join(change_keys_df, "ServiceFactID", "inner").count()
        )

        delta_obj = DeltaTable.forName(spark, target_table_path)

        delta_obj.alias("tgt").merge(
            source=change_keys_df.alias("src"),
            condition="""
                tgt.ServiceFactID = src.ServiceFactID
                AND tgt.IsCurrent = true
                AND coalesce(tgt.IsDeleted, false) = false
            """
        ).whenMatchedUpdate(
            set={
                "EffectiveEndDate": f"CAST('{RUN_TS_STR}' AS TIMESTAMP)",
                "IsCurrent": "false",
                "UpdatedDate": f"CAST('{RUN_TS_STR}' AS TIMESTAMP)",
                "BatchRunId": f"'{BATCH_RUN_ID}'"
            }
        ).execute()

        change_keys_df.unpersist()

    insert_df = new_df.unionByName(change_df)

    if int(insert_df.count()) > 0:
        insert_df = add_scd2_metadata(insert_df)

        (
            insert_df.write
            .format("delta")
            .mode("append")
            .option("mergeSchema", "true")
            .saveAsTable(target_table_path)
        )

    df.unpersist()

    return new_insert_count, change_update_count, change_insert_count


new_inserts_d, change_updates_d, change_inserts_d = execute_scd2_upsert(final_delivery, TARGET_DELIVERY_TBL)
