from __future__ import annotations
from datetime import datetime
from typing import List, Dict
from concurrent.futures import ThreadPoolExecutor, as_completed
import time
import traceback
import pytz

from pyspark.sql import SparkSession, functions as F, types as T
from pyspark.sql.dataframe import DataFrame
from pyspark.sql.utils import AnalysisException

# ==============================================================
# Spark Session
# ==============================================================

spark = SparkSession.builder.appName("STAGING_AND_PREVS_LOADS").getOrCreate()

spark.conf.set("spark.sql.session.timeZone", "America/Chicago")
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)
spark.conf.set("spark.sql.parquet.int96RebaseModeInRead", "CORRECTED")
spark.conf.set("spark.sql.parquet.int96RebaseModeInWrite", "CORRECTED")
spark.conf.set("spark.sql.legacy.parquet.datetimeRebaseModeInRead", "CORRECTED")
spark.conf.set("spark.sql.legacy.parquet.datetimeRebaseModeInWrite", "CORRECTED")

# ==============================================================
# Constants
# ==============================================================

tz = pytz.timezone("America/Chicago")

CATALOG = "MHMR_LAKEHOUSE"

SOURCE_SCHEMA = f"{CATALOG}.RAW"
STAGING_SCHEMA = "staging"
PREV_SCHEMA = "prevs"
LOG_SCHEMA = "LOGS"

TABLES_LISTS = [
    "TABLES_LIST_1",
    "TABLES_LIST_2",
    "TABLES_LIST_3",
    "TABLES_LIST_4",
    "TABLES_LIST_5",
    "TABLES_LIST_6",
    "TABLES_LIST_7",
    "TABLES_LIST_8",
    "TABLES_LIST_9",
    "TABLES_LIST_10"
]

MAX_WORKERS = 4
MAX_RETRIES = 2
SLEEP_BETWEEN_RETRIES = 5

# ==============================================================
# Helper Functions
# ==============================================================

def _ts() -> str:
    return datetime.now(tz).strftime("%Y-%m-%d %H:%M:%S")


def src_tbl(table: str) -> str:
    return f"{SOURCE_SCHEMA}.{table}"


def stg_tbl(table: str) -> str:
    return f"{STAGING_SCHEMA}.stg_{table}"


def prev_tbl(table: str) -> str:
    return f"{PREV_SCHEMA}.prev_{table}"


def _ensure_schema(schema_name: str) -> None:
    spark.sql(f"CREATE SCHEMA IF NOT EXISTS {schema_name}")


def table_exists(table_fqn: str) -> bool:
    try:
        spark.read.table(table_fqn).limit(1).count()
        return True
    except Exception:
        return False


def read_all_table_lists() -> DataFrame:
    tables_df = None

    for list_table in TABLES_LISTS:
        print(f"[{_ts()}] Reading table list: {list_table}")

        try:
            df = (
                spark.read.table(list_table)
                .select("TABLE_NAME", "KEY_COLUMN")
            )

            tables_df = df if tables_df is None else tables_df.unionByName(df, allowMissingColumns=True)

        except AnalysisException:
            print(f"[{_ts()}] WARNING: Table list not found, skipping: {list_table}")
            continue

        except Exception as e:
            print(f"[{_ts()}] ERROR reading table list: {list_table} | {str(e)}")
            raise

    if tables_df is None:
        raise Exception("No table list tables found. Please check TABLES_LIST_1 to TABLES_LIST_10.")

    tables_df = tables_df.dropDuplicates(["TABLE_NAME"])

    return tables_df


def normalize_columns(df: DataFrame) -> DataFrame:
    """
    Keeps column names as-is, but removes duplicate columns if any.
    """
    seen = set()
    final_cols = []

    for c in df.columns:
        if c.lower() not in seen:
            seen.add(c.lower())
            final_cols.append(c)

    return df.select(*final_cols)


def add_missing_columns(df: DataFrame, target_cols: List[str]) -> DataFrame:
    work = df

    for c in target_cols:
        if c not in work.columns:
            work = work.withColumn(c, F.lit(None))

    return work.select(*target_cols)


def align_dataframes_for_union(dfs: List[DataFrame]) -> List[DataFrame]:
    """
    Makes all dataframes have same columns before union.
    This avoids unionByName column mismatch issues.
    """
    all_cols = []

    for df in dfs:
        for c in df.columns:
            if c not in all_cols:
                all_cols.append(c)

    return [add_missing_columns(df, all_cols) for df in dfs]


def get_hash_columns(df: DataFrame, key_cols: List[str]) -> List[str]:
    exclude_cols = set([c.lower() for c in key_cols] + ["status", "insert_timestamp", "insert_ts"])
    return [c for c in df.columns if c.lower() not in exclude_cols]


def add_hash(df: DataFrame, key_cols: List[str]) -> DataFrame:
    hash_cols = get_hash_columns(df, key_cols)

    if not hash_cols:
        return df.withColumn("_row_hash", F.lit(None).cast("string"))

    return df.withColumn(
        "_row_hash",
        F.sha2(
            F.concat_ws(
                "||",
                *[
                    F.coalesce(F.col(c).cast("string"), F.lit(""))
                    for c in hash_cols
                ]
            ),
            256
        )
    )


# ==============================================================
# Change Detection Logic
# ==============================================================

def build_changes(current_df: DataFrame, previous_df: DataFrame, key_cols: List[str]) -> DataFrame:
    """
    I = records in current but not in previous
    U = records in current and previous but non-key values changed
    D = records in previous but not in current

    Main fix added:
    unionByName(..., allowMissingColumns=True)
    """

    current_df = normalize_columns(current_df)
    previous_df = normalize_columns(previous_df)

    current_h = add_hash(current_df, key_cols).alias("c")
    previous_h = add_hash(previous_df, key_cols).alias("p")

    join_cond = [
        F.col(f"c.{k}") == F.col(f"p.{k}")
        for k in key_cols
    ]

    # Inserts: current exists, previous does not
    inserts = (
        current_h.join(previous_h, on=join_cond, how="left_anti")
        .drop("_row_hash")
        .withColumn("STATUS", F.lit("I"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    # Updates: current exists, previous exists, row hash changed
    joined_updates = (
        current_h.join(previous_h, on=join_cond, how="inner")
        .where(F.col("c._row_hash") != F.col("p._row_hash"))
    )

    updates = (
        joined_updates.select(*[F.col(f"c.{c}").alias(c) for c in current_df.columns])
        .withColumn("STATUS", F.lit("U"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    # Deletes: previous exists, current does not
    deletes = (
        previous_h.join(current_h, on=join_cond, how="left_anti")
        .select(*[F.col(f"p.{c}").alias(c) for c in previous_df.columns])
        .drop("_row_hash")
        .withColumn("STATUS", F.lit("D"))
        .withColumn("insert_timestamp", F.current_timestamp())
    )

    # Important fix for schema mismatch
    aligned_dfs = align_dataframes_for_union([deletes, updates, inserts])

    deletes_aligned = aligned_dfs[0]
    updates_aligned = aligned_dfs[1]
    inserts_aligned = aligned_dfs[2]

    changes_df = (
        deletes_aligned
        .unionByName(updates_aligned, allowMissingColumns=True)
        .unionByName(inserts_aligned, allowMissingColumns=True)
    )

    return changes_df


# ==============================================================
# Process One Table
# ==============================================================

def process_table(table_name: str, key_cols: List[str]) -> None:
    print(f"[{_ts()}] Will process {table_name} - not processed yet today.")

    source_table = src_tbl(table_name)
    staging_table = stg_tbl(table_name)
    previous_table = prev_tbl(table_name)

    print(f"[{_ts()}] Source:  {source_table}")
    print(f"[{_ts()}] Staging: {staging_table}")
    print(f"[{_ts()}] Previous:{previous_table}")

    if not table_exists(source_table):
        raise Exception(f"Source table not found: {source_table}")

    current_df = spark.read.table(source_table)

    if current_df.rdd.isEmpty():
        print(f"[{_ts()}] Source has zero rows: {source_table}")

    # If previous does not exist, create empty previous table using current schema
    if not table_exists(previous_table):
        print(f"[{_ts()}] Previous table not found. Creating empty previous table: {previous_table}")

        empty_prev = current_df.limit(0)

        (
            empty_prev.write
            .mode("overwrite")
            .option("mergeSchema", "true")
            .saveAsTable(previous_table)
        )

    previous_df = spark.read.table(previous_table)

    # Validate keys
    for k in key_cols:
        if k not in current_df.columns:
            raise Exception(f"Key column '{k}' not found in source table: {source_table}")

    for k in key_cols:
        if k not in previous_df.columns:
            previous_df = previous_df.withColumn(k, F.lit(None))

    # Build changes
    changes_df = build_changes(current_df, previous_df, key_cols)

    changes_count = changes_df.count()

    print(f"[{_ts()}] Changes found for {table_name}: {changes_count}")

    # Write staging table
    (
        changes_df.write
        .mode("overwrite")
        .option("mergeSchema", "true")
        .saveAsTable(staging_table)
    )

    print(f"[{_ts()}] Staging written: {staging_table}")

    # Update previous snapshot with current data
    (
        current_df.write
        .mode("overwrite")
        .option("overwriteSchema", "true")
        .saveAsTable(previous_table)
    )

    print(f"[{_ts()}] Previous snapshot updated: {previous_table}")

    print(f"[{_ts()}] Completed table: {table_name}")


# ==============================================================
# Retry Wrapper
# ==============================================================

def process_table_with_retry(table_name: str, key_cols: List[str]) -> None:
    attempts = 0

    while True:
        try:
            process_table(table_name, key_cols)
            return

        except Exception as e:
            attempts += 1

            msg = f"{type(e).__name__}: {str(e)}"
            print(f"[{_ts()}] ERROR processing {table_name}: {msg}")
            traceback.print_exc()

            if attempts > MAX_RETRIES:
                print(f"[{_ts()}] FINAL FAILURE for {table_name} after {attempts} attempts")
                return

            print(f"[{_ts()}] RETRY in {SLEEP_BETWEEN_RETRIES}s for {table_name}")
            time.sleep(SLEEP_BETWEEN_RETRIES)


# ==============================================================
# Main Orchestration
# ==============================================================

def process_all_tables() -> None:
    print(f"[{_ts()}] ========= Starting staging and previous loads =========")

    _ensure_schema(STAGING_SCHEMA)
    _ensure_schema(PREV_SCHEMA)
    _ensure_schema(LOG_SCHEMA)

    tables_df = read_all_table_lists()

    all_rows = [r.asDict() for r in tables_df.collect()]

    print(f"[{_ts()}] Total tables to process: {len(all_rows)}")

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as ex:
        futures = []

        for r in all_rows:
            table_name = r["TABLE_NAME"]
            key_cols = [
                c.strip()
                for c in r["KEY_COLUMN"].split(",")
                if c.strip()
            ]

            if not key_cols:
                print(f"[{_ts()}] Skipping {table_name}: KEY_COLUMN is empty")
                continue

            futures.append(
                ex.submit(process_table_with_retry, table_name, key_cols)
            )

        for f in as_completed(futures):
            f.result()

    print(f"[{_ts()}] ========= Staging and previous loads complete =========")


# ==============================================================
# Entry Point
# ==============================================================

process_all_tables()
