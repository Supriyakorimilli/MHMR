def add_missing_utc_log_columns(
    table_name
):


    if not table_exists(
        table_name
    ):

        return


    existing_columns = {

        c.lower()

        for c
        in spark.table(
            table_name
        ).columns

    }


    columns_to_add = []


    if (
        "insert_timestamp_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "insert_timestamp_utc TIMESTAMP"
        )


    if (
        "start_time_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "start_time_utc TIMESTAMP"
        )


    if (
        "end_time_utc"
        not in existing_columns
    ):

        columns_to_add.append(
            "end_time_utc TIMESTAMP"
        )


    if columns_to_add:


        columns_sql = ",\n".join(
            columns_to_add
        )


        spark.sql(
            f"""
            ALTER TABLE {table_name}
            ADD COLUMNS (
                {columns_sql}
            )
            """
        )


        print(
            f"Added UTC log columns to: "
            f"{table_name}"
        )


