def clean_table_name(
    table: str
) -> str:

    table = str(
        table
    ).strip()


    if table.upper().endswith(
        "_RAW"
    ):

        table = table[:-4]


    return table


# --------------------------------------------------------------
# RAW TABLE
# --------------------------------------------------------------

def src_tbl(
    table: str
) -> str:

    table = str(
        table
    ).strip()


    if table.upper().endswith(
        "_RAW"
    ):

        return (
            f"{SOURCE_SCHEMA}.{table}"
        )


    return (
        f"{SOURCE_SCHEMA}.{table}_RAW"
    )


