# ==============================================================
# ADD LOG ROW
# ==============================================================

def add_staging_log_row(
    table_name,
    status,
    count_value,
    start_time,
    end_time,
    error_message=None
):

    insert_time_cst = datetime.now(
        tz
    )

    if start_time.tzinfo is None:

        start_time_cst = tz.localize(
            start_time
        )

    else:

        start_time_cst = start_time.astimezone(
            tz
        )

    if end_time.tzinfo is None:

        end_time_cst = tz.localize(
            end_time
        )

    else:

        end_time_cst = end_time.astimezone(
            tz
        )


    insert_time_utc = (
        insert_time_cst.astimezone(
            utc_tz
        )
    )

    start_time_utc = (
        start_time_cst.astimezone(
            utc_tz
        )
    )

    end_time_utc = (
        end_time_cst.astimezone(
            utc_tz
        )
    )


    row = {

        "load_date":
            start_time_cst.date(),

        "table_name":
            clean_table_name(
                table_name
            ),

        "status":
            status,

        "count":
            int(
                count_value
                if count_value is not None
                else 0
            ),

        "error_message":
            error_message,

        # CST/CDT
        "insert_timestamp":
            insert_time_cst.replace(
                tzinfo=None
            ),

        "start_time":
            start_time_cst.replace(
                tzinfo=None
            ),

        "end_time":
            end_time_cst.replace(
                tzinfo=None
            ),

        # UTC
        "insert_timestamp_utc":
            insert_time_utc.replace(
                tzinfo=None
            ),

        "start_time_utc":
            start_time_utc.replace(
                tzinfo=None
            ),

        "end_time_utc":
            end_time_utc.replace(
                tzinfo=None
            ),

        "load_type":
            "staging_rowhash_test"

    }


    with LOG_LOCK:

        STAGING_LOG_ROWS.append(
            row
        )


