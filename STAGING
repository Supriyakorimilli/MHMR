# ==============================================================
# TABLE NAME HELPERS
# ==============================================================

def clean_table_name(table: str) -> str:
    table = str(table).strip()

    if table.upper().endswith("_RAW"):
        table = table[:-4]

    return table


def src_tbl(table: str) -> str:
    table = str(table).strip()

    if table.upper().endswith("_RAW"):
        return f"{SOURCE_SCHEMA}.{table}"

    return f"{SOURCE_SCHEMA}.{table}_RAW"


def stg_tbl(table: str) -> str:
    table = clean_table_name(table)

    return f"{STAGING_SCHEMA}.stg_{table}"


def prev_tbl(table: str) -> str:
    table = str(table).strip()

    if table.upper().endswith("_RAW"):
        return f"{PREV_SCHEMA}.{table}"

    return f"{PREV_SCHEMA}.{table}_RAW"


def snapshot_tbl(table: str) -> str:
    table = str(table).strip()

    if table.upper().endswith("_RAW"):
        return f"{SNAPSHOT_SCHEMA}.{table}"

    return f"{SNAPSHOT_SCHEMA}.{table}_RAW"


