# ==============================================================
# ADD LOG ROW
# ==============================================================

def add_log_row(
    table_name,
    status,
    count_value,
    start_time,
    end_time,
    error_message=None
):


    insert_time_cst = (
        datetime.now(
            CST_TZ
        )
    )


    if start_time.tzinfo is None:

        start_time_cst = (
            CST_TZ.localize(
                start_time
            )
        )

    else:

        start_time_cst = (
            start_time.astimezone(
                CST_TZ
            )
        )


    if end_time.tzinfo is None:

        end_time_cst = (
            CST_TZ.localize(
                end_time
            )
        )

    else:

        end_time_cst = (
            end_time.astimezone(
                CST_TZ
            )
        )


    insert_time_utc = (
        insert_time_cst
        .astimezone(
            UTC_TZ
        )
    )

    start_time_utc = (
        start_time_cst
        .astimezone(
            UTC_TZ
        )
    )

    end_time_utc = (
        end_time_cst
        .astimezone(
            UTC_TZ
        )
    )


    row = {

        "load_date":
            start_time_cst.date(),

        "table_name":
            clean_table_name(
                table_name
            ),

        "status":
            str(status),

        "count":
            int(
                count_value
                if count_value is not None
                else 0
            ),

        "error_message":
            error_message,

        # CST/CDT
        "insert_timestamp":
            insert_time_cst.replace(
                tzinfo=None
            ),

        "start_time":
            start_time_cst.replace(
                tzinfo=None
            ),

        "end_time":
            end_time_cst.replace(
                tzinfo=None
            ),

        # UTC
        "insert_timestamp_utc":
            insert_time_utc.replace(
                tzinfo=None
            ),

        "start_time_utc":
            start_time_utc.replace(
                tzinfo=None
            ),

        "end_time_utc":
            end_time_utc.replace(
                tzinfo=None
            ),

        "load_type":
            "LAST_MODIFIED_TEST"
    }


    LOG_ROWS.append(
        row
    )


