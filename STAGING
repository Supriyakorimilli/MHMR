def clean_table_name(table):

    table = str(
        table
    ).strip()

    if table.upper().endswith(
        "_RAW"
    ):

        table = table[:-4]

    return table


# ==============================================================
# RAW TABLE
# ==============================================================

def src_tbl(table):

    table = str(
        table
    ).strip()

    if table.upper().endswith(
        "_RAW"
    ):

        return (
            f"{SOURCE_SCHEMA}.{table}"
        )

    return (
        f"{SOURCE_SCHEMA}.{table}_RAW"
    )


# ==============================================================
# STAGING TABLE
# ==============================================================

def stg_tbl(table):

    table = clean_table_name(
        table
    )

    return (
        f"{STAGING_SCHEMA}."
