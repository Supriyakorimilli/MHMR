from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.window import Window
from delta.tables import DeltaTable
from datetime import datetime

# =========================================================================================
# SPARK CONFIG
# =========================================================================================

spark = SparkSession.builder.appName("DW_Service_Fact_Folder_Load").getOrCreate()

spark.conf.set("spark.sql.session.timeZone", "America/Chicago")
spark.conf.set("spark.databricks.delta.schema.autoMerge.enabled", "true")
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)

# =========================================================================================
# CONFIG
# =========================================================================================

DB = "MHMR_LAKEHOUSE"

TARGET_DELIVERY_TBL = f"{DB}.dw.fact_ServiceDelivery"
TARGET_BILLING_TBL  = f"{DB}.dw.fact_ServiceBilling"
TARGET_INFO_TBL     = f"{DB}.dw.fact_ServiceInfo"

DIM_CLIENT_TBL      = f"{DB}.DW.dim_client"
DIM_STAFF_TBL       = f"{DB}.DW.dim_staff"
DIM_PROGRAM_TBL     = f"{DB}.DW.dim_program"
DIM_GUARANTOR_TBL   = f"{DB}.DW.dim_client_guarantors"

SERVICE_SRC_TBL     = f"{DB}.RAW.ServiceDelivery_Master_RAW_SQL"
APPT_SRC_TBL        = f"{DB}.DW.dim_appointments"

LOG_TBL             = f"{DB}.LOGS.fact_process_log"
ETL_TYPE_FOR_LOG    = "PARTIAL MERGE"

# IMPORTANT:
# Keep False for partial/incremental source.
# Only True if SERVICE_SRC_TBL contains full active source snapshot.
ENABLE_PURGE = False

# =========================================================================================
# HELPER
# =========================================================================================

def get_row_count(table_path):
    try:
        if spark.catalog.tableExists(table_path):
            return int(spark.read.table(table_path).count())
        return 0
    except Exception as e:
        print(f"Count failed for {table_path}: {e}")
        return 0

begin_count_d = get_row_count(TARGET_DELIVERY_TBL)
begin_count_b = get_row_count(TARGET_BILLING_TBL)
begin_count_i = get_row_count(TARGET_INFO_TBL)

# =========================================================================================
# STAGE 1: SOURCE + APPOINTMENT JOIN
# =========================================================================================

sdm_df = spark.read.table(SERVICE_SRC_TBL)
ap_df = spark.read.table(APPT_SRC_TBL)

sdm_df = sdm_df.withColumn(
    "EPISODE_NUMBER",
    F.when(
        F.substring(F.col("EpisodeNumAndName"), 1, 2).cast("int").isNotNull(),
        F.substring(F.col("EpisodeNumAndName"), 1, 2)
    ).otherwise(F.substring(F.col("EpisodeNumAndName"), 1, 1))
)

sdm_df = sdm_df.withColumn(
    "join_tx_hist",
    F.expr("substring(ID, locate('||', ID, 4) + 2, 20)")
).withColumn(
    "tx_note_uid_slice",
    F.expr("substring(Tx_Note_UniqueId, locate('N', Tx_Note_UniqueId, 1), 15)")
)

joined_part1 = sdm_df.alias("sdm").join(
    ap_df.alias("ap"),
    (F.col("sdm.PatientID") == F.col("ap.PATID")) &
    (F.col("sdm.join_tx_hist") == F.col("ap.JOIN_TO_TX_HISTORY")) &
    (F.col("sdm.tx_note_uid_slice") == F.col("ap.NOT_uniqueid")),
    "left"
).select(
    F.col("sdm.ID").alias("ID"),
    "sdm.PatientID",
    "sdm.DateofService",
    "sdm.Facility",
    "sdm.AdmittedProgram",
    "sdm.DataEntrySource",
    "sdm.DataEntryDate",
    "sdm.DataEntryUser",
    "sdm.AccountingPeriod",
    "sdm.CrisisIndicator",
    "sdm.COPSD",
    "sdm.RecipientCode",
    "sdm.EncounterType",
    "sdm.PatientAgeonService",
    "sdm.ServiceStatusCode",
    "sdm.ServiceStatus",
    "sdm.ProviderID",
    "sdm.CoverageCode",
    "sdm.Co_Practitioner_ID",
    "sdm.Co_Practitioner2_ID",
    "sdm.Tx_Note_UniqueId",
    "sdm.ServiceUnits",
    "sdm.ServiceCost",
    "sdm.BalanceOfFeeOnService",
    "sdm.PrimaryGuarantorID",
    "sdm.PrimaryGuarantorLiability",
    "sdm.IsBillable",
    "sdm.InsuranceCategoryCode",
    "sdm.Service",
    "sdm.ServiceCode",
    "sdm.ServiceLocationCode",
    "sdm.ServiceLocation",
    "sdm.ServiceDuration",
    "sdm.TreatmentSettingCode",
    "sdm.TreatmentSetting",
    "sdm.ServiceStartTime",
    "sdm.ServiceEndTime",
    "sdm.ProgramCode",
    "sdm.EPISODE_NUMBER",
    "sdm.join_tx_hist",
    "sdm.tx_note_uid_slice",
    "ap.AppointmentKey",
    "ap.appointment_date",
    "ap.appointment_start_time"
)

# Dedup per source service row.
# Earlier partition by PatientID/join_tx_hist/tx_note_uid_slice can drop valid service rows.
window_spec = Window.partitionBy("ID").orderBy(
    F.to_timestamp(
        F.concat_ws(
            " ",
            F.date_format(F.col("appointment_date"), "yyyy-MM-dd"),
            F.col("appointment_start_time")
        )
    ).asc_nulls_last()
)

part1_df = joined_part1.withColumn("RANK_NUM", F.row_number().over(window_spec)) \
    .filter(F.col("RANK_NUM") == 1) \
    .drop("join_tx_hist", "tx_note_uid_slice", "appointment_date", "appointment_start_time", "RANK_NUM")

# =========================================================================================
# STAGE 2: DIMENSION JOINS
# =========================================================================================

dim_client    = spark.read.table(DIM_CLIENT_TBL).filter(F.col("IsCurrent") == 1)
dim_staff     = spark.read.table(DIM_STAFF_TBL).filter(F.col("IsCurrent") == 1)
dim_program   = spark.read.table(DIM_PROGRAM_TBL).filter(F.col("IsCurrent") == 1)
dim_guarantor = spark.read.table(DIM_GUARANTOR_TBL).filter(F.col("IsCurrent") == 1)

part2_df = part1_df.alias("p1") \
    .join(dim_client.alias("dc"), F.col("p1.PatientID") == F.col("dc.PATID"), "inner") \
    .join(dim_staff.alias("ds"), F.col("p1.ProviderID") == F.col("ds.EmployeeID"), "left") \
    .join(dim_program.alias("dp"), F.col("p1.ProgramCode") == F.col("dp.ProgramCode"), "left") \
    .join(
        dim_guarantor.alias("cg"),
        (F.col("p1.PatientID") == F.col("cg.PATID")) &
        (F.col("p1.PrimaryGuarantorID") == F.col("cg.GuarantorID")) &
        (F.col("p1.EPISODE_NUMBER") == F.col("cg.EPISODE_NUMBER")),
        "left"
    ) \
    .select(
        F.col("p1.*"),
        F.col("dc.ClientKey"),
        F.col("ds.StaffKey"),
        F.col("dp.ProgramKey"),
        F.col("cg.GuarantorKey")
    )

# =========================================================================================
# DEBUG COUNTS
# =========================================================================================

print("========== DEBUG COUNTS ==========")
print("Source Service Count:", sdm_df.count())
print("Appointment Count:", ap_df.count())
print("After Appointment Join / Dedup Count:", part1_df.count())
print("Current Dim Client Count:", dim_client.count())
print("After Dimension Join Count:", part2_df.count())
print("==================================")

# =========================================================================================
# STAGE 3: CHANGE DETECTION
# =========================================================================================

if spark.catalog.tableExists(TARGET_DELIVERY_TBL):
    dw_delivery_df = spark.read.table(TARGET_DELIVERY_TBL).select(
        "ServiceFactID",
        F.col("DataEntryDate").alias("dw_DataEntryDate")
    )

    staging_df = part2_df.alias("stg").join(
        dw_delivery_df.alias("dw"),
        F.col("stg.ID") == F.col("dw.ServiceFactID"),
        "left"
    ).withColumn(
        "CHANGE_IND",
        F.when(F.col("dw.ServiceFactID").isNull(), F.lit("NEW"))
         .when(F.col("stg.DataEntryDate") > F.col("dw.dw_DataEntryDate"), F.lit("CHANGE"))
         .otherwise(F.lit(None))
    ).filter(F.col("CHANGE_IND").isNotNull()).cache()
else:
    staging_df = part2_df.withColumn("CHANGE_IND", F.lit("NEW")).cache()

print("Staging NEW/CHANGE Count:", staging_df.count())
staging_df.groupBy("CHANGE_IND").count().show()

# =========================================================================================
# STAGE 4: FACT SPLIT
# =========================================================================================

final_delivery = staging_df.select(
    F.col("ID").alias("ServiceFactID"),
    "PatientID", "DateofService", "EPISODE_NUMBER", "Facility", "AdmittedProgram",
    "DataEntrySource", "DataEntryDate", "DataEntryUser", "AccountingPeriod",
    "CrisisIndicator", "COPSD", "RecipientCode", "EncounterType",
    "PatientAgeonService", "ServiceStatusCode", "ServiceStatus", "ProviderID",
    "CoverageCode", "Co_Practitioner_ID", "Co_Practitioner2_ID",
    "Tx_Note_UniqueId", "ClientKey", "StaffKey", "ProgramKey",
    "AppointmentKey", "CHANGE_IND"
)

final_billing = staging_df.select(
    F.col("ID").alias("ServiceFactID"),
    "ServiceUnits", "ServiceCost", "BalanceOfFeeOnService", "GuarantorKey",
    "PrimaryGuarantorLiability", "IsBillable", "InsuranceCategoryCode",
    "PatientID", "DateofService", "EPISODE_NUMBER", "ClientKey", "CHANGE_IND"
)

final_info = staging_df.select(
    F.col("ID").alias("ServiceFactID"),
    "Service", "ServiceCode", "ServiceLocationCode", "ServiceLocation",
    "ServiceDuration", "TreatmentSettingCode", "TreatmentSetting",
    "ServiceStartTime", "ServiceEndTime", "PatientID", "DateofService",
    "ClientKey", "CHANGE_IND"
)

# =========================================================================================
# STAGE 5: DELTA UPSERT
# =========================================================================================

def execute_upsert(df, target_table_path):
    upsert_df = df.filter(F.col("CHANGE_IND").isin("NEW", "CHANGE")).cache()

    ins_cnt = int(upsert_df.filter(F.col("CHANGE_IND") == "NEW").count())
    upd_cnt = int(upsert_df.filter(F.col("CHANGE_IND") == "CHANGE").count())

    write_df = upsert_df.drop("CHANGE_IND")

    if not spark.catalog.tableExists(target_table_path):
        write_df.write.format("delta").mode("overwrite").saveAsTable(target_table_path)
        upsert_df.unpersist()
        return ins_cnt, upd_cnt

    if ins_cnt + upd_cnt > 0:
        delta_obj = DeltaTable.forName(spark, target_table_path)

        delta_obj.alias("tgt").merge(
            source=write_df.alias("src"),
            condition="tgt.ServiceFactID = src.ServiceFactID"
        ).whenMatchedUpdateAll() \
         .whenNotMatchedInsertAll() \
         .execute()

    upsert_df.unpersist()
    return ins_cnt, upd_cnt

new_inserts_d, change_updates_d = execute_upsert(final_delivery, TARGET_DELIVERY_TBL)
new_inserts_b, change_updates_b = execute_upsert(final_billing, TARGET_BILLING_TBL)
new_inserts_i, change_updates_i = execute_upsert(final_info, TARGET_INFO_TBL)

# =========================================================================================
# STAGE 6: OPTIONAL PURGE
# =========================================================================================

del_d, del_b, del_i = 0, 0, 0

if ENABLE_PURGE and spark.catalog.tableExists(TARGET_DELIVERY_TBL):
    source_keys_df = part2_df.select(F.col("ID").alias("ServiceFactID")).distinct()

    orphans_df = spark.read.table(TARGET_DELIVERY_TBL).select("ServiceFactID").join(
        source_keys_df,
        "ServiceFactID",
        "left_anti"
    ).cache()

    orphan_count = int(orphans_df.count())

    if orphan_count > 0:
        for t_path in [TARGET_DELIVERY_TBL, TARGET_BILLING_TBL, TARGET_INFO_TBL]:
            if spark.catalog.tableExists(t_path):
                dt = DeltaTable.forName(spark, t_path)
                dt.alias("tgt").merge(
                    orphans_df.alias("src"),
                    "tgt.ServiceFactID = src.ServiceFactID"
                ).whenMatchedDelete().execute()

        del_d, del_b, del_i = orphan_count, orphan_count, orphan_count

    orphans_df.unpersist()

# =========================================================================================
# STAGE 7: AUDIT LOGGING
# =========================================================================================

end_count_d = get_row_count(TARGET_DELIVERY_TBL)
end_count_b = get_row_count(TARGET_BILLING_TBL)
end_count_i = get_row_count(TARGET_INFO_TBL)

log_rows = [
    (
        datetime.now(), "dw_fact_ServiceDelivery",
        int(begin_count_d), 0,
        int(new_inserts_d), int(change_updates_d), int(change_updates_d),
        int(del_d), int(end_count_d), 0, ETL_TYPE_FOR_LOG
    ),
    (
        datetime.now(), "dw_fact_ServiceBilling",
        int(begin_count_b), 0,
        int(new_inserts_b), int(change_updates_b), int(change_updates_b),
        int(del_b), int(end_count_b), 0, ETL_TYPE_FOR_LOG
    ),
    (
        datetime.now(), "dw_fact_ServiceInfo",
        int(begin_count_i), 0,
        int(new_inserts_i), int(change_updates_i), int(change_updates_i),
        int(del_i), int(end_count_i), 0, ETL_TYPE_FOR_LOG
    )
]

log_schema = [
    "Logdate", "TableName", "BeginRecCount", "BeginCurrCount",
    "NewInserts", "ChangeUpdates", "ChangeInserts",
    "DeleteUpdates", "EndRecCount", "EndCurrCount", "ETL_TYPE"
]

log_df = spark.createDataFrame(log_rows, log_schema)

if not spark.catalog.tableExists(LOG_TBL):
    log_df.write.format("delta").mode("overwrite").saveAsTable(LOG_TBL)
else:
    log_df.write.format("delta").mode("append").saveAsTable(LOG_TBL)

staging_df.unpersist()

print("Fabric Fact Load Completed Successfully.")
print("Delivery Begin:", begin_count_d, "End:", end_count_d, "New:", new_inserts_d, "Change:", change_updates_d, "Deleted:", del_d)
print("Billing Begin:", begin_count_b, "End:", end_count_b, "New:", new_inserts_b, "Change:", change_updates_b, "Deleted:", del_b)
print("Info Begin:", begin_count_i, "End:", end_count_i, "New:", new_inserts_i, "Change:", change_updates_i, "Deleted:", del_i)
