# ==============================================================
# NORMALIZE COLUMN NAMES
# ==============================================================

def normalize_columns(
    df
):

    new_cols = []

    seen = {}


    for c in df.columns:

        new_c = c.strip()


        new_c = re.sub(
            r"[ ,;{}()\n\t=]",
            "_",
            new_c
        )


        if new_c in seen:

            seen[new_c] += 1


            new_c = (
                f"{new_c}_"
                f"{seen[new_c]}"
            )


        else:

            seen[new_c] = 0


        new_cols.append(
            new_c
        )


    for old_c, new_c in zip(
        df.columns,
        new_cols
    ):

        if old_c != new_c:

            df = (
                df.withColumnRenamed(
                    old_c,
                    new_c
                )
            )


    return df


# ==============================================================
# PARSE KEY COLUMNS
# ==============================================================

def parse_key_cols(
    key_column
):

    if key_column is None:

        return []


    key_column = str(
        key_column
    ).strip()


    if key_column == "":

        return []


    key_column = (
        key_column.replace(
            "|",
            ","
        )
    )


    return [

        k.strip()

        for k
        in key_column.split(",")

        if k.strip()
    ]


# ==============================================================
# RESOLVE KEY COLUMNS
# ==============================================================

def resolve_key_columns(
    df,
    key_cols
):

    col_map = {

        c.lower(): c

        for c
        in df.columns

    }


    resolved = []


    for k in key_cols:

        if k.lower() not in col_map:

            raise Exception(
                f"Key column missing in RAW table: "
                f"{k}"
            )


        resolved.append(
            col_map[
                k.lower()
            ]
        )


    return resolved


# ==============================================================
# ADD MISSING COLUMNS
# ==============================================================

def add_missing_columns(
    df,
    required_cols,
    reference_df
):

    existing_lower = {

        c.lower(): c

        for c
        in df.columns

    }


    for c in required_cols:


        if c.lower() not in existing_lower:


            ref_type = (

                reference_df.schema[c].dataType

                if c in reference_df.columns

                else T.StringType()

            )


            df = (

                df.withColumn(

                    c,

                    F.lit(
                        None
                    ).cast(
                        ref_type
                    )

                )
            )


    return df


# ==============================================================
# ALIGN DATAFRAMES FOR UNION
# ==============================================================

def align_dataframes_for_union(
    dfs
):

    all_cols = []

    col_types = {}


    # ----------------------------------------------------------
    # Collect all columns
    # ----------------------------------------------------------

    for df in dfs:

        for field in df.schema.fields:

            if field.name not in all_cols:

                all_cols.append(
                    field.name
                )

                col_types[
                    field.name
                ] = field.dataType


    aligned = []


    # ----------------------------------------------------------
    # Add missing columns
    # ----------------------------------------------------------

    for df in dfs:


        for c in all_cols:


            if c not in df.columns:

                df = (

                    df.withColumn(

                        c,

                        F.lit(
                            None
                        ).cast(
                            col_types[c]
                        )

                    )
                )


        df = df.select(
            all_cols
        )


        aligned.append(
            df
        )


    return aligned


# ==============================================================
# ROW HASH
# ==============================================================

def get_hash_columns(
    df,
    key_cols
):


    # ----------------------------------------------------------
    # Exclude key columns from row hash
    # ----------------------------------------------------------

    exclude_cols = {

        k.lower()

        for k
        in key_cols

    }


    # ----------------------------------------------------------
    # Also exclude system columns
    # ----------------------------------------------------------

    exclude_cols.update([

        "status",

        "insert_timestamp",

        "_row_hash"

    ])


    # ----------------------------------------------------------
    # Remaining business columns participate in row hash
    # ----------------------------------------------------------

    return [

        c

        for c
        in df.columns

        if c.lower()
        not in exclude_cols

    ]


# ==============================================================
# ADD ROW HASH
# ==============================================================

def add_hash(
    df,
    key_cols
):


    hash_cols = (
        get_hash_columns(
            df,
            key_cols
        )
    )


    # ----------------------------------------------------------
    # No hash columns
    # ----------------------------------------------------------

    if len(hash_cols) == 0:

        return (

            df.withColumn(
                "_row_hash",
                F.lit("")
            )

        )


    # ----------------------------------------------------------
    # SHA-256 HASH
    # ----------------------------------------------------------

    return (

        df.withColumn(

            "_row_hash",

            F.sha2(

                F.concat_ws(

                    "||",

                    *[

                        F.coalesce(

                            F.col(c).cast(
                                "string"
                            ),

                            F.lit("")

                        )

                        for c
                        in hash_cols

                    ]

                ),

                256

            )
        )
    )


